<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Panel de Administración | La Montaña Madrid</title>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=JetBrains+Mono:wght@300;400&family=Plus+Jakarta+Sans:wght@200;300;400;500&display=swap" rel="stylesheet" />

  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            obsidian: '#050506',
            ivory: '#f4f4f5',
            gold: '#d4af37'
          },
          fontFamily: {
            serif: ['"Cormorant Garamond"', 'Georgia', 'serif'],
            sans: ['"Plus Jakarta Sans"', 'system-ui', 'sans-serif'],
            mono: ['"JetBrains Mono"', 'monospace']
          }
        }
      }
    };
  </script>

  <style>
    body {
      background-color: #050506;
      color: #f4f4f5;
      font-family: 'Plus Jakarta Sans', sans-serif;
      -webkit-font-smoothing: antialiased;
    }
  </style>
</head>

<body class="bg-[#050506] text-[#f4f4f5] min-h-screen flex flex-col justify-between">
  <%
    const listaReservas = (typeof reservas !== 'undefined' && Array.isArray(reservas)) ? reservas : [];
    const listaSalas = (typeof salas !== 'undefined' && Array.isArray(salas)) ? salas : [];
    const listaMesas = (typeof mesas !== 'undefined' && Array.isArray(mesas)) ? mesas : [];
    const filtroDia = (typeof fechaFiltro !== 'undefined' && fechaFiltro) ? fechaFiltro : '';

    const reservasFiltradas = filtroDia
      ? listaReservas.filter((r) => r.fecha === filtroDia)
      : listaReservas;

    const totalPendientes = listaReservas.filter((r) => r.estado === 'Pendiente').length;
    const totalConfirmadas = listaReservas.filter((r) => r.estado === 'Confirmada').length;
    const totalCanceladas = listaReservas.filter((r) => r.estado === 'Cancelada').length;
  %>

  <!-- Cabecera del Panel -->
  <header class="sticky top-0 z-50 backdrop-blur-xl bg-[#050506]/90 border-b border-white/10">
    <div class="max-w-7xl mx-auto px-6 sm:px-10 lg:px-16 h-24 flex items-center justify-between gap-4">
      <div>
        <span class="block text-[10px] font-light uppercase tracking-[0.38em] text-[#d4af37] mb-1">
          PANEL DE CONTROL · C. DEL REY FRANCISCO, 28
        </span>
        <h1 class="font-serif text-2xl sm:text-3xl font-light tracking-[0.2em] text-[#f4f4f5] uppercase">
          LA MONTAÑA · DIRECCIÓN
        </h1>
      </div>

      <div class="flex items-center gap-3 sm:gap-4">
        <a href="/" class="px-5 py-2.5 border border-white/15 text-[10px] font-light uppercase tracking-[0.25em] text-[#f4f4f5]/80 hover:border-[#d4af37] hover:text-[#d4af37] transition-colors">
          Ver Web
        </a>
        <form action="/admin/logout" method="POST" class="inline">
          <button type="submit" class="px-5 py-2.5 border border-[#d4af37]/60 text-[10px] font-light uppercase tracking-[0.25em] text-[#d4af37] hover:bg-[#d4af37] hover:text-[#050506] transition-all">
            Cerrar Sesión
          </button>
        </form>
      </div>
    </div>
  </header>

  <main class="flex-1 max-w-7xl w-full mx-auto px-6 sm:px-10 lg:px-16 py-14 space-y-16">

    <!-- Resumen de Estados -->
    <div class="grid grid-cols-1 sm:grid-cols-4 gap-6">
      <div class="border border-white/10 p-6">
        <span class="block text-[10px] uppercase tracking-[0.3em] text-[#f4f4f5]/50 mb-2">Total Reservas</span>
        <p class="font-mono text-3xl text-[#f4f4f5]"><%= listaReservas.length %></p>
      </div>
      <div class="border border-white/10 p-6">
        <span class="block text-[10px] uppercase tracking-[0.3em] text-amber-300/80 mb-2">Pendientes</span>
        <p class="font-mono text-3xl text-amber-300"><%= totalPendientes %></p>
      </div>
      <div class="border border-white/10 p-6">
        <span class="block text-[10px] uppercase tracking-[0.3em] text-emerald-300/80 mb-2">Confirmadas</span>
        <p class="font-mono text-3xl text-emerald-300"><%= totalConfirmadas %></p>
      </div>
      <div class="border border-white/10 p-6">
        <span class="block text-[10px] uppercase tracking-[0.3em] text-red-300/80 mb-2">Canceladas</span>
        <p class="font-mono text-3xl text-red-300"><%= totalCanceladas %></p>
      </div>
    </div>

    <!-- =================================================================== -->
    <!-- 1. CALENDARIO DE RESERVAS POR DÍA + LISTADO DE RESERVAS             -->
    <!-- =================================================================== -->
    <section class="grid grid-cols-1 lg:grid-cols-12 gap-10">
      
      <!-- Columna Izquierda: Vista de Calendario Interactivo -->
      <div class="lg:col-span-5 border border-white/10 bg-[#050506] p-6 sm:p-8">
        <div class="flex items-center justify-between border-b border-white/10 pb-4 mb-6">
          <div>
            <span class="block text-[10px] uppercase tracking-[0.3em] text-[#d4af37]">Agenda Mensual</span>
            <h2 id="cal-month-label" class="font-serif text-2xl font-light text-[#f4f4f5] capitalize mt-1">
              Calendario
            </h2>
          </div>
          <div class="flex items-center gap-2">
            <button type="button" id="cal-prev" class="px-3 py-1.5 border border-white/15 text-xs hover:border-[#d4af37] text-[#f4f4f5]">←</button>
            <button type="button" id="cal-next" class="px-3 py-1.5 border border-white/15 text-xs hover:border-[#d4af37] text-[#f4f4f5]">→</button>
          </div>
        </div>

        <!-- Cabecera de días de la semana -->
        <div class="grid grid-cols-7 gap-1 text-center text-[10px] uppercase tracking-[0.2em] text-[#d4af37] mb-3">
          <div>Lun</div>
          <div>Mar</div>
          <div>Mié</div>
          <div>Jue</div>
          <div>Vie</div>
          <div>Sáb</div>
          <div>Dom</div>
        </div>

        <!-- Cuadrícula de días -->
        <div id="calendar-grid" class="grid grid-cols-7 gap-1.5 text-center"></div>

        <div class="mt-6 pt-5 border-t border-white/10 flex items-center justify-between text-xs font-light text-[#f4f4f5]/60">
          <span>Día seleccionado: <strong class="font-mono text-[#d4af37]"><%= filtroDia || 'Todos los días' %></strong></span>
          <% if (filtroDia) { %>
            <a href="/admin" class="text-[11px] uppercase tracking-[0.2em] text-[#d4af37] hover:underline">
              Ver todas
            </a>
          <% } %>
        </div>
      </div>

      <!-- Columna Derecha: Libro de Reservas y Gestión de Estados -->
      <div class="lg:col-span-7 border border-white/10 bg-[#050506] overflow-hidden flex flex-col">
        <div class="p-6 sm:p-8 border-b border-white/10 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div>
            <span class="block text-[10px] uppercase tracking-[0.3em] text-[#d4af37]">Gestión de Estados</span>
            <h2 class="font-serif text-2xl sm:text-3xl font-light text-[#f4f4f5] mt-1">
              Reservas <%= filtroDia ? ('del ' + filtroDia) : 'Recibidas' %>
            </h2>
          </div>

          <form action="/admin" method="GET" class="flex items-center gap-2">
            <input
              type="date"
              name="fecha"
              value="<%= filtroDia %>"
              onchange="this.form.submit()"
              class="bg-[#050506] border border-white/15 px-3 py-2 text-xs text-[#f4f4f5] focus:border-[#d4af37] focus:outline-none"
            />
          </form>
        </div>

        <% if (reservasFiltradas.length === 0) { %>
          <div class="p-16 text-center">
            <p class="font-serif text-2xl text-[#f4f4f5]/60 mb-2">Sin reservas para la fecha seleccionada</p>
            <p class="text-xs font-light text-[#f4f4f5]/40">Seleccione otro día en el calendario o pulse "Ver todas".</p>
          </div>
        <% } else { %>
          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
              <thead>
                <tr class="border-b border-white/10 text-[10px] font-light uppercase tracking-[0.25em] text-[#d4af37]">
                  <th class="py-4 px-5">Cliente</th>
                  <th class="py-4 px-5">Fecha / Hora</th>
                  <th class="py-4 px-5">Sala / Pax</th>
                  <th class="py-4 px-5">Estado</th>
                  <th class="py-4 px-5 text-right">Cambiar Estado</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-white/10 text-xs font-light">
                <% reservasFiltradas.forEach(function(r) { %>
                  <tr class="hover:bg-white/[0.02]">
                    <td class="py-4 px-5">
                      <p class="font-serif text-lg text-[#f4f4f5]"><%= r.nombre %></p>
                      <p class="font-mono text-[11px] text-[#f4f4f5]/50"><%= r.telefono %> · <%= r.codigo %></p>
                    </td>
                    <td class="py-4 px-5 font-mono">
                      <p class="text-[#f4f4f5]"><%= r.fecha %></p>
                      <p class="text-[#d4af37]"><%= r.hora %> h</p>
                    </td>
                    <td class="py-4 px-5">
                      <p class="text-[#f4f4f5]"><%= r.sala || 'Salón Principal' %></p>
                      <p class="text-[#f4f4f5]/50"><%= r.comensales %> comensales (<%= r.mesa || 'Sala' %>)</p>
                    </td>
                    <td class="py-4 px-5">
                      <%
                        let badgeClass = 'border-amber-400/50 text-amber-300';
                        if (r.estado === 'Confirmada') badgeClass = 'border-emerald-400/50 text-emerald-300';
                        if (r.estado === 'Cancelada') badgeClass = 'border-red-400/50 text-red-300';
                      %>
                      <span class="inline-block px-2.5 py-1 border <%= badgeClass %> text-[10px] uppercase tracking-[0.2em]">
                        <%= r.estado %>
                      </span>
                    </td>
                    <td class="py-4 px-5 text-right">
                      <form action="/admin/reservas/<%= r.id %>/estado" method="POST" class="inline-block">
                        <select
                          name="estado"
                          onchange="this.form.submit()"
                          class="bg-[#050506] border border-white/15 focus:border-[#d4af37] px-2.5 py-1.5 text-[11px] text-[#f4f4f5] focus:outline-none"
                        >
                          <option value="Pendiente" <%= r.estado === 'Pendiente' ? 'selected' : '' %>>Pendiente</option>
                          <option value="Confirmada" <%= r.estado === 'Confirmada' ? 'selected' : '' %>>Confirmada</option>
                          <option value="Cancelada" <%= r.estado === 'Cancelada' ? 'selected' : '' %>>Cancelada</option>
                        </select>
                      </form>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </section>

    <!-- =================================================================== -->
    <!-- 2. CONFIGURACIÓN Y GESTIÓN DE SALAS Y MESAS DEL LOCAL               -->
    <!-- =================================================================== -->
    <section id="gestion-salas" class="border-t border-white/10 pt-14">
      <div class="mb-10">
        <span class="block text-[10px] uppercase tracking-[0.35em] text-[#d4af37] mb-2">
          CONFIGURACIÓN DE ESPACIOS
        </span>
        <h2 class="font-serif text-3xl sm:text-4xl font-light text-[#f4f4f5]">
          Gestión de Salas y Mesas
        </h2>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
        
        <!-- Formularios para Añadir Salas y Mesas -->
        <div class="lg:col-span-5 space-y-8">
          
          <!-- Añadir Nueva Sala -->
          <div class="border border-white/10 p-6 sm:p-8">
            <h3 class="font-serif text-2xl font-light text-[#d4af37] mb-6">
              Añadir Nueva Sala
            </h3>
            <form action="/admin/salas" method="POST" class="space-y-5">
              <div>
                <label class="block text-[10px] uppercase tracking-[0.28em] text-[#f4f4f5]/60 mb-2">
                  Nombre de la Sala *
                </label>
                <input
                  type="text"
                  name="nombre"
                  required
                  placeholder="Ej. Terraza Privada / Salón Reservado"
                  class="w-full bg-[#050506] border-b border-white/15 focus:border-[#d4af37] py-2.5 text-sm text-[#f4f4f5] focus:outline-none"
                />
              </div>
              <div>
                <label class="block text-[10px] uppercase tracking-[0.28em] text-[#f4f4f5]/60 mb-2">
                  Descripción
                </label>
                <input
                  type="text"
                  name="descripcion"
                  placeholder="Ej. Comedor climatizado para grupos"
                  class="w-full bg-[#050506] border-b border-white/15 focus:border-[#d4af37] py-2.5 text-sm text-[#f4f4f5] focus:outline-none"
                />
              </div>
              <button
                type="submit"
                class="w-full py-3 border border-[#d4af37] text-[10px] uppercase tracking-[0.28em] text-[#f4f4f5] hover:bg-[#d4af37] hover:text-[#050506] transition-all"
              >
                + Crear Sala
              </button>
            </form>
          </div>

          <!-- Añadir Nueva Mesa -->
          <div class="border border-white/10 p-6 sm:p-8">
            <h3 class="font-serif text-2xl font-light text-[#d4af37] mb-6">
              Añadir Nueva Mesa
            </h3>
            <form action="/admin/mesas" method="POST" class="space-y-5">
              <div class="grid grid-cols-2 gap-4">
                <div>
                  <label class="block text-[10px] uppercase tracking-[0.28em] text-[#f4f4f5]/60 mb-2">
                    Identificador *
                  </label>
                  <input
                    type="text"
                    name="numero"
                    required
                    placeholder="Ej. Mesa 6"
                    class="w-full bg-[#050506] border-b border-white/15 focus:border-[#d4af37] py-2.5 text-sm text-[#f4f4f5] focus:outline-none"
                  />
                </div>
                <div>
                  <label class="block text-[10px] uppercase tracking-[0.28em] text-[#f4f4f5]/60 mb-2">
                    Capacidad (Pax) *
                  </label>
                  <input
                    type="number"
                    name="capacidad"
                    min="1"
                    max="24"
                    value="4"
                    required
                    class="w-full bg-[#050506] border-b border-white/15 focus:border-[#d4af37] py-2.5 text-sm text-[#f4f4f5] focus:outline-none"
                  />
                </div>
              </div>

              <div>
                <label class="block text-[10px] uppercase tracking-[0.28em] text-[#f4f4f5]/60 mb-2">
                  Asignar a Sala *
                </label>
                <select
                  name="salaId"
                  class="w-full bg-[#050506] border-b border-white/15 focus:border-[#d4af37] py-2.5 text-sm text-[#f4f4f5] focus:outline-none"
                >
                  <% listaSalas.forEach(function(s) { %>
                    <option value="<%= s.id %>"><%= s.nombre %></option>
                  <% }); %>
                </select>
              </div>

              <button
                type="submit"
                class="w-full py-3 border border-[#d4af37] text-[10px] uppercase tracking-[0.28em] text-[#f4f4f5] hover:bg-[#d4af37] hover:text-[#050506] transition-all"
              >
                + Añadir Mesa
              </button>
            </form>
          </div>
        </div>

        <!-- Listado de Salas y Mesas Configuradas -->
        <div class="lg:col-span-7 space-y-8">
          <% listaSalas.forEach(function(sala) { %>
            <% const mesasDeSala = listaMesas.filter((m) => m.salaId === sala.id || m.salaNombre === sala.nombre); %>
            <div class="border border-white/10 p-6 sm:p-8">
              <div class="flex items-start justify-between border-b border-white/10 pb-4 mb-6">
                <div>
                  <h3 class="font-serif text-2xl text-[#f4f4f5]"><%= sala.nombre %></h3>
                  <p class="text-xs font-light text-[#f4f4f5]/50 mt-1"><%= sala.descripcion %></p>
                </div>
                <form action="/admin/salas/<%= sala.id %>/eliminar" method="POST">
                  <button type="submit" class="text-[10px] uppercase tracking-[0.2em] text-red-300/70 hover:text-red-300">
                    Eliminar Sala
                  </button>
                </form>
              </div>

              <% if (mesasDeSala.length === 0) { %>
                <p class="text-xs font-light text-[#f4f4f5]/40">No hay mesas asignadas a esta sala todavía.</p>
              <% } else { %>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  <% mesasDeSala.forEach(function(m) { %>
                    <div class="border border-white/10 p-4 flex items-center justify-between gap-4">
                      <div>
                        <p class="font-serif text-xl text-[#f4f4f5]"><%= m.numero %></p>
                        <p class="font-mono text-xs text-[#d4af37]"><%= m.capacidad %> comensales</p>
                      </div>

                      <div class="flex items-center gap-2">
                        <form action="/admin/mesas/<%= m.id %>/estado" method="POST">
                          <select
                            name="estado"
                            onchange="this.form.submit()"
                            class="bg-[#050506] border border-white/15 px-2.5 py-1 text-[11px] text-[#f4f4f5] focus:border-[#d4af37] focus:outline-none"
                          >
                            <option value="Libre" <%= m.estado === 'Libre' ? 'selected' : '' %>>Libre</option>
                            <option value="Reservada" <%= m.estado === 'Reservada' ? 'selected' : '' %>>Reservada</option>
                            <option value="Ocupada" <%= m.estado === 'Ocupada' ? 'selected' : '' %>>Ocupada</option>
                          </select>
                        </form>
                        <form action="/admin/mesas/<%= m.id %>/eliminar" method="POST">
                          <button type="submit" title="Eliminar mesa" class="px-2 py-1 text-xs text-[#f4f4f5]/40 hover:text-red-300">
                            ×
                          </button>
                        </form>
                      </div>
                    </div>
                  <% }); %>
                </div>
              <% } %>
            </div>
          <% }); %>
        </div>

      </div>
    </section>

  </main>

  <footer class="border-t border-white/10 py-10 px-6 sm:px-10 lg:px-16 text-center sm:text-left">
    <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4 text-[11px] font-light text-[#f4f4f5]/40 tracking-[0.15em] uppercase">
      <p>Restaurante La Montaña · C. del Rey Francisco, 28, Madrid</p>
      <p>Sistema Interno de Gestión de Reservas, Salas y Mesas</p>
    </div>
  </footer>

  <!-- Script del Calendario Mensual Interactivo -->
  <script>
    (function () {
      const reservasData = <%- JSON.stringify(listaReservas) %>;
      const selectedDate = "<%= filtroDia %>";
      const grid = document.getElementById('calendar-grid');
      const monthLabel = document.getElementById('cal-month-label');
      const prevBtn = document.getElementById('cal-prev');
      const nextBtn = document.getElementById('cal-next');

      const baseDate = selectedDate ? new Date(selectedDate + 'T12:00:00') : new Date();
      let currentYear = baseDate.getFullYear();
      let currentMonth = baseDate.getMonth();

      function pad(n) {
        return n < 10 ? '0' + n : String(n);
      }

      function renderCalendar(year, month) {
        if (!grid || !monthLabel) return;
        grid.innerHTML = '';

        const monthNames = [
          'Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio',
          'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'
        ];
        monthLabel.textContent = monthNames[month] + ' ' + year;

        const firstDay = new Date(year, month, 1).getDay();
        const offset = firstDay === 0 ? 6 : firstDay - 1; // Lunes = 0
        const daysInMonth = new Date(year, month + 1, 0).getDate();

        for (let i = 0; i < offset; i++) {
          const empty = document.createElement('div');
          empty.className = 'h-12';
          grid.appendChild(empty);
        }

        for (let day = 1; day <= daysInMonth; day++) {
          const iso = year + '-' + pad(month + 1) + '-' + pad(day);
          const count = reservasData.filter(function (r) {
            return r.fecha === iso && r.estado !== 'Cancelada';
          }).length;

          const isSelected = iso === selectedDate;
          const cell = document.createElement('a');
          cell.href = '/admin?fecha=' + iso;
          cell.className =
            'h-12 border flex flex-col items-center justify-center transition-colors ' +
            (isSelected
              ? 'border-[#d4af37] bg-[#d4af37]/15 text-[#f4f4f5]'
              : count > 0
              ? 'border-[#d4af37]/40 bg-white/[0.02] text-[#f4f4f5] hover:border-[#d4af37]'
              : 'border-white/10 text-[#f4f4f5]/60 hover:border-white/30');

          cell.innerHTML =
            '<span class="font-mono text-xs">' + day + '</span>' +
            (count > 0
              ? '<span class="text-[9px] font-mono text-[#d4af37]">' + count + ' res.</span>'
              : '');

          grid.appendChild(cell);
        }
      }

      if (prevBtn) {
        prevBtn.addEventListener('click', function () {
          currentMonth--;
          if (currentMonth < 0) {
            currentMonth = 11;
            currentYear--;
          }
          renderCalendar(currentYear, currentMonth);
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', function () {
          currentMonth++;
          if (currentMonth > 11) {
            currentMonth = 0;
            currentYear++;
          }
          renderCalendar(currentYear, currentMonth);
        });
      }

      renderCalendar(currentYear, currentMonth);
    })();
  </script>
</body>
</html>
