<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Panel de Reservas | La Montaña Madrid</title>

  <!-- Google Fonts: Cormorant Garamond, Plus Jakarta Sans & JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=JetBrains+Mono:wght@300;400&family=Plus+Jakarta+Sans:wght@200;300;400;500&display=swap" rel="stylesheet" />

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            obsidian: '#050506',
            ivory: '#f4f4f5',
            gold: '#d4af37'
          },
          fontFamily: {
            serif: ['"Cormorant Garamond"', 'Georgia', 'serif'],
            sans: ['"Plus Jakarta Sans"', 'system-ui', 'sans-serif'],
            mono: ['"JetBrains Mono"', 'monospace']
          }
        }
      }
    };
  </script>

  <style>
    body {
      background-color: #050506;
      color: #f4f4f5;
      font-family: 'Plus Jakarta Sans', sans-serif;
      -webkit-font-smoothing: antialiased;
    }
  </style>
</head>

<body class="bg-[#050506] text-[#f4f4f5] min-h-screen flex flex-col justify-between">
  <%
    const listaReservas = (typeof reservas !== 'undefined' && Array.isArray(reservas)) ? reservas : [];
    const totalReservas = listaReservas.length;
    const totalComensales = listaReservas.reduce((acc, r) => acc + (Number(r.comensales) || 0), 0);
    const confirmadas = listaReservas.filter((r) => r.estado === 'Confirmada').length;
  %>

  <!-- Cabecera del Panel Interno -->
  <header class="sticky top-0 z-50 backdrop-blur-xl bg-[#050506]/90 border-b border-white/10">
    <div class="max-w-7xl mx-auto px-6 sm:px-10 lg:px-16 h-24 flex items-center justify-between">
      <div>
        <span class="block text-[10px] font-light uppercase tracking-[0.38em] text-[#d4af37] mb-1">
          GESTIÓN INTERNA DE SALA
        </span>
        <h1 class="font-serif text-2xl sm:text-3xl font-light tracking-[0.2em] text-[#f4f4f5] uppercase">
          LA MONTAÑA · RESERVAS
        </h1>
      </div>

      <div class="flex items-center gap-4">
        <a href="/admin/reservas" class="px-5 py-2.5 border border-white/15 text-[10px] font-light uppercase tracking-[0.25em] text-[#f4f4f5]/80 hover:border-[#d4af37] hover:text-[#d4af37] transition-colors">
          Actualizar
        </a>
        <a href="/" class="px-6 py-2.5 border border-[#d4af37] text-[10px] font-light uppercase tracking-[0.25em] text-[#f4f4f5] hover:bg-[#d4af37]/15 hover:text-[#d4af37] transition-colors">
          Volver a la Web
        </a>
      </div>
    </div>
  </header>

  <!-- Contenido Principal del Panel -->
  <main class="flex-1 max-w-7xl w-full mx-auto px-6 sm:px-10 lg:px-16 py-16">
    
    <!-- Métricas de Resumen -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mb-14">
      <div class="border border-white/10 bg-[#050506] p-8">
        <span class="block text-[10px] font-light uppercase tracking-[0.32em] text-[#f4f4f5]/50 mb-3">
          Total Reservas
        </span>
        <p class="font-mono text-3xl sm:text-4xl font-light text-[#d4af37]">
          <%= totalReservas %>
        </p>
      </div>

      <div class="border border-white/10 bg-[#050506] p-8">
        <span class="block text-[10px] font-light uppercase tracking-[0.32em] text-[#f4f4f5]/50 mb-3">
          Reservas Confirmadas
        </span>
        <p class="font-mono text-3xl sm:text-4xl font-light text-[#f4f4f5]">
          <%= confirmadas %>
        </p>
      </div>

      <div class="border border-white/10 bg-[#050506] p-8">
        <span class="block text-[10px] font-light uppercase tracking-[0.32em] text-[#f4f4f5]/50 mb-3">
          Previsión Comensales
        </span>
        <p class="font-mono text-3xl sm:text-4xl font-light text-[#d4af37]">
          <%= totalComensales %>
        </p>
      </div>
    </div>

    <!-- Tabla de Reservas Recibidas -->
    <div class="border border-white/10 bg-[#050506] overflow-hidden">
      <div class="px-8 py-6 border-b border-white/10 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h2 class="font-serif text-2xl sm:text-3xl font-light text-[#f4f4f5]">
            Libro de Reservas Recibidas
          </h2>
          <p class="text-xs font-light text-[#f4f4f5]/50 mt-1">
            Listado en tiempo real de solicitudes registradas desde la web oficial.
          </p>
        </div>
      </div>

      <% if (listaReservas.length === 0) { %>
        <div class="p-16 text-center">
          <p class="font-serif text-2xl text-[#f4f4f5]/60 mb-2">No hay reservas registradas en este momento</p>
          <p class="text-xs font-light text-[#f4f4f5]/40">Las nuevas reservas realizadas en la web aparecerán automáticamente aquí.</p>
        </div>
      <% } else { %>
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="border-b border-white/10 text-[10px] font-light uppercase tracking-[0.28em] text-[#d4af37]">
                <th class="py-5 px-6">Código</th>
                <th class="py-5 px-6">Cliente</th>
                <th class="py-5 px-6">Teléfono</th>
                <th class="py-5 px-6">Fecha</th>
                <th class="py-5 px-6">Hora</th>
                <th class="py-5 px-6 text-center">Comensales</th>
                <th class="py-5 px-6">Estado</th>
                <th class="py-5 px-6 text-right">Acción</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/10 text-xs sm:text-sm font-light">
              <% listaReservas.forEach(function(reserva) { %>
                <tr class="hover:bg-white/[0.02] transition-colors">
                  <td class="py-5 px-6 font-mono text-xs text-[#d4af37]">
                    <%= reserva.codigo || ('#' + reserva.id) %>
                  </td>
                  <td class="py-5 px-6 font-serif text-lg text-[#f4f4f5]">
                    <%= reserva.nombre %>
                  </td>
                  <td class="py-5 px-6 font-mono text-xs text-[#f4f4f5]/80">
                    <a href="tel:<%= reserva.telefono %>" class="hover:text-[#d4af37] transition-colors">
                      <%= reserva.telefono %>
                    </a>
                  </td>
                  <td class="py-5 px-6 font-mono text-xs text-[#f4f4f5]/80">
                    <%= reserva.fecha %>
                  </td>
                  <td class="py-5 px-6 font-mono text-xs text-[#d4af37]">
                    <%= reserva.hora %> h
                  </td>
                  <td class="py-5 px-6 text-center font-mono text-sm text-[#f4f4f5]">
                    <%= reserva.comensales %>
                  </td>
                  <td class="py-5 px-6">
                    <%
                      let badgeStyle = 'border-[#d4af37]/50 text-[#d4af37]';
                      if (reserva.estado === 'En Mesa') badgeStyle = 'border-emerald-500/50 text-emerald-300';
                      if (reserva.estado === 'Completada') badgeStyle = 'border-white/30 text-[#f4f4f5]/60';
                      if (reserva.estado === 'Cancelada') badgeStyle = 'border-red-500/50 text-red-300';
                    %>
                    <span class="inline-block px-3 py-1 border <%= badgeStyle %> text-[10px] uppercase tracking-[0.22em]">
                      <%= reserva.estado || 'Confirmada' %>
                    </span>
                  </td>
                  <td class="py-5 px-6 text-right">
                    <form action="/admin/reservas/<%= reserva.id %>/estado" method="POST" class="inline-flex items-center gap-2">
                      <select
                        name="estado"
                        onchange="this.form.submit()"
                        class="bg-[#050506] border border-white/15 focus:border-[#d4af37] px-3 py-1.5 text-[11px] text-[#f4f4f5] focus:outline-none"
                      >
                        <option value="Confirmada" <%= reserva.estado === 'Confirmada' ? 'selected' : '' %>>Confirmada</option>
                        <option value="En Mesa" <%= reserva.estado === 'En Mesa' ? 'selected' : '' %>>En Mesa</option>
                        <option value="Completada" <%= reserva.estado === 'Completada' ? 'selected' : '' %>>Completada</option>
                        <option value="Cancelada" <%= reserva.estado === 'Cancelada' ? 'selected' : '' %>>Cancelada</option>
                      </select>
                    </form>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </main>

  <!-- Pie del Panel -->
  <footer class="border-t border-white/10 py-10 px-6 sm:px-10 lg:px-16 text-center sm:text-left">
    <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4 text-[11px] font-light text-[#f4f4f5]/40 tracking-[0.15em] uppercase">
      <p>Restaurante La Montaña · C. del Rey Francisco, 28, Madrid</p>
      <p>Panel Interno de Gestión de Reservas</p>
    </div>
  </footer>
</body>
</html>
