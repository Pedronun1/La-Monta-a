<!DOCTYPE html>
<html lang="es" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Acceso Dirección — <%= restaurant.name %> (C. del Rey Francisco, 28, Madrid)</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=Montserrat:wght@300;400;500;600&family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/luxury.css" />
</head>
<body class="bg-[#050506] text-[#f4f4f5] font-sans font-light min-h-screen flex flex-col justify-between selection:bg-[#d4af37] selection:text-[#050506]">

  <!-- Cabecera Corporativa Fija con Blur -->
  <header class="lm-navbar backdrop-blur-md bg-stone-950/80 sticky top-0 z-50 border-b border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-10 h-20 sm:h-24 flex items-center justify-between gap-3">
      <a href="/" class="flex items-center gap-3.5 sm:gap-4 no-underline">
        <span class="lm-monogram-seal"><%= restaurant.monogram %></span>
        <div class="flex flex-col">
          <span class="font-serif text-xl sm:text-2xl uppercase tracking-[0.14em] text-[#f4f4f5] leading-none">
            La Montaña
          </span>
          <span class="text-[8px] sm:text-[9px] tracking-[0.3em] uppercase text-[#d4af37] mt-1.5">
            Dirección & Gestión de Sala
          </span>
        </div>
      </a>

      <a href="/" class="lm-btn-outline py-2.5 px-4 sm:px-5 text-[10px] min-h-[44px]">
        ← VOLVER A LA WEB PÚBLICA
      </a>
    </div>
  </header>

  <!-- Panel Central de Autenticación "Silent Luxury" -->
  <main class="flex-1 flex items-center justify-center px-4 sm:px-6 py-12 sm:py-16">
    <div class="w-full max-w-md bg-[#111115] border border-white/10 p-7 sm:p-12 shadow-2xl">
      <div class="text-center mb-9">
        <span class="lm-monogram-seal mx-auto mb-5"><%= restaurant.monogram %></span>
        <span class="text-[10px] tracking-[0.3em] uppercase text-[#d4af37] block">
          ÁREA PRIVADA DE DIRECCIÓN
        </span>
        <h1 class="font-serif text-3xl sm:text-4xl font-normal text-[#f4f4f5] mt-2">
          Iniciar Sesión
        </h1>
        <p class="text-xs text-neutral-400 font-light mt-2 leading-relaxed">
          Acceso protegido mediante sesión autenticada al libro de reservas y control de mesas de C. del Rey Francisco, 28.
        </p>
      </div>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="mb-6 p-4 bg-red-950/50 border border-red-500/40 text-red-200 text-xs">
          <%= error %>
        </div>
      <% } %>

      <% if (typeof logoutMessage !== 'undefined' && logoutMessage) { %>
        <div class="mb-6 p-4 bg-emerald-950/40 border border-emerald-500/40 text-emerald-200 text-xs">
          <%= logoutMessage %>
        </div>
      <% } %>

      <form id="admin-login-form" action="/admin/login" method="POST" class="space-y-6">
        <div>
          <label for="username" class="lm-label">Identificador de Sala</label>
          <input
            id="username"
            name="username"
            type="text"
            value="admin"
            required
            autocomplete="username"
            class="lm-input h-12"
          />
        </div>

        <div>
          <label for="password" class="lm-label">Clave de Dirección *</label>
          <input
            id="password"
            name="password"
            type="password"
            required
            autofocus
            placeholder="Introduzca la contraseña..."
            autocomplete="current-password"
            class="lm-input h-12"
          />
        </div>

        <button id="login-submit-btn" type="submit" class="lm-btn-gold w-full h-12">
          <span id="login-spinner" class="hidden lm-spinner"></span>
          <span id="login-btn-text">ACCEDER AL PANEL DE SALA</span>
        </button>
      </form>
    </div>
  </main>

  <footer class="py-6 px-4 text-center text-[10px] sm:text-[11px] tracking-[0.16em] uppercase text-neutral-500 border-t border-white/10">
    <%= restaurant.legalName %> · <%= restaurant.address.fullAddress %>
  </footer>

  <script>
    const loginForm = document.getElementById('admin-login-form');
    const loginSpinner = document.getElementById('login-spinner');
    const loginText = document.getElementById('login-btn-text');
    if (loginForm) {
      loginForm.addEventListener('submit', () => {
        if (loginSpinner) loginSpinner.classList.remove('hidden');
        if (loginText) loginText.textContent = 'VERIFICANDO CREDENCIALES...';
      });
    }
  </script>
</body>
</html>
