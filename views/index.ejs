<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Restaurante La Montaña | Alta Cocina en Madrid</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@300;400;500&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #050506; color: #f4f4f5; }
    .font-serif { font-family: 'Cormorant Garamond', serif; }
    .glass-nav { background: rgba(5, 5, 6, 0.9); backdrop-filter: blur(16px); }
    .text-gold { color: #d4af37; }
    .border-gold { border-color: rgba(212, 175, 55, 0.25); }
    .btn-gold { background: #d4af37; color: #050506; transition: all 0.3s ease; }
    .btn-gold:hover { background: #e5c158; }
  </style>
</head>
<body class="antialiased selection:bg-[#d4af37] selection:text-black">

  <!-- Navbar Ultra Limpia -->
  <header class="fixed top-0 left-0 w-full glass-nav z-50 border-b border-white/10">
    <div class="max-w-7xl mx-auto px-8 h-24 flex items-center justify-between">
      <a href="#" class="flex items-center gap-3">
        <span class="w-10 h-10 rounded-full border border-gold flex items-center justify-center text-gold font-serif text-sm tracking-widest">L.M</span>
        <span class="text-xl font-serif tracking-[0.3em] text-white">LA MONTAÑA</span>
      </a>
      
      <nav class="hidden md:flex gap-12 text-xs uppercase tracking-[0.25em] text-zinc-400 font-light">
        <a href="#carta" class="hover:text-white transition-colors">Carta</a>
        <a href="#historia" class="hover:text-white transition-colors">La Casa</a>
        <a href="#reserva" class="hover:text-white transition-colors">Reservas</a>
      </nav>

      <a href="#reserva" class="hidden sm:inline-flex border border-gold px-7 py-3 rounded-full text-xs uppercase tracking-[0.2em] text-gold hover:bg-[#d4af37] hover:text-black transition-all duration-300">Reservar</a>
    </div>
  </header>

  <!-- Hero Minimalista -->
  <section class="relative h-screen flex items-center justify-center text-center px-4 bg-[url('https://images.unsplash.com/photo-1544025162-d76694265947?q=80&w=1920')] bg-cover bg-center">
    <div class="absolute inset-0 bg-gradient-to-t from-[#050506] via-[#050506]/80 to-[#050506]/50"></div>
    <div class="relative z-10 max-w-3xl mx-auto space-y-8">
      <span class="text-gold text-xs uppercase tracking-[0.4em] font-light">C. del Rey Francisco, 28 • Moncloa, Madrid</span>
      <h1 class="text-5xl md:text-7xl font-serif tracking-wide text-white leading-[1.1]">Alta Cocina Castiza desde 1943</h1>
      <p class="text-zinc-400 text-base md:text-lg font-light tracking-wide max-w-xl mx-auto leading-relaxed">Un espacio donde el producto noble y la tradición se encuentran en absoluta armonía.</p>
      <div class="pt-4 flex justify-center gap-6">
        <a href="#carta" class="border border-white/20 hover:border-gold px-8 py-4 rounded-full text-xs uppercase tracking-[0.2em] transition-all duration-300">Ver Carta</a>
        <a href="#reserva" class="btn-gold px-8 py-4 rounded-full text-xs uppercase tracking-[0.2em] font-medium">Reservar Mesa</a>
      </div>
    </div>
  </section>

  <!-- Sección de Carta -->
  <section id="carta" class="py-36 px-6 max-w-4xl mx-auto">
    <div class="text-center mb-24">
      <span class="text-gold text-xs uppercase tracking-[0.4em]">Propuesta Gastronómica</span>
      <h2 class="text-4xl md:text-5xl font-serif mt-3 text-white">Nuestra Carta</h2>
      <div class="w-10 h-[1px] bg-gold mx-auto mt-6"></div>
    </div>

    <!-- Primeros -->
    <div class="mb-24">
      <h3 class="text-xl font-serif text-gold mb-12 pb-4 border-b border-white/10 tracking-widest uppercase text-center">Primeros y Entrantes</h3>
      <div class="space-y-10">
        <% carta.primeros.forEach(plato => { %>
          <div class="group border-b border-white/5 pb-6">
            <div class="flex justify-between items-baseline mb-2">
              <h4 class="text-lg font-serif text-zinc-100 group-hover:text-gold transition-colors"><%= plato.nombre %></h4>
              <span class="text-gold font-mono text-base"><%= plato.precio %></span>
            </div>
            <p class="text-zinc-400 text-sm font-light leading-relaxed"><%= plato.descripcion %></p>
          </div>
        <% }) %>
      </div>
    </div>

    <!-- Segundos -->
    <div class="mb-24">
      <h3 class="text-xl font-serif text-gold mb-12 pb-4 border-b border-white/10 tracking-widest uppercase text-center">Segundos Platos</h3>
      <div class="space-y-10">
        <% carta.segundos.forEach(plato => { %>
          <div class="group border-b border-white/5 pb-6">
            <div class="flex justify-between items-baseline mb-2">
              <h4 class="text-lg font-serif text-zinc-100 group-hover:text-gold transition-colors"><%= plato.nombre %></h4>
              <span class="text-gold font-mono text-base"><%= plato.precio %></span>
            </div>
            <p class="text-zinc-400 text-sm font-light leading-relaxed"><%= plato.descripcion %></p>
          </div>
        <% }) %>
      </div>
    </div>

    <!-- Postres -->
    <div>
      <h3 class="text-xl font-serif text-gold mb-12 pb-4 border-b border-white/10 tracking-widest uppercase text-center">Repostería</h3>
      <div class="space-y-10">
        <% carta.postres.forEach(plato => { %>
          <div class="group border-b border-white/5 pb-6">
            <div class="flex justify-between items-baseline mb-2">
              <h4 class="text-lg font-serif text-zinc-100 group-hover:text-gold transition-colors"><%= plato.nombre %></h4>
              <span class="text-gold font-mono text-base"><%= plato.precio %></span>
            </div>
            <p class="text-zinc-400 text-sm font-light leading-relaxed"><%= plato.descripcion %></p>
          </div>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- Reservas -->
  <section id="reserva" class="py-32 bg-[#09090b] px-6 border-t border-white/10">
    <div class="max-w-xl mx-auto bg-zinc-950 p-10 md:p-14 rounded-3xl border border-white/10 shadow-2xl">
      <div class="text-center mb-10">
        <h2 class="text-3xl font-serif text-white mb-2">Reservar Mesa</h2>
        <p class="text-zinc-400 text-xs font-light">Asegure su experiencia en La Montaña.</p>
      </div>

      <form action="/api/reservar" method="POST" class="space-y-6">
        <div>
          <label class="block text-[10px] uppercase tracking-[0.2em] text-zinc-400 mb-2">Nombre y Apellidos</label>
          <input type="text" name="nombre" required class="w-full bg-zinc-900 border border-white/10 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-gold">
        </div>
        <div>
          <label class="block text-[10px] uppercase tracking-[0.2em] text-zinc-400 mb-2">Teléfono</label>
          <input type="tel" name="telefono" required class="w-full bg-zinc-900 border border-white/10 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-gold">
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-[10px] uppercase tracking-[0.2em] text-zinc-400 mb-2">Fecha</label>
            <input type="date" name="fecha" required class="w-full bg-zinc-900 border border-white/10 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-gold">
          </div>
          <div>
            <label class="block text-[10px] uppercase tracking-[0.2em] text-zinc-400 mb-2">Hora</label>
            <input type="time" name="hora" required class="w-full bg-zinc-900 border border-white/10 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-gold">
          </div>
        </div>
        <div>
          <label class="block text-[10px] uppercase tracking-[0.2em] text-zinc-400 mb-2">Comensales</label>
          <select name="comensales" class="w-full bg-zinc-900 border border-white/10 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-gold">
            <option value="2">2 Personas</option>
            <option value="4">4 Personas</option>
            <option value="6">6 Personas</option>
          </select>
        </div>
        <button type="submit" class="w-full py-4 btn-gold uppercase tracking-[0.2em] text-xs font-semibold rounded-xl">Confirmar Reserva</button>
      </form>
    </div>
  </section>

  <!-- Footer -->
  <footer class="py-16 px-6 text-center text-xs text-zinc-500 border-t border-white/10 space-y-4">
    <p>C. del Rey Francisco, 28, Moncloa - Aravaca, 28008 Madrid</p>
    <div class="flex justify-center gap-6">
      <a href="#" class="hover:text-white transition-colors">Aviso Legal</a>
      <a href="#" class="hover:text-white transition-colors">Privacidad</a>
      <a href="/admin" class="text-gold hover:underline">Acceso Sala</a>
    </div>
  </footer>

</body>
</html>
