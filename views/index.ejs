<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>La Montaña | Restaurante en Madrid</title>
  <meta name="description" content="Restaurante La Montaña en C. del Rey Francisco, 28, Madrid. Carta tradicional y reservas online." />

  <!-- Google Fonts: Cormorant Garamond, Plus Jakarta Sans & JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400&family=JetBrains+Mono:wght@300;400&family=Plus+Jakarta+Sans:wght@200;300;400;500&display=swap" rel="stylesheet" />

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            obsidian: '#050506',
            ivory: '#f4f4f5',
            gold: '#d4af37'
          },
          fontFamily: {
            serif: ['"Cormorant Garamond"', 'Georgia', 'serif'],
            sans: ['"Plus Jakarta Sans"', 'system-ui', 'sans-serif'],
            mono: ['"JetBrains Mono"', 'monospace']
          }
        }
      }
    };
  </script>

  <style>
    body {
      background-color: #050506;
      color: #f4f4f5;
      font-family: 'Plus Jakarta Sans', sans-serif;
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
    }

    ::selection {
      background: rgba(212, 175, 55, 0.22);
      color: #f4f4f5;
    }

    ::-webkit-scrollbar {
      width: 5px;
    }
    ::-webkit-scrollbar-track {
      background: #050506;
    }
    ::-webkit-scrollbar-thumb {
      background: rgba(212, 175, 55, 0.25);
    }

    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(22px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .fade-in-hero {
      animation: fadeIn 1.1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .reveal {
      opacity: 0;
      transform: translateY(24px);
      transition: opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1), transform 0.9s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .reveal.is-visible {
      opacity: 1;
      transform: translateY(0);
    }

    input[type="date"]::-webkit-calendar-picker-indicator {
      filter: invert(0.85) sepia(0.3) saturate(1.5) hue-rotate(10deg);
      cursor: pointer;
    }
  </style>
</head>

<body class="bg-[#050506] text-[#f4f4f5] min-h-screen flex flex-col justify-between">
  <%
    const listaSalas = (typeof salas !== 'undefined' && Array.isArray(salas) && salas.length)
      ? salas
      : [{ id: 1, nombre: 'Salón Principal' }, { id: 2, nombre: 'La Cueva / Bóveda' }];
  %>

  <!-- ===================================================================== -->
  <!-- 1. NAVBAR SUPERIOR REDISEÑADA (MINIMALISTA Y DE ALTA GAMA)            -->
  <!-- ===================================================================== -->
  <header class="fixed top-0 left-0 right-0 z-50 backdrop-blur-xl bg-[#050506]/90 border-b border-white/[0.08]">
    <div class="max-w-7xl mx-auto px-6 sm:px-12 lg:px-20 h-24 flex items-center justify-between">
      
      <!-- Izquierda: Logotipo Tipográfico Impecable -->
      <a href="#" class="font-serif text-2xl sm:text-[26px] font-light tracking-[0.36em] text-[#f4f4f5] uppercase hover:text-[#d4af37] transition-colors duration-300">
        LA MONTAÑA
      </a>

      <!-- Centro: Enlaces Esenciales ("CARTA", "RESERVAS", "CONTACTO") -->
      <nav class="hidden md:flex items-center gap-14 lg:gap-20" aria-label="Navegación principal">
        <a href="#carta" class="text-[11px] font-light uppercase tracking-[0.34em] text-[#f4f4f5]/75 hover:text-[#d4af37] transition-colors duration-300">
          CARTA
        </a>
        <a href="#reservas" class="text-[11px] font-light uppercase tracking-[0.34em] text-[#f4f4f5]/75 hover:text-[#d4af37] transition-colors duration-300">
          RESERVAS
        </a>
        <a href="#contacto" class="text-[11px] font-light uppercase tracking-[0.34em] text-[#f4f4f5]/75 hover:text-[#d4af37] transition-colors duration-300">
          CONTACTO
        </a>
      </nav>

      <!-- Derecha: Botón de Reserva Elegante -->
      <div class="flex items-center gap-4">
        <a href="#reservas" class="px-7 py-2.5 border border-[#d4af37]/80 bg-transparent text-[#f4f4f5] hover:bg-[#d4af37] hover:text-[#050506] text-[10px] sm:text-[11px] font-normal uppercase tracking-[0.3em] transition-all duration-300">
          RESERVAR
        </a>

        <button id="mobile-menu-btn" type="button" aria-label="Abrir menú" class="md:hidden p-2 text-[#f4f4f5]/80 hover:text-[#d4af37] focus:outline-none">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 8h16M4 16h16" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Menú Móvil -->
    <div id="mobile-menu" class="hidden md:hidden bg-[#050506]/95 backdrop-blur-xl border-b border-white/10 px-6 py-8">
      <div class="flex flex-col items-center gap-6">
        <a href="#carta" class="mobile-link text-xs font-light uppercase tracking-[0.32em] text-[#f4f4f5]/80 hover:text-[#d4af37]">CARTA</a>
        <a href="#reservas" class="mobile-link text-xs font-light uppercase tracking-[0.32em] text-[#f4f4f5]/80 hover:text-[#d4af37]">RESERVAS</a>
        <a href="#contacto" class="mobile-link text-xs font-light uppercase tracking-[0.32em] text-[#f4f4f5]/80 hover:text-[#d4af37]">CONTACTO</a>
      </div>
    </div>
  </header>

  <main>
    <!-- =================================================================== -->
    <!-- 2. HERO SECTION LIMPIA Y SOBRIA (SIN FRASES EXTRAÑAS DE RELLENO)    -->
    <!-- =================================================================== -->
    <section class="relative min-h-[88vh] flex items-center justify-center overflow-hidden pt-24">
      <div class="absolute inset-0 z-0">
        <img
          src="https://images.unsplash.com/photo-1544025162-d76694265947?auto=format&fit=crop&w=2000&q=85"
          alt="Restaurante La Montaña Madrid"
          class="w-full h-full object-cover object-center opacity-25"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-[#050506] via-[#050506]/80 to-[#050506]/60"></div>
      </div>

      <div class="relative z-10 max-w-4xl mx-auto px-6 sm:px-10 text-center py-24 fade-in-hero">
        <span class="block text-[10px] sm:text-xs font-light uppercase tracking-[0.45em] text-[#d4af37] mb-6">
          C. DEL REY FRANCISCO, 28 · MADRID
        </span>

        <h1 class="font-serif text-5xl sm:text-7xl md:text-8xl font-light tracking-[0.18em] text-[#f4f4f5] uppercase mb-14">
          LA MONTAÑA
        </h1>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-5 sm:gap-8">
          <a href="#reservas" class="w-full sm:w-auto px-11 py-4 border border-[#d4af37] bg-transparent text-[#f4f4f5] hover:bg-[#d4af37] hover:text-[#050506] text-[11px] font-normal uppercase tracking-[0.32em] transition-all duration-300">
            RESERVAR MESA
          </a>
          <a href="#carta" class="w-full sm:w-auto px-11 py-4 border border-white/15 bg-transparent text-[#f4f4f5]/80 hover:border-[#d4af37] hover:text-[#f4f4f5] text-[11px] font-light uppercase tracking-[0.32em] transition-all duration-300">
            VER CARTA
          </a>
        </div>
      </div>
    </section>

    <!-- =================================================================== -->
    <!-- 3. CARTA OFICIAL REAL DEL RESTAURANTE                               -->
    <!-- =================================================================== -->
    <section id="carta" class="py-28 md:py-36 px-6 sm:px-12 lg:px-20 max-w-6xl mx-auto border-t border-white/10">
      <div class="text-center max-w-2xl mx-auto mb-20 reveal">
        <span class="block text-[10px] sm:text-xs font-light uppercase tracking-[0.42em] text-[#d4af37] mb-4">
          GASTRONOMÍA TRADICIONAL
        </span>
        <h2 class="font-serif text-4xl sm:text-6xl font-light tracking-[0.06em] text-[#f4f4f5] mb-6">
          Nuestra Carta
        </h2>
        <div class="w-16 h-px bg-[#d4af37]/40 mx-auto"></div>
      </div>

      <div class="space-y-24">
        <!-- PRIMEROS -->
        <div class="reveal">
          <div class="border-b border-[#d4af37]/30 pb-4 mb-10 flex items-baseline justify-between">
            <h3 class="font-serif text-3xl sm:text-4xl font-light text-[#d4af37] tracking-[0.08em] uppercase">
              Primeros
            </h3>
            <span class="text-[11px] font-light uppercase tracking-[0.25em] text-[#f4f4f5]/40">
              <%= carta.primeros.length %> Platos
            </span>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-x-16 gap-y-5">
            <% carta.primeros.forEach(function(plato) { %>
              <div class="group flex items-baseline justify-between border-b border-white/[0.07] py-3.5 hover:border-[#d4af37]/40 transition-colors duration-300">
                <span class="font-serif text-xl sm:text-2xl font-light text-[#f4f4f5] group-hover:text-[#d4af37] transition-colors">
                  <%= plato.nombre %>
                </span>
                <span class="font-mono text-sm sm:text-base font-light text-[#d4af37] whitespace-nowrap ml-4">
                  <%= plato.precio %>
                </span>
              </div>
            <% }); %>
          </div>
        </div>

        <!-- SEGUNDOS -->
        <div class="reveal">
          <div class="border-b border-[#d4af37]/30 pb-4 mb-10 flex items-baseline justify-between">
            <h3 class="font-serif text-3xl sm:text-4xl font-light text-[#d4af37] tracking-[0.08em] uppercase">
              Segundos
            </h3>
            <span class="text-[11px] font-light uppercase tracking-[0.25em] text-[#f4f4f5]/40">
              <%= carta.segundos.length %> Platos
            </span>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-x-16 gap-y-5">
            <% carta.segundos.forEach(function(plato) { %>
              <div class="group flex items-baseline justify-between border-b border-white/[0.07] py-3.5 hover:border-[#d4af37]/40 transition-colors duration-300">
                <span class="font-serif text-xl sm:text-2xl font-light text-[#f4f4f5] group-hover:text-[#d4af37] transition-colors">
                  <%= plato.nombre %>
                </span>
                <span class="font-mono text-sm sm:text-base font-light text-[#d4af37] whitespace-nowrap ml-4">
                  <%= plato.precio %>
                </span>
              </div>
            <% }); %>
          </div>
        </div>

        <!-- POSTRES -->
        <div class="reveal">
          <div class="border-b border-[#d4af37]/30 pb-4 mb-10 flex items-baseline justify-between">
            <h3 class="font-serif text-3xl sm:text-4xl font-light text-[#d4af37] tracking-[0.08em] uppercase">
              Postres
            </h3>
            <span class="text-[11px] font-light uppercase tracking-[0.25em] text-[#f4f4f5]/40">
              <%= carta.postres.length %> Platos
            </span>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-x-16 gap-y-5">
            <% carta.postres.forEach(function(plato) { %>
              <div class="group flex items-baseline justify-between border-b border-white/[0.07] py-3.5 hover:border-[#d4af37]/40 transition-colors duration-300">
                <span class="font-serif text-xl sm:text-2xl font-light text-[#f4f4f5] group-hover:text-[#d4af37] transition-colors">
                  <%= plato.nombre %>
                </span>
                <span class="font-mono text-sm sm:text-base font-light text-[#d4af37] whitespace-nowrap ml-4">
                  <%= plato.precio %>
                </span>
              </div>
            <% }); %>
          </div>
        </div>
      </div>

      <p class="text-center text-[11px] font-light tracking-[0.22em] uppercase text-[#f4f4f5]/40 mt-20">
        Todos los precios incluyen IVA · C. del Rey Francisco, 28, Madrid
      </p>
    </section>

    <!-- =================================================================== -->
    <!-- 4. SECCIÓN DE RESERVAS ONLINE                                       -->
    <!-- =================================================================== -->
    <section id="reservas" class="py-28 md:py-36 px-6 sm:px-12 lg:px-20 max-w-4xl mx-auto border-t border-white/10">
      <div class="reveal">
        <div class="text-center max-w-2xl mx-auto mb-16">
          <span class="block text-[10px] sm:text-xs font-light uppercase tracking-[0.42em] text-[#d4af37] mb-4">
            RESERVA ONLINE
          </span>
          <h2 class="font-serif text-4xl sm:text-6xl font-light tracking-[0.06em] text-[#f4f4f5] mb-6">
            Reservar Mesa
          </h2>
          <div class="w-16 h-px bg-[#d4af37]/40 mx-auto mb-6"></div>
          <p class="text-xs sm:text-sm font-light text-[#f4f4f5]/60 tracking-[0.06em]">
            Seleccione fecha, hora, número de comensales y salón de preferencia.
          </p>
        </div>

        <div class="border border-white/10 bg-[#050506] p-8 sm:p-12 md:p-16">
          <% if (typeof reservaExitosa !== 'undefined' && reservaExitosa) { %>
            <div class="mb-10 border border-[#d4af37] bg-[#d4af37]/5 p-6 text-center">
              <p class="font-serif text-2xl text-[#d4af37] mb-1">Reserva Registrada</p>
              <p class="text-xs sm:text-sm font-light text-[#f4f4f5]/80">
                Su reserva ha quedado registrada<%= (typeof codigoReserva !== 'undefined' && codigoReserva) ? ' con el código ' + codigoReserva : '' %>.
              </p>
            </div>
          <% } %>

          <% if (typeof errorReserva !== 'undefined' && errorReserva) { %>
            <div class="mb-10 border border-white/20 bg-white/5 p-6 text-center">
              <p class="text-xs sm:text-sm font-light text-[#d4af37]">
                Por favor, complete todos los campos requeridos.
              </p>
            </div>
          <% } %>

          <form id="form-reservas" action="/api/reservar" method="POST" class="space-y-10">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 sm:gap-10">
              <div>
                <label for="nombre" class="block text-[10px] font-light uppercase tracking-[0.3em] text-[#d4af37] mb-3">
                  Nombre Completo *
                </label>
                <input
                  type="text"
                  id="nombre"
                  name="nombre"
                  required
                  placeholder="Ej. Carlos Mendoza"
                  class="w-full bg-[#050506] border-b border-white/15 focus:border-[#d4af37] py-3.5 text-sm font-light text-[#f4f4f5] placeholder-[#f4f4f5]/25 focus:outline-none transition-colors"
                />
              </div>

              <div>
                <label for="telefono" class="block text-[10px] font-light uppercase tracking-[0.3em] text-[#d4af37] mb-3">
                  Teléfono *
                </label>
                <input
                  type="tel"
                  id="telefono"
                  name="telefono"
                  required
                  placeholder="Ej. 600 000 000"
                  class="w-full bg-[#050506] border-b border-white/15 focus:border-[#d4af37] py-3.5 text-sm font-light text-[#f4f4f5] placeholder-[#f4f4f5]/25 focus:outline-none transition-colors"
                />
              </div>

              <div>
                <label for="fecha" class="block text-[10px] font-light uppercase tracking-[0.3em] text-[#d4af37] mb-3">
                  Fecha *
                </label>
                <input
                  type="date"
                  id="fecha"
                  name="fecha"
                  required
                  class="w-full bg-[#050506] border-b border-white/15 focus:border-[#d4af37] py-3.5 text-sm font-light text-[#f4f4f5] focus:outline-none transition-colors"
                />
              </div>

              <div>
                <label for="sala" class="block text-[10px] font-light uppercase tracking-[0.3em] text-[#d4af37] mb-3">
                  Sala / Espacio
                </label>
                <select
                  id="sala"
                  name="sala"
                  class="w-full bg-[#050506] border-b border-white/15 focus:border-[#d4af37] py-3.5 text-sm font-light text-[#f4f4f5] focus:outline-none transition-colors"
                >
                  <% listaSalas.forEach(function(s) { %>
                    <option value="<%= s.nombre %>"><%= s.nombre %></option>
                  <% }); %>
                </select>
              </div>

              <div>
                <label for="hora" class="block text-[10px] font-light uppercase tracking-[0.3em] text-[#d4af37] mb-3">
                  Hora *
                </label>
                <select
                  id="hora"
                  name="hora"
                  required
                  class="w-full bg-[#050506] border-b border-white/15 focus:border-[#d4af37] py-3.5 text-sm font-light text-[#f4f4f5] focus:outline-none transition-colors"
                >
                  <option value="13:30">13:30 h</option>
                  <option value="14:00" selected>14:00 h</option>
                  <option value="14:30">14:30 h</option>
                  <option value="15:00">15:00 h</option>
                  <option value="15:30">15:30 h</option>
                  <option value="20:30">20:30 h</option>
                  <option value="21:00">21:00 h</option>
                  <option value="21:30">21:30 h</option>
                  <option value="22:00">22:00 h</option>
                </select>
              </div>

              <div>
                <label for="comensales" class="block text-[10px] font-light uppercase tracking-[0.3em] text-[#d4af37] mb-3">
                  Comensales *
                </label>
                <select
                  id="comensales"
                  name="comensales"
                  required
                  class="w-full bg-[#050506] border-b border-white/15 focus:border-[#d4af37] py-3.5 text-sm font-light text-[#f4f4f5] focus:outline-none transition-colors"
                >
                  <% for (let i = 1; i <= 10; i++) { %>
                    <option value="<%= i %>" <%= i === 2 ? 'selected' : '' %>><%= i %> <%= i === 1 ? 'Persona' : 'Personas' %></option>
                  <% } %>
                </select>
              </div>
            </div>

            <div id="reserva-feedback" class="hidden border border-[#d4af37] p-6 text-center text-xs sm:text-sm font-light text-[#f4f4f5]"></div>

            <div class="pt-4 text-center">
              <button
                type="submit"
                id="btn-submit-reserva"
                class="w-full sm:w-auto px-14 py-4 border border-[#d4af37] bg-transparent text-[#f4f4f5] hover:bg-[#d4af37] hover:text-[#050506] text-[11px] font-normal uppercase tracking-[0.32em] transition-all duration-300"
              >
                CONFIRMAR RESERVA
              </button>
            </div>
          </form>
        </div>
      </div>
    </section>
  </main>

  <!-- ===================================================================== -->
  <!-- 5. FOOTER Y ENLACES LEGALES OBLIGATORIOS                              -->
  <!-- ===================================================================== -->
  <footer id="contacto" class="border-t border-white/10 bg-[#050506] py-20 px-6 sm:px-12 lg:px-20">
    <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center md:items-start justify-between gap-10 pb-14 border-b border-white/10">
      <div class="text-center md:text-left">
        <p class="font-serif text-2xl font-light tracking-[0.32em] text-[#f4f4f5] uppercase mb-3">
          LA MONTAÑA
        </p>
        <p class="text-xs font-light text-[#f4f4f5]/60 tracking-[0.1em]">
          C. del Rey Francisco, 28, Madrid
        </p>
      </div>

      <div class="flex flex-wrap items-center justify-center gap-8 text-[11px] font-light uppercase tracking-[0.24em] text-[#f4f4f5]/60">
        <a href="#aviso-legal" data-legal="aviso" class="hover:text-[#d4af37] transition-colors">Aviso Legal</a>
        <a href="#politica-privacidad" data-legal="privacidad" class="hover:text-[#d4af37] transition-colors">Política de Privacidad</a>
        <a href="#politica-cookies" data-legal="cookies" class="hover:text-[#d4af37] transition-colors">Política de Cookies</a>
        <a href="/admin" class="text-[#d4af37]/80 hover:text-[#d4af37] transition-colors">Acceso Admin</a>
      </div>
    </div>

    <div class="max-w-7xl mx-auto pt-10 flex flex-col sm:flex-row items-center justify-between gap-4 text-[11px] font-light text-[#f4f4f5]/40 tracking-[0.14em] uppercase">
      <p>© <%= new Date().getFullYear() %> Restaurante La Montaña · Todos los derechos reservados</p>
      <p>Moncloa - Aravaca · 28008 Madrid</p>
    </div>
  </footer>

  <!-- Modal Legal -->
  <div id="legal-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-[#050506]/90 backdrop-blur-md p-6" role="dialog" aria-modal="true">
    <div class="max-w-2xl w-full border border-white/10 bg-[#050506] p-8 sm:p-12 relative">
      <button type="button" id="close-legal-modal" class="absolute top-6 right-6 text-[#f4f4f5]/50 hover:text-[#d4af37] text-xs uppercase tracking-[0.25em]">
        Cerrar [×]
      </button>
      <h3 id="legal-modal-title" class="font-serif text-3xl font-light text-[#d4af37] mb-6"></h3>
      <div id="legal-modal-body" class="text-xs sm:text-sm font-light text-[#f4f4f5]/70 space-y-4 leading-relaxed"></div>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const fechaInput = document.getElementById('fecha');
      if (fechaInput) {
        const hoy = new Date().toISOString().split('T')[0];
        fechaInput.min = hoy;
        if (!fechaInput.value) fechaInput.value = hoy;
      }

      const revealItems = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.1 });

        revealItems.forEach(function (el) {
          observer.observe(el);
        });
      } else {
        revealItems.forEach(function (el) {
          el.classList.add('is-visible');
        });
      }

      const mobileBtn = document.getElementById('mobile-menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');
      if (mobileBtn && mobileMenu) {
        mobileBtn.addEventListener('click', function () {
          mobileMenu.classList.toggle('hidden');
        });
        document.querySelectorAll('.mobile-link').forEach(function (link) {
          link.addEventListener('click', function () {
            mobileMenu.classList.add('hidden');
          });
        });
      }

      const form = document.getElementById('form-reservas');
      const feedback = document.getElementById('reserva-feedback');
      const submitBtn = document.getElementById('btn-submit-reserva');

      if (form) {
        form.addEventListener('submit', async function (e) {
          e.preventDefault();
          feedback.classList.add('hidden');
          submitBtn.disabled = true;
          submitBtn.textContent = 'PROCESANDO...';

          const payload = {
            nombre: document.getElementById('nombre').value.trim(),
            telefono: document.getElementById('telefono').value.trim(),
            fecha: document.getElementById('fecha').value,
            sala: document.getElementById('sala').value,
            hora: document.getElementById('hora').value,
            comensales: document.getElementById('comensales').value
          };

          try {
            const res = await fetch('/api/reservar', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json'
              },
              body: JSON.stringify(payload)
            });
            const data = await res.json();

            if (res.ok && data.success) {
              feedback.innerHTML =
                '<p class="font-serif text-2xl text-[#d4af37] mb-1">Reserva Registrada</p>' +
                '<p class="text-[#f4f4f5]/80">' + data.message + ' · Sala: ' + data.reserva.sala + ' · Código: <span class="font-mono text-[#d4af37]">' + data.reserva.codigo + '</span></p>';
              feedback.classList.remove('hidden');
              form.reset();
              if (fechaInput) fechaInput.value = payload.fecha;
            } else {
              feedback.textContent = data.message || 'No se pudo completar la reserva.';
              feedback.classList.remove('hidden');
            }
          } catch (err) {
            form.submit();
          } finally {
            submitBtn.disabled = false;
            submitBtn.textContent = 'CONFIRMAR RESERVA';
          }
        });
      }

      const legalModal = document.getElementById('legal-modal');
      const legalTitle = document.getElementById('legal-modal-title');
      const legalBody = document.getElementById('legal-modal-body');
      const closeLegal = document.getElementById('close-legal-modal');

      const textosLegales = {
        aviso: {
          titulo: 'Aviso Legal (LSSI-CE)',
          cuerpo: '<p>En cumplimiento de la Ley 34/2002 de Servicios de la Sociedad de la Información y de Comercio Electrónico (LSSI-CE), se informa que este sitio web es titularidad de <strong>Restaurante La Montaña</strong>, con domicilio en C. del Rey Francisco, 28, 28008 Madrid.</p>'
        },
        privacidad: {
          titulo: 'Política de Privacidad (RGPD)',
          cuerpo: '<p>De conformidad con el Reglamento General de Protección de Datos (RGPD), los datos personales facilitados en el formulario de reservas se emplean exclusivamente para gestionar su reserva de mesa y no se ceden a terceros.</p>'
        },
        cookies: {
          titulo: 'Política de Cookies',
          cuerpo: '<p>Este sitio web utiliza únicamente cookies técnicas de sesión necesarias para el funcionamiento del sistema de reservas y del área de administración.</p>'
        }
      };

      document.querySelectorAll('[data-legal]').forEach(function (link) {
        link.addEventListener('click', function (e) {
          e.preventDefault();
          const key = link.getAttribute('data-legal');
          const info = textosLegales[key];
          if (info && legalModal) {
            legalTitle.textContent = info.titulo;
            legalBody.innerHTML = info.cuerpo;
            legalModal.classList.remove('hidden');
            legalModal.classList.add('flex');
          }
        });
      });

      if (closeLegal && legalModal) {
        closeLegal.addEventListener('click', function () {
          legalModal.classList.add('hidden');
          legalModal.classList.remove('flex');
        });
        legalModal.addEventListener('click', function (e) {
          if (e.target === legalModal) {
            legalModal.classList.add('hidden');
            legalModal.classList.remove('flex');
          }
        });
      }
    });
  </script>
</body>
</html>
