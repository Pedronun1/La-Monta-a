<!DOCTYPE html>
<html lang="es" class="scroll-smooth dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= restaurant.name %> — Alta Cocina Castiza & Reservas | <%= restaurant.subtitle %></title>
  <meta name="description" content="<%= restaurant.description %>" />

  <!-- Tipografías de Alta Gastronomía: Cormorant Garamond (Serif) & Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,400;1,600&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

  <!-- Tailwind CSS con configuración de dirección de arte #09090b y #f59e0b -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            obsidian: '#09090b',
            amber: {
              400: '#fbbf24',
              500: '#f59e0b',
              600: '#d97706'
            }
          },
          fontFamily: {
            serif: ["'Cormorant Garamond'", 'Georgia', 'serif'],
            sans: ["'Plus Jakarta Sans'", 'system-ui', 'sans-serif']
          }
        }
      }
    };
  </script>

  <!-- Hoja de estilos de lujo y animaciones personalizadas -->
  <link rel="stylesheet" href="/css/luxury.css" />
</head>
<body class="bg-[#09090b] text-stone-100 font-sans antialiased selection:bg-amber-500 selection:text-stone-950">

  <!-- =========================================================================
       BARRA DE NAVEGACIÓN SUPERIOR CON BLUR Y TRANSPARENCIA
  ========================================================================= -->
  <header class="backdrop-blur-md bg-stone-950/80 sticky top-0 z-50 border-b border-stone-800/80 transition-all duration-300 ease-in-out">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
      <!-- Marca y Subtítulo -->
      <a href="#inicio" class="flex items-center gap-3.5 group">
        <div class="w-11 h-11 rounded-full bg-stone-900 border border-amber-500/40 flex items-center justify-center shadow-[0_0_20px_rgba(245,158,11,0.15)] group-hover:border-amber-400 transition-all duration-300 ease-in-out">
          <span class="font-serif text-xl font-bold text-amber-500 tracking-wider">LM</span>
        </div>
        <div>
          <span class="block font-serif text-2xl sm:text-3xl font-semibold text-stone-50 tracking-wide leading-none group-hover:text-amber-400 transition-all duration-300">
            <%= restaurant.name %>
          </span>
          <span class="block text-[10px] uppercase tracking-[0.26em] text-amber-500/90 mt-1 font-medium">
            <%= restaurant.subtitle %>
          </span>
        </div>
      </a>

      <!-- Enlaces de Navegación Desktop -->
      <nav class="hidden lg:flex items-center gap-8 text-xs uppercase tracking-[0.18em] text-stone-300 font-medium">
        <a href="#inicio" class="hover:text-amber-400 transition-all duration-300 ease-in-out">Inicio</a>
        <a href="#carta" class="hover:text-amber-400 transition-all duration-300 ease-in-out">La Carta</a>
        <a href="#espacios" class="hover:text-amber-400 transition-all duration-300 ease-in-out">La Cueva 1943</a>
        <a href="#reservas" class="hover:text-amber-400 transition-all duration-300 ease-in-out">Reservas</a>
        <a href="#opiniones" class="hover:text-amber-400 transition-all duration-300 ease-in-out">Críticas</a>
        <a href="#ubicacion" class="hover:text-amber-400 transition-all duration-300 ease-in-out">Contacto</a>
      </nav>

      <!-- Acciones Rápidas y Acceso Privado -->
      <div class="hidden md:flex items-center gap-3">
        <a
          href="tel:<%= restaurant.contact.phoneClean %>"
          class="px-3.5 py-2 rounded-full text-xs font-medium text-stone-300 hover:text-amber-400 border border-stone-800 hover:border-amber-500/40 bg-stone-900/60 transition-all duration-300 ease-in-out"
        >
          <%= restaurant.contact.phone %>
        </a>

        <a
          href="#reservas"
          class="btn-shine px-5 py-2.5 rounded-full text-xs uppercase tracking-[0.15em] font-semibold bg-amber-500 hover:bg-amber-400 text-stone-950 shadow-[0_0_25px_rgba(245,158,11,0.25)] hover:shadow-[0_0_35px_rgba(245,158,11,0.45)] transition-all duration-300 ease-in-out flex items-center gap-2"
        >
          <span>Reservar Mesa</span>
          <span id="nav-preselected-badge" class="hidden px-1.5 py-0.5 text-[10px] rounded-full bg-stone-950 text-amber-400 font-bold">0</span>
        </a>

        <a
          href="/admin"
          class="p-2.5 rounded-full text-stone-400 hover:text-amber-400 border border-stone-800/80 hover:border-amber-500/40 bg-stone-900/50 transition-all duration-300 ease-in-out"
          title="Acceso privado Dirección (/admin)"
          aria-label="Panel de Administración"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
        </a>
      </div>

      <!-- Botón Menú Móvil -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="lg:hidden p-2.5 rounded-xl border border-stone-800 bg-stone-900/80 text-stone-200 hover:text-amber-400 transition-all duration-300"
        aria-label="Abrir menú"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>

    <!-- Menú Desplegable Móvil -->
    <div id="mobile-menu-panel" class="hidden lg:hidden bg-stone-950/95 backdrop-blur-xl border-b border-stone-800 px-6 py-6 space-y-4">
      <div class="flex flex-col space-y-3 text-sm uppercase tracking-[0.16em] text-stone-300">
        <a href="#inicio" class="mobile-nav-link py-1.5 hover:text-amber-400 transition-colors">Inicio</a>
        <a href="#carta" class="mobile-nav-link py-1.5 hover:text-amber-400 transition-colors">La Carta y Bodega</a>
        <a href="#espacios" class="mobile-nav-link py-1.5 hover:text-amber-400 transition-colors">La Cueva de 1943</a>
        <a href="#reservas" class="mobile-nav-link py-1.5 hover:text-amber-400 transition-colors">Reservar Mesa</a>
        <a href="#opiniones" class="mobile-nav-link py-1.5 hover:text-amber-400 transition-colors">Opiniones</a>
        <a href="#ubicacion" class="mobile-nav-link py-1.5 hover:text-amber-400 transition-colors">Ubicación y Horarios</a>
        <a href="/admin" class="mobile-nav-link py-1.5 text-amber-500/90 hover:text-amber-400 transition-colors">🔒 Panel Privado (/admin)</a>
      </div>
      <div class="pt-3 border-t border-stone-800 flex flex-col gap-2.5">
        <a href="#reservas" class="mobile-nav-link w-full py-3 rounded-full bg-amber-500 text-stone-950 text-center text-xs uppercase tracking-widest font-bold">
          Reservar Mesa Ahora
        </a>
        <a href="tel:<%= restaurant.contact.phoneClean %>" class="w-full py-2.5 rounded-full border border-stone-800 text-stone-300 text-center text-xs">
          Llamar: <%= restaurant.contact.phone %>
        </a>
      </div>
    </div>
  </header>

  <!-- =========================================================================
       1. HERO SECTION IMPACTANTE (Atmósfera Oscura + Subtítulo Moncloa - Aravaca)
  ========================================================================= -->
  <section id="inicio" class="relative min-h-[92vh] flex items-center overflow-hidden bg-[#09090b]">
    <!-- Fotografía atmosférica de alta cocina con gradiente multicapa -->
    <div class="absolute inset-0 z-0">
      <img
        src="https://images.unsplash.com/photo-1544025162-d76694265947?auto=format&fit=crop&w=2000&q=85"
        alt="Alta cocina castiza y brasas en Restaurante La Montaña Madrid"
        class="w-full h-full object-cover object-center opacity-30 scale-105 transition-transform duration-1000"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-[#09090b] via-[#09090b]/90 to-[#09090b]/55"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-[#09090b] via-transparent to-[#09090b]/80"></div>
      <div class="absolute -top-40 -left-40 w-96 h-96 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 w-full">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <!-- Columna Principal del Hero -->
        <div class="lg:col-span-7 space-y-7 animate-fade-up">
          <div class="inline-flex items-center gap-3 px-4 py-1.5 rounded-full bg-stone-900/90 border border-amber-500/30 text-amber-400 text-[11px] uppercase tracking-[0.24em] font-medium">
            <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span>
            <span><%= restaurant.subtitle %> · <%= restaurant.address.street %></span>
          </div>

          <div class="space-y-3">
            <p class="font-serif italic text-amber-400/90 text-xl sm:text-2xl tracking-wide">
              Casa de Comidas & Alta Tradición Castiza desde <%= restaurant.foundedYear %>
            </p>
            <h1 class="font-serif text-5xl sm:text-7xl lg:text-8xl font-semibold text-stone-50 tracking-tight leading-[1.02]">
              Restaurante <br />
              <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-300 via-amber-500 to-amber-600">
                <%= restaurant.name %>
              </span>
            </h1>
          </div>

          <p class="text-stone-300 text-base sm:text-lg max-w-2xl leading-relaxed font-light">
            <%= restaurant.description %> Descubra nuestras célebres
            <span class="text-amber-400 font-medium">croquetas cremosas de bellota, huevos camperos trufados, verdinas con carabineros, oreja crujiente y carnes maduradas a la brasa</span>.
          </p>

          <!-- Botones CTA con bordes redondeados y efecto de brillo -->
          <div class="flex flex-wrap items-center gap-4 pt-2">
            <a
              href="#reservas"
              class="btn-shine px-8 py-4 rounded-full bg-amber-500 hover:bg-amber-400 text-stone-950 font-semibold text-xs sm:text-sm uppercase tracking-[0.18em] shadow-[0_0_30px_rgba(245,158,11,0.3)] hover:shadow-[0_0_40px_rgba(245,158,11,0.5)] transition-all duration-300 ease-in-out transform hover:-translate-y-0.5"
            >
              Reservar Mesa
            </a>
            <a
              href="#carta"
              class="px-8 py-4 rounded-full bg-stone-900/80 hover:bg-stone-800/90 text-stone-100 hover:text-amber-400 border border-stone-700/80 hover:border-amber-500/50 font-semibold text-xs sm:text-sm uppercase tracking-[0.18em] transition-all duration-300 ease-in-out transform hover:-translate-y-0.5"
            >
              Explorar La Carta
            </a>
          </div>

          <!-- Métricas de Prestigio -->
          <div class="grid grid-cols-3 gap-6 pt-6 border-t border-stone-800/80 max-w-xl">
            <div>
              <span class="font-serif text-3xl sm:text-4xl font-semibold text-amber-500">★ <%= restaurant.ratings.score %></span>
              <span class="block text-[11px] uppercase tracking-widest text-stone-400 mt-1"><%= restaurant.ratings.totalReviews %> Reseñas Google</span>
            </div>
            <div>
              <span class="font-serif text-3xl sm:text-4xl font-semibold text-amber-500"><%= restaurant.foundedYear %></span>
              <span class="block text-[11px] uppercase tracking-widest text-stone-400 mt-1">Legado en Argüelles</span>
            </div>
            <div>
              <span class="font-serif text-3xl sm:text-4xl font-semibold text-amber-500">Cueva</span>
              <span class="block text-[11px] uppercase tracking-widest text-stone-400 mt-1">Bodega Histórica</span>
            </div>
          </div>
        </div>

        <!-- Columna Derecha: Tarjeta Glassmorphism de Horarios y Ubicación -->
        <div class="lg:col-span-5">
          <div class="bg-stone-950/85 backdrop-blur-xl border border-stone-800 hover:border-amber-500/30 rounded-3xl p-7 sm:p-9 shadow-2xl transition-all duration-300 ease-in-out">
            <div class="flex items-center justify-between border-b border-stone-800/90 pb-5 mb-6">
              <div>
                <span class="text-[10px] uppercase tracking-[0.25em] text-amber-500 font-semibold block">
                  Horarios Oficiales
                </span>
                <h2 class="font-serif text-2xl sm:text-3xl font-semibold text-stone-50 mt-1">
                  Servicio de Sala y Cocina
                </h2>
              </div>
              <span class="px-3 py-1 rounded-full text-[11px] font-semibold bg-amber-500/10 text-amber-400 border border-amber-500/30">
                Madrid · 28008
              </span>
            </div>

            <div class="space-y-3 text-sm">
              <% restaurant.hours.forEach(function(h) { %>
                <div class="flex items-center justify-between py-2.5 px-4 rounded-2xl border <%= h.open ? 'bg-stone-900/60 border-stone-800/80 text-stone-200' : 'bg-stone-900/30 border-stone-800/40 text-stone-500' %>">
                  <span class="font-medium"><%= h.day %></span>
                  <span class="<%= h.open ? 'text-amber-400 font-medium' : 'text-stone-500 italic' %> text-xs sm:text-sm">
                    <%= h.shifts %>
                  </span>
                </div>
              <% }); %>
            </div>

            <div class="mt-7 pt-6 border-t border-stone-800/90 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
              <div>
                <span class="text-[11px] uppercase tracking-widest text-stone-400 block">Atención Telefónica y Grupos</span>
                <a href="tel:<%= restaurant.contact.phoneClean %>" class="font-serif text-2xl font-semibold text-amber-400 hover:text-amber-300 transition-colors">
                  <%= restaurant.contact.phone %>
                </a>
              </div>
              <a
                href="#ubicacion"
                class="inline-flex items-center gap-2 text-xs uppercase tracking-[0.18em] text-stone-300 hover:text-amber-400 font-semibold transition-colors"
              >
                <span>Cómo llegar</span>
                <span>→</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       2. SECCIÓN DE CARTA INTERACTIVA, BODEGA Y PRECIOS
  ========================================================================= -->
  <section id="carta" class="py-24 bg-[#09090b] border-t border-stone-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Encabezado Editorial -->
      <div class="text-center max-w-3xl mx-auto mb-14 space-y-3">
        <span class="text-[11px] uppercase tracking-[0.28em] text-amber-500 font-semibold block">
          Propuesta Gastronómica · Producto de Temporada
        </span>
        <h2 class="font-serif text-4xl sm:text-6xl font-semibold text-stone-50">
          Nuestra Carta & Bodega
        </h2>
        <p class="text-stone-400 text-sm sm:text-base font-light leading-relaxed">
          Cada plato rinde tributo a la cocina castiza madrileña y norteña con ejecuciones limpias,
          materias primas con denominación de origen y precios transparentes (IVA incluido).
        </p>
      </div>

      <!-- Controles de Filtrado por Categorías (Entrantes, Principales, Postres, Vinos) + Buscador -->
      <div class="flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-4 mb-12 bg-stone-950/90 p-3.5 rounded-2xl border border-stone-800/90">
        <div class="flex flex-wrap items-center gap-2" id="menu-category-tabs">
          <button
            type="button"
            data-category="all"
            class="menu-tab-btn px-5 py-2.5 rounded-xl text-xs uppercase tracking-[0.16em] font-semibold transition-all duration-300 ease-in-out bg-amber-500 text-stone-950 shadow-[0_0_20px_rgba(245,158,11,0.25)]"
          >
            Toda la Carta (<%= menuItems.length %>)
          </button>
          <% categories.forEach(function(cat) { %>
            <button
              type="button"
              data-category="<%= cat.id %>"
              class="menu-tab-btn px-5 py-2.5 rounded-xl text-xs uppercase tracking-[0.16em] font-semibold transition-all duration-300 ease-in-out bg-stone-900/80 text-stone-300 hover:text-amber-400 border border-stone-800 hover:border-amber-500/40"
            >
              <%= cat.label %>
            </button>
          <% }); %>
        </div>

        <div class="relative min-w-[260px]">
          <input
            id="menu-search-input"
            type="text"
            placeholder="Buscar plato, trufa, ibérico, vino..."
            class="w-full pl-10 pr-4 py-2.5 rounded-xl bg-stone-900/90 border border-stone-800 text-sm text-stone-100 placeholder-stone-500 focus:outline-none focus:border-amber-500 transition-all duration-300 ease-in-out"
          />
          <svg class="w-4 h-4 text-stone-500 absolute left-3.5 top-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
      </div>

      <!-- Barra de Platos Preseleccionados para la Reserva -->
      <div id="preselected-bar" class="hidden mb-10 p-5 rounded-2xl bg-stone-900/90 border border-amber-500/40 flex flex-col sm:flex-row items-center justify-between gap-4 shadow-xl">
        <div class="flex flex-wrap items-center gap-2">
          <span class="text-xs uppercase tracking-widest text-amber-400 font-semibold mr-2">
            Selección para su mesa:
          </span>
          <div id="preselected-chips" class="flex flex-wrap gap-2"></div>
        </div>
        <a
          href="#reservas"
          class="px-5 py-2.5 rounded-full bg-amber-500 hover:bg-amber-400 text-stone-950 text-xs uppercase tracking-widest font-bold shrink-0 transition-all duration-300"
        >
          Confirmar en mi Reserva →
        </a>
      </div>

      <!-- Grid de Tarjetas de Platos -->
      <div id="menu-items-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-7">
        <% menuItems.forEach(function(item) { %>
          <article
            data-category="<%= item.category %>"
            data-name="<%= item.name.toLowerCase() %>"
            data-desc="<%= item.description.toLowerCase() %>"
            class="menu-card-item luxury-card bg-stone-950/90 rounded-2xl overflow-hidden border border-stone-800 hover:border-amber-500/40 flex flex-col justify-between group"
          >
            <div>
              <!-- Fotografía del Plato -->
              <div class="relative h-56 overflow-hidden bg-stone-900">
                <img
                  src="<%= item.image %>"
                  alt="<%= item.name %>"
                  loading="lazy"
                  class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700 ease-out opacity-90 group-hover:opacity-100"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-stone-950 via-stone-950/20 to-transparent"></div>

                <!-- Etiqueta Elegante de Categoría -->
                <span class="absolute top-3.5 left-3.5 px-3 py-1 rounded-full text-[10px] uppercase tracking-[0.2em] font-semibold bg-stone-950/85 text-amber-400 border border-amber-500/30 backdrop-blur-md">
                  <%= item.category %>
                </span>

                <% if (item.tag) { %>
                  <span class="absolute top-3.5 right-3.5 px-3 py-1 rounded-full text-[10px] uppercase tracking-wider font-medium bg-stone-900/85 text-stone-300 border border-stone-700/80 backdrop-blur-md">
                    <%= item.tag %>
                  </span>
                <% } %>

                <!-- Precio Destacado en Ámbar -->
                <div class="absolute bottom-3.5 right-4 bg-stone-950/90 backdrop-blur-md border border-amber-500/40 px-4 py-1.5 rounded-full shadow-lg">
                  <span class="font-serif text-2xl font-bold text-amber-500">
                    <%= item.price.toFixed(2).replace('.', ',') %> €
                  </span>
                </div>
              </div>

              <!-- Descripción del Plato -->
              <div class="p-6">
                <h3 class="font-serif text-2xl font-semibold text-stone-100 group-hover:text-amber-400 transition-colors duration-300 leading-snug">
                  <%= item.name %>
                </h3>
                <p class="text-stone-400 text-sm font-light mt-2.5 leading-relaxed">
                  <%= item.description %>
                </p>
              </div>
            </div>

            <!-- Pie de Tarjeta: Alérgenos y Botón de Selección -->
            <div class="px-6 pb-6 pt-3 border-t border-stone-900 flex items-center justify-between gap-3">
              <span class="text-[11px] text-stone-500 tracking-wide">
                <%= item.allergens %>
              </span>
              <button
                type="button"
                data-dish="<%= item.name %>"
                class="toggle-dish-btn px-3.5 py-1.5 rounded-full text-[11px] uppercase tracking-wider font-semibold border border-stone-800 hover:border-amber-500/50 bg-stone-900/70 hover:bg-amber-500 hover:text-stone-950 text-stone-300 transition-all duration-300 ease-in-out"
              >
                + Añadir a Reserva
              </button>
            </div>
          </article>
        <% }); %>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       3. SECCIÓN DE ESPACIOS Y BODEGA HISTÓRICA (LA CUEVA DE 1943)
  ========================================================================= -->
  <section id="espacios" class="py-24 bg-stone-950/70 border-t border-stone-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16 space-y-3">
        <span class="text-[11px] uppercase tracking-[0.28em] text-amber-500 font-semibold block">
          Arquitectura & Atmósfera · C. del Rey Francisco, 28
        </span>
        <h2 class="font-serif text-4xl sm:text-5xl font-semibold text-stone-50">
          Nuestros Espacios Gastronómicos
        </h2>
        <p class="text-stone-400 text-sm sm:text-base font-light">
          Tres ambientes diferenciados donde disfrutar desde un aperitivo informal hasta una cena
          privada bajo nuestra bóveda histórica de ladrillo de 1943.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <% restaurant.diningAreas.forEach(function(area) { %>
          <div class="luxury-card bg-[#09090b] border border-stone-800 hover:border-amber-500/40 rounded-3xl p-8 flex flex-col justify-between">
            <div class="space-y-4">
              <div class="flex items-center justify-between">
                <span class="text-[10px] uppercase tracking-[0.22em] text-amber-500 font-semibold px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/20">
                  <%= area.capacity %>
                </span>
                <span class="text-amber-500/60 font-serif italic text-lg">La Montaña</span>
              </div>
              <h3 class="font-serif text-2xl sm:text-3xl font-semibold text-stone-100">
                <%= area.name %>
              </h3>
              <p class="text-stone-400 text-sm font-light leading-relaxed">
                <%= area.description %>
              </p>
            </div>
            <div class="mt-8 pt-4 border-t border-stone-900">
              <a
                href="#reservas"
                data-select-area="<%= area.id %>"
                class="select-area-link inline-flex items-center gap-2 text-xs uppercase tracking-[0.18em] text-amber-400 hover:text-amber-300 font-semibold transition-colors"
              >
                <span>Reservar en este salón</span>
                <span>→</span>
              </a>
            </div>
          </div>
        <% }); %>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       4. FORMULARIO DE RESERVA AVANZADO (Inputs focus:border-amber-500)
  ========================================================================= -->
  <section id="reservas" class="py-24 bg-[#09090b] border-t border-stone-900 relative overflow-hidden">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-center max-w-2xl mx-auto mb-14 space-y-3">
        <span class="text-[11px] uppercase tracking-[0.28em] text-amber-500 font-semibold block">
          Confirmación Inmediata Online
        </span>
        <h2 class="font-serif text-4xl sm:text-6xl font-semibold text-stone-50">
          Reservar una Mesa
        </h2>
        <p class="text-stone-400 text-sm sm:text-base font-light">
          Seleccione fecha, turno y número de comensales. Nuestro sistema verifica la disponibilidad
          en tiempo real y emite su código de reserva al instante.
        </p>
      </div>

      <!-- Contenedor Principal del Formulario -->
      <div class="bg-stone-950/90 border border-stone-800 rounded-3xl p-6 sm:p-10 lg:p-12 shadow-2xl">
        <!-- Vista de Confirmación Exitosa (Oculta inicialmente) -->
        <div id="reservation-success-box" class="hidden text-center py-8 space-y-6 animate-fade-up">
          <div class="w-16 h-16 rounded-full bg-amber-500/15 border border-amber-500/40 text-amber-400 flex items-center justify-center mx-auto text-3xl">
            ✓
          </div>
          <div class="space-y-2">
            <span class="text-xs uppercase tracking-[0.25em] text-amber-400 font-semibold block">
              Reserva Confirmada en Base de Datos
            </span>
            <h3 id="res-confirm-title" class="font-serif text-3xl sm:text-4xl font-semibold text-stone-50">
              ¡Le esperamos en La Montaña!
            </h3>
            <p class="text-stone-400 text-sm max-w-md mx-auto">
              Guarde su código oficial de reserva para cualquier consulta a su llegada a Calle del Rey Francisco, 28.
            </p>
          </div>

          <div class="inline-block bg-[#09090b] border border-amber-500/40 rounded-2xl px-8 py-4">
            <span class="text-[10px] uppercase tracking-[0.25em] text-stone-400 block">Código Oficial</span>
            <span id="res-confirm-code" class="font-mono text-2xl font-bold text-amber-500 tracking-wider">LM-2026-0000</span>
          </div>

          <div id="res-confirm-details" class="max-w-lg mx-auto bg-[#09090b] border border-stone-800 rounded-2xl p-6 text-left text-sm space-y-2 text-stone-300"></div>

          <div class="pt-4">
            <button
              id="new-reservation-btn"
              type="button"
              class="px-7 py-3 rounded-full bg-stone-900 hover:bg-stone-800 text-amber-400 border border-amber-500/30 text-xs uppercase tracking-widest font-semibold transition-all duration-300"
            >
              Realizar otra reserva
            </button>
          </div>
        </div>

        <!-- Formulario Interactivo -->
        <form id="reservation-form" class="space-y-7" novalidate>
          <div id="reservation-error-alert" class="hidden p-4 rounded-2xl bg-red-950/70 border border-red-500/40 text-red-200 text-sm"></div>

          <!-- Fila 1: Fecha, Hora y Comensales -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
            <div>
              <label for="res-date" class="block text-[11px] uppercase tracking-[0.18em] text-stone-300 font-semibold mb-2.5">
                Fecha de Reserva *
              </label>
              <input
                id="res-date"
                name="date"
                type="date"
                required
                class="w-full px-4 py-3.5 rounded-xl bg-[#09090b] border border-stone-800 text-stone-100 text-sm focus:outline-none focus:border-amber-500 focus:ring-2 focus:ring-amber-500/20 transition-all duration-300 ease-in-out"
              />
            </div>

            <div>
              <label for="res-time" class="block text-[11px] uppercase tracking-[0.18em] text-stone-300 font-semibold mb-2.5">
                Turno Horario *
              </label>
              <select
                id="res-time"
                name="time"
                required
                class="w-full px-4 py-3.5 rounded-xl bg-[#09090b] border border-stone-800 text-stone-100 text-sm focus:outline-none focus:border-amber-500 focus:ring-2 focus:ring-amber-500/20 transition-all duration-300 ease-in-out"
              >
                <optgroup label="Turno de Almuerzo">
                  <% timeSlots.lunch.forEach(function(t) { %>
                    <option value="<%= t %>" <%= t === '14:00' ? 'selected' : '' %>><%= t %> h (Comida)</option>
                  <% }); %>
                </optgroup>
                <optgroup label="Turno de Cena">
                  <% timeSlots.dinner.forEach(function(t) { %>
                    <option value="<%= t %>"><%= t %> h (Cena)</option>
                  <% }); %>
                </optgroup>
              </select>
            </div>

            <div>
              <label for="res-guests" class="block text-[11px] uppercase tracking-[0.18em] text-stone-300 font-semibold mb-2.5">
                Comensales *
              </label>
              <select
                id="res-guests"
                name="guests"
                required
                class="w-full px-4 py-3.5 rounded-xl bg-[#09090b] border border-stone-800 text-stone-100 text-sm focus:outline-none focus:border-amber-500 focus:ring-2 focus:ring-amber-500/20 transition-all duration-300 ease-in-out"
              >
                <% [1, 2, 3, 4, 5, 6, 7, 8, 10, 12].forEach(function(n) { %>
                  <option value="<%= n %>" <%= n === 2 ? 'selected' : '' %>>
                    <%= n %> <%= n === 1 ? 'Comensal' : 'Comensales' %>
                  </option>
                <% }); %>
              </select>
            </div>
          </div>

          <!-- Indicador dinámico de disponibilidad para la fecha elegida -->
          <div id="availability-status-bar" class="px-4 py-2.5 rounded-xl bg-[#09090b] border border-stone-800/90 flex items-center justify-between text-xs text-stone-400">
            <span id="availability-text">Consultando disponibilidad en tiempo real...</span>
            <span class="text-amber-500 font-medium">Confirmación inmediata</span>
          </div>

          <!-- Fila 2: Salón Preferido, Nombre, Teléfono y Email -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
              <label for="res-area" class="block text-[11px] uppercase tracking-[0.18em] text-stone-300 font-semibold mb-2.5">
                Espacio Preferido *
              </label>
              <select
                id="res-area"
                name="diningArea"
                class="w-full px-4 py-3.5 rounded-xl bg-[#09090b] border border-stone-800 text-stone-100 text-sm focus:outline-none focus:border-amber-500 focus:ring-2 focus:ring-amber-500/20 transition-all duration-300 ease-in-out"
              >
                <% restaurant.diningAreas.forEach(function(a) { %>
                  <option value="<%= a.id %>"><%= a.name %></option>
                <% }); %>
              </select>
            </div>

            <div>
              <label for="res-name" class="block text-[11px] uppercase tracking-[0.18em] text-stone-300 font-semibold mb-2.5">
                Nombre y Apellidos *
              </label>
              <input
                id="res-name"
                name="name"
                type="text"
                required
                placeholder="Ej. Carlos Mendoza"
                class="w-full px-4 py-3.5 rounded-xl bg-[#09090b] border border-stone-800 text-stone-100 placeholder-stone-600 text-sm focus:outline-none focus:border-amber-500 focus:ring-2 focus:ring-amber-500/20 transition-all duration-300 ease-in-out"
              />
            </div>

            <div>
              <label for="res-phone" class="block text-[11px] uppercase tracking-[0.18em] text-stone-300 font-semibold mb-2.5">
                Teléfono Móvil *
              </label>
              <input
                id="res-phone"
                name="phone"
                type="tel"
                required
                placeholder="+34 600 000 000"
                class="w-full px-4 py-3.5 rounded-xl bg-[#09090b] border border-stone-800 text-stone-100 placeholder-stone-600 text-sm focus:outline-none focus:border-amber-500 focus:ring-2 focus:ring-amber-500/20 transition-all duration-300 ease-in-out"
              />
            </div>

            <div>
              <label for="res-email" class="block text-[11px] uppercase tracking-[0.18em] text-stone-300 font-semibold mb-2.5">
                Correo Electrónico *
              </label>
              <input
                id="res-email"
                name="email"
                type="email"
                required
                placeholder="cliente@dominio.es"
                class="w-full px-4 py-3.5 rounded-xl bg-[#09090b] border border-stone-800 text-stone-100 placeholder-stone-600 text-sm focus:outline-none focus:border-amber-500 focus:ring-2 focus:ring-amber-500/20 transition-all duration-300 ease-in-out"
              />
            </div>
          </div>

          <!-- Comentarios o Alergias -->
          <div>
            <label for="res-notes" class="block text-[11px] uppercase tracking-[0.18em] text-stone-300 font-semibold mb-2.5">
              Alergias, Intolerancias o Peticiones Especiales
            </label>
            <textarea
              id="res-notes"
              name="notes"
              rows="3"
              placeholder="Indíquenos si algún comensal presenta alergias (gluten, frutos secos, lactosa, marisco) o si celebran una ocasión especial..."
              class="w-full px-4 py-3.5 rounded-xl bg-[#09090b] border border-stone-800 text-stone-100 placeholder-stone-600 text-sm focus:outline-none focus:border-amber-500 focus:ring-2 focus:ring-amber-500/20 transition-all duration-300 ease-in-out"
            ></textarea>
          </div>

          <!-- Botón de Envío con Animación de Carga Suave -->
          <button
            id="res-submit-btn"
            type="submit"
            class="btn-shine w-full py-4 rounded-xl bg-amber-500 hover:bg-amber-400 text-stone-950 font-bold text-xs sm:text-sm uppercase tracking-[0.2em] shadow-[0_0_30px_rgba(245,158,11,0.25)] hover:shadow-[0_0_40px_rgba(245,158,11,0.45)] transition-all duration-300 ease-in-out flex items-center justify-center gap-3"
          >
            <span id="res-submit-spinner" class="hidden spinner-amber"></span>
            <span id="res-submit-text">Confirmar Reserva de Mesa</span>
          </button>
        </form>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       5. SECCIÓN DE OPINIONES Y RESEÑAS DESTACADAS
  ========================================================================= -->
  <section id="opiniones" class="py-24 bg-stone-950/70 border-t border-stone-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16 space-y-3">
        <span class="text-[11px] uppercase tracking-[0.28em] text-amber-500 font-semibold block">
          Excelencia Valorada en Google Maps (<%= restaurant.ratings.score %> ★)
        </span>
        <h2 class="font-serif text-4xl sm:text-5xl font-semibold text-stone-50">
          La Experiencia de Nuestros Comensales
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <% restaurant.ratings.reviews.forEach(function(rev) { %>
          <article class="luxury-card bg-[#09090b] border border-stone-800 hover:border-amber-500/40 rounded-3xl p-8 flex flex-col justify-between">
            <div class="space-y-4">
              <div class="flex items-center justify-between">
                <span class="text-amber-500 tracking-widest text-sm">★★★★★</span>
                <span class="text-xs text-stone-500"><%= rev.date %></span>
              </div>
              <p class="font-serif italic text-xl text-stone-200 leading-relaxed">
                “<%= rev.comment %>”
              </p>
            </div>
            <div class="mt-6 pt-5 border-t border-stone-900">
              <p class="font-semibold text-stone-100 text-sm"><%= rev.author %></p>
              <p class="text-xs text-stone-500 mt-0.5"><%= rev.role %></p>
              <p class="text-[11px] text-amber-500/90 mt-2 font-medium">✦ <%= rev.dish %></p>
            </div>
          </article>
        <% }); %>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       6. INFORMACIÓN DE CONTACTO Y MAPA EN MONCLOA - ARAVACA
  ========================================================================= -->
  <section id="ubicacion" class="py-24 bg-[#09090b] border-t border-stone-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-stretch">
        <!-- Detalles de Dirección y Transporte -->
        <div class="lg:col-span-5 bg-stone-950 border border-stone-800 rounded-3xl p-8 sm:p-10 flex flex-col justify-between space-y-8">
          <div class="space-y-6">
            <div>
              <span class="text-[11px] uppercase tracking-[0.25em] text-amber-500 font-semibold block">
                Ubicación Oficial
              </span>
              <h2 class="font-serif text-3xl sm:text-4xl font-semibold text-stone-50 mt-2">
                <%= restaurant.address.street %>
              </h2>
              <p class="text-stone-400 text-sm mt-1">
                <%= restaurant.address.postalCode %> <%= restaurant.address.city %> · <%= restaurant.address.district %> (<%= restaurant.address.neighborhood %>)
              </p>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
              <div class="p-4 rounded-2xl bg-[#09090b] border border-stone-800">
                <span class="text-[10px] uppercase tracking-widest text-stone-500 block">Teléfono de Sala</span>
                <a href="tel:<%= restaurant.contact.phoneClean %>" class="font-serif text-2xl font-semibold text-amber-400 hover:text-amber-300 mt-1 block">
                  <%= restaurant.contact.phone %>
                </a>
              </div>
              <div class="p-4 rounded-2xl bg-[#09090b] border border-stone-800">
                <span class="text-[10px] uppercase tracking-widest text-stone-500 block">Reservas & Eventos</span>
                <a href="mailto:<%= restaurant.contact.email %>" class="text-xs font-medium text-stone-200 hover:text-amber-400 mt-2 block truncate">
                  <%= restaurant.contact.email %>
                </a>
              </div>
            </div>

            <div class="space-y-3 pt-2">
              <span class="text-[11px] uppercase tracking-[0.2em] text-stone-400 font-semibold block">
                Accesos y Transporte Público
              </span>
              <% restaurant.address.transport.forEach(function(item) { %>
                <div class="flex items-center justify-between py-2 px-3.5 rounded-xl bg-[#09090b] border border-stone-800/80 text-xs">
                  <span class="text-amber-400 font-semibold"><%= item.label %></span>
                  <span class="text-stone-400"><%= item.detail %></span>
                </div>
              <% }); %>
            </div>
          </div>

          <a
            href="<%= restaurant.address.googleMapsUrl %>"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-shine w-full py-4 rounded-full bg-amber-500 hover:bg-amber-400 text-stone-950 text-center text-xs uppercase tracking-[0.2em] font-bold transition-all duration-300 block"
          >
            Abrir en Google Maps ↗
          </a>
        </div>

        <!-- Mapa Interactivo de Google Maps -->
        <div class="lg:col-span-7 rounded-3xl overflow-hidden border border-stone-800 min-h-[450px] bg-stone-950 shadow-2xl">
          <iframe
            title="Mapa de Restaurante La Montaña en C. del Rey Francisco, 28, Moncloa - Aravaca, Madrid"
            src="<%= restaurant.address.googleMapsEmbedUrl %>"
            class="w-full h-full min-h-[450px] border-0 opacity-90 hover:opacity-100 transition-opacity duration-500"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       PIE DE PÁGINA (FOOTER)
  ========================================================================= -->
  <footer class="bg-stone-950 border-t border-stone-900 py-12 text-stone-500 text-xs">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-6">
      <div class="flex items-center gap-3">
        <span class="font-serif text-2xl font-semibold text-stone-200"><%= restaurant.name %></span>
        <span class="text-stone-700">|</span>
        <span><%= restaurant.address.fullAddress %></span>
      </div>
      <div class="flex items-center gap-6">
        <a href="#carta" class="hover:text-amber-400 transition-colors">Carta</a>
        <a href="#reservas" class="hover:text-amber-400 transition-colors">Reservas</a>
        <a href="/admin" class="text-stone-400 hover:text-amber-400 transition-colors">Acceso Dirección (/admin)</a>
      </div>
    </div>
  </footer>

  <!-- Script Cliente para Filtrado de Carta, Disponibilidad y Envío de Reserva -->
  <script src="/js/main.js"></script>
</body>
</html>
