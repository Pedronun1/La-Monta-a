<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Restaurante La Montaña | Cocina Tradicional Castiza en Madrid desde 1943</title>
  <meta name="description" content="Restaurante La Montaña en C. del Rey Francisco, 28, Moncloa - Aravaca, 28008 Madrid. Casa de comidas tradicional fundada en 1943: Verdinas con carabineros, Fabada, Merluza de pincho, Cocochas, Ternera en pepitoria, Chuletón de vaca y Torrijas caseras. Reservas: +34 915 47 31 11." />
  <meta name="robots" content="index, follow" />
  <meta property="og:title" content="Restaurante La Montaña — C. del Rey Francisco, 28, Madrid" />
  <meta property="og:description" content="Salones señoriales, azulejería clásica y cueva abovedada de ladrillo visto desde 1943 en Moncloa - Aravaca. Consulte nuestra carta oficial y reserve su mesa." />
  <meta property="og:type" content="website" />

  <!-- Favicon Corporativo Vectorial (Monograma L.M) -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="shortcut icon" href="/favicon.svg" />

  <!-- Tipografías Clásicas de Autor ("Silent Luxury"): Playfair Display, Cormorant Garamond (Serif) & Montserrat (Sans-Serif Ligera) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Montserrat:wght@200;300;400;500;600&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet" />

  <!-- Tailwind CSS con Paleta Antracita (#09090b), Dorado Champán (#d4af37) y Blanco Marfil (#f4f4f5) -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            anthracite: '#09090b',
            surface: '#111115',
            champagne: '#d4af37',
            ivory: '#f4f4f5'
          },
          fontFamily: {
            serif: ["'Playfair Display'", "'Cormorant Garamond'", 'Georgia', 'serif'],
            sans: ["'Montserrat'", 'system-ui', 'sans-serif']
          }
        }
      }
    };
  </script>

  <!-- Estilos Propios de Alta Cocina -->
  <link rel="stylesheet" href="/css/luxury.css" />

  <!-- Datos Estructurados Schema.org -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Restaurant",
    "name": "Restaurante La Montaña",
    "foundingDate": "1943",
    "telephone": "+34 915 47 31 11",
    "priceRange": "€€",
    "servesCuisine": "Cocina Tradicional Española y Castiza",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "C. del Rey Francisco, 28",
      "addressLocality": "Madrid",
      "addressRegion": "Moncloa - Aravaca",
      "postalCode": "28008",
      "addressCountry": "ES"
    }
  }
  </script>
</head>
<body class="bg-[#09090b] text-[#f4f4f5] font-sans font-light antialiased selection:bg-[#d4af37] selection:text-[#09090b]">

  <!-- =========================================================================
       1. CABECERA (NAVBAR) PROFESIONAL, LIMPIA Y CORPORATIVA (100% RESPONSIVA)
  ========================================================================= -->
  <header class="lm-navbar backdrop-blur-md bg-stone-950/80 sticky top-0 z-50 border-b border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-10 h-20 sm:h-24 flex items-center justify-between gap-3">
      <!-- Logotipo Corporativo: Monograma "L.M" + Nombre Tipográfico Serif -->
      <a href="#inicio" class="flex items-center gap-3 sm:gap-4 group no-underline min-w-0">
        <span class="lm-monogram-seal group-hover:border-[#e5e5e5] transition-colors">
          <%= restaurant.monogram %>
        </span>
        <div class="flex flex-col truncate">
          <span class="font-serif text-xl sm:text-2xl md:text-[26px] font-medium tracking-[0.12em] sm:tracking-[0.14em] uppercase text-[#f4f1ea] leading-none truncate">
            La Montaña
          </span>
          <span class="text-[8px] sm:text-[9px] tracking-[0.26em] sm:tracking-[0.34em] uppercase text-[#d4af37] mt-1.5 font-normal truncate">
            Madrid · Casa Fundada en <%= restaurant.foundedYear %>
          </span>
        </div>
      </a>

      <!-- Barra de Navegación Superior Minimalista (Escritorio lg+) -->
      <nav class="hidden lg:flex items-center gap-8 xl:gap-10" aria-label="Navegación principal">
        <a href="#inicio" class="lm-nav-link">INICIO</a>
        <a href="#carta" class="lm-nav-link">LA CARTA</a>
        <a href="#historia" class="lm-nav-link">HISTORIA</a>
        <a href="#reservas" class="lm-nav-link">RESERVAS</a>
        <a href="#contacto" class="lm-nav-link">CONTACTO</a>
      </nav>

      <!-- CTA Destacado y Controles Móviles / Tablet -->
      <div class="flex items-center gap-2.5 sm:gap-4">
        <a href="#reservas" class="hidden sm:inline-flex lm-btn-outline py-2.5 px-4 lg:px-6 text-[10px]">
          <span>RESERVAR MESA</span>
          <span id="nav-preselected-badge" class="hidden px-1.5 py-0.5 text-[10px] bg-[#d4af37] text-[#09090b] font-medium">0</span>
        </a>

        <a
          href="/admin"
          class="hidden xl:inline-block text-[10px] tracking-[0.22em] uppercase text-neutral-500 hover:text-[#d4af37] transition-colors pl-3 border-l border-white/10"
          title="Acceso Privado Dirección (/admin)"
        >
          DIRECCIÓN
        </a>

        <!-- Botón Menú Hamburguesa Táctil (Móviles y Tablets < lg) -->
        <button
          id="mobile-menu-btn"
          type="button"
          class="lg:hidden lm-hamburger-btn"
          aria-label="Abrir menú de navegación"
          aria-expanded="false"
          aria-controls="mobile-menu-drawer"
        >
          <svg id="hamburger-icon-open" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.4" d="M4 7h16M4 12h16M4 17h16" />
          </svg>
          <svg id="hamburger-icon-close" class="hidden w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.4" d="M6 6l12 12M6 18L18 6" />
          </svg>
        </button>
      </div>
    </div>
  </header>

  <!-- =========================================================================
       DRAWER MÓVIL DESPLEGABLE (OFF-CANVAS PARA SMARTPHONES Y TABLETS)
  ========================================================================= -->
  <div id="mobile-drawer-backdrop" class="lm-mobile-drawer-backdrop lg:hidden" aria-hidden="true"></div>

  <aside
    id="mobile-menu-drawer"
    class="lm-mobile-drawer lg:hidden"
    aria-label="Menú de navegación móvil"
    aria-hidden="true"
  >
    <div>
      <!-- Cabecera del Drawer Móvil -->
      <div class="px-6 h-20 border-b border-white/10 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <span class="lm-monogram-seal"><%= restaurant.monogram %></span>
          <div>
            <span class="font-serif text-lg uppercase tracking-[0.14em] text-[#f4f1ea] block leading-none">
              La Montaña
            </span>
            <span class="text-[8px] tracking-[0.28em] uppercase text-[#d4af37] mt-1 block">
              MADRID · <%= restaurant.foundedYear %>
            </span>
          </div>
        </div>
        <button
          id="mobile-drawer-close-btn"
          type="button"
          class="lm-hamburger-btn"
          aria-label="Cerrar menú de navegación"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.4" d="M6 6l12 12M6 18L18 6" />
          </svg>
        </button>
      </div>

      <!-- Enlaces de Navegación con Área Táctil Generosa (min-h 48px) -->
      <nav class="px-6 py-6 flex flex-col divide-y divide-white/5" aria-label="Enlaces móviles">
        <a href="#inicio" class="mobile-nav-link flex items-center justify-between py-4 text-xs tracking-[0.26em] uppercase text-[#f4f1ea] hover:text-[#d4af37] transition-colors">
          <span>INICIO</span>
          <span class="text-[#d4af37]/60 text-[10px]">01</span>
        </a>
        <a href="#carta" class="mobile-nav-link flex items-center justify-between py-4 text-xs tracking-[0.26em] uppercase text-[#f4f1ea] hover:text-[#d4af37] transition-colors">
          <span>LA CARTA OFICIAL</span>
          <span class="text-[#d4af37]/60 text-[10px]">02</span>
        </a>
        <a href="#historia" class="mobile-nav-link flex items-center justify-between py-4 text-xs tracking-[0.26em] uppercase text-[#f4f1ea] hover:text-[#d4af37] transition-colors">
          <span>HISTORIA & SALONES</span>
          <span class="text-[#d4af37]/60 text-[10px]">03</span>
        </a>
        <a href="#reservas" class="mobile-nav-link flex items-center justify-between py-4 text-xs tracking-[0.26em] uppercase text-[#f4f1ea] hover:text-[#d4af37] transition-colors">
          <span>RESERVAR MESA</span>
          <span class="text-[#d4af37]/60 text-[10px]">04</span>
        </a>
        <a href="#contacto" class="mobile-nav-link flex items-center justify-between py-4 text-xs tracking-[0.26em] uppercase text-[#f4f1ea] hover:text-[#d4af37] transition-colors">
          <span>HORARIOS & CONTACTO</span>
          <span class="text-[#d4af37]/60 text-[10px]">05</span>
        </a>
      </nav>
    </div>

    <!-- Pie del Drawer Móvil: Acciones Rápidas Táctiles -->
    <div class="px-6 pt-4 border-t border-white/10 space-y-3">
      <a href="#reservas" class="mobile-nav-link lm-btn-gold w-full">
        RESERVAR MESA ONLINE
      </a>
      <a href="tel:<%= restaurant.contact.phoneClean %>" class="lm-btn-outline w-full">
        LLAMAR · <%= restaurant.contact.phone %>
      </a>
      <div class="pt-3 flex items-center justify-between text-[10px] tracking-[0.2em] uppercase text-neutral-500">
        <span>C. Rey Francisco, 28</span>
        <a href="/admin" class="mobile-nav-link text-[#d4af37] hover:underline">ÁREA DIRECCIÓN →</a>
      </div>
    </div>
  </aside>

  <!-- =========================================================================
       2. HERO SECTION MINIMALISTA Y SEÑORIAL (RESPONSIVA EN CUALQUIER PANTALLA)
  ========================================================================= -->
  <section id="inicio" class="lm-hero">
    <img
      src="https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?auto=format&fit=crop&w=2000&q=85"
      alt="Salón señorial del Restaurante La Montaña en C. del Rey Francisco, 28, Madrid"
      class="lm-hero-bg"
    />
    <div class="lm-hero-overlay"></div>

    <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-10 py-16 sm:py-24 lg:py-28 text-center">
      <p class="text-[10px] sm:text-xs tracking-[0.28em] sm:tracking-[0.36em] uppercase text-[#d4af37] font-normal mb-4 sm:mb-6">
        <%= restaurant.subtitle %>
      </p>

      <h1 class="font-serif text-4xl sm:text-6xl md:text-7xl lg:text-[82px] font-normal text-[#f4f1ea] tracking-[0.03em] leading-[1.08] mb-5 sm:mb-6">
        <%= restaurant.name %>
      </h1>

      <div class="lm-divider-ornament">
        <span class="lm-diamond"></span>
      </div>

      <p class="font-serif italic text-lg sm:text-xl md:text-2xl text-[#e5e5e5]/90 max-w-2xl mx-auto font-normal leading-relaxed mt-5 sm:mt-6 mb-4">
        “<%= restaurant.tagline %>”
      </p>

      <p class="text-xs sm:text-sm text-neutral-300 max-w-2xl mx-auto leading-relaxed font-light mb-9 sm:mb-12">
        <%= restaurant.description %>
      </p>

      <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-center gap-3.5 sm:gap-5 max-w-md sm:max-w-none mx-auto">
        <a href="#reservas" class="lm-btn-gold w-full sm:w-auto sm:min-w-[220px]">
          RESERVAR MESA
        </a>
        <a href="#carta" class="lm-btn-outline w-full sm:w-auto sm:min-w-[220px]">
          VER CARTA OFICIAL
        </a>
      </div>

      <!-- Pie Informativo del Hero -->
      <div class="mt-14 sm:mt-20 pt-8 border-t border-white/10 grid grid-cols-1 sm:grid-cols-3 gap-5 sm:gap-6 text-[11px] tracking-[0.18em] sm:tracking-[0.2em] uppercase text-neutral-400">
        <div>
          <span class="text-[#d4af37] block mb-1">DIRECCIÓN</span>
          <span>C. del Rey Francisco, 28 · 28008 Madrid</span>
        </div>
        <div>
          <span class="text-[#d4af37] block mb-1">TELÉFONO DE RESERVAS</span>
          <a href="tel:<%= restaurant.contact.phoneClean %>" class="hover:text-[#f4f1ea] transition-colors inline-block py-0.5"><%= restaurant.contact.phone %></a>
        </div>
        <div>
          <span class="text-[#d4af37] block mb-1">ESPACIOS</span>
          <span>Salón de Azulejos & Cueva de Ladrillo</span>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       3. SECCIÓN DE CARTA OFICIAL Y PRECIOS EXACTOS (PRIMEROS, SEGUNDOS, POSTRES)
  ========================================================================= -->
  <section id="carta" class="py-20 sm:py-28 lg:py-36 bg-[#09090b] border-t border-white/10">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-10">
      <!-- Encabezado Editorial -->
      <div class="text-center max-w-2xl mx-auto mb-12 sm:mb-16">
        <span class="text-[10px] tracking-[0.3em] sm:tracking-[0.36em] uppercase text-[#d4af37] block mb-3">
          TRADICIÓN CULINARIA DESDE 1943 · PRECIOS OFICIALES
        </span>
        <h2 class="font-serif text-3xl sm:text-5xl lg:text-6xl font-normal text-[#f4f1ea] tracking-wide">
          La Carta Oficial
        </h2>
        <div class="lm-divider-ornament">
          <span class="lm-diamond"></span>
        </div>
        <p class="text-xs sm:text-sm text-neutral-300 font-light mt-4">
          Recetario tradicional de cuchara, huerta, pescados frescos de lonja, carnes seleccionadas
          y postres caseros elaborados diariamente en nuestros fogones de la calle del Rey Francisco.
        </p>
      </div>

      <!-- Pestañas Táctiles con Scroll Horizontal Fluido en Móvil -->
      <div class="lm-touch-scroll no-scrollbar flex items-center sm:justify-center gap-1 sm:gap-5 border-b border-white/10 mb-10 sm:mb-14 pb-1 -mx-4 px-4 sm:mx-0 sm:px-0" id="menu-category-tabs">
        <button type="button" data-category="all" class="lm-category-tab active shrink-0">
          CARTA COMPLETA (<%= menuItems.length %>)
        </button>
        <% categories.forEach(function(cat) { %>
          <button type="button" data-category="<%= cat.id %>" class="lm-category-tab shrink-0">
            <%= cat.title.toUpperCase() %> (<%= menuItems.filter(function(m) { return m.category === cat.id; }).length %>)
          </button>
        <% }); %>
      </div>

      <!-- Barra discreta de platos seleccionados para la reserva -->
      <div id="preselected-bar" class="hidden mb-10 px-4 sm:px-6 py-4 bg-[#111115] border border-[#d4af37]/40 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div class="flex flex-wrap items-center gap-2 text-xs">
          <span class="tracking-[0.2em] uppercase text-[#d4af37] text-[10px] mr-2">PLATOS ANOTADOS PARA SU MESA:</span>
          <div id="preselected-chips" class="flex flex-wrap gap-2"></div>
        </div>
        <a href="#reservas" class="lm-btn-outline py-2 px-4 text-[10px] w-full sm:w-auto shrink-0">
          VINCULAR A MI RESERVA →
        </a>
      </div>

      <!-- Pliego de Carta Física de Lujo (Padding adaptable desde 320px hasta 4K) -->
      <div class="lm-menu-paper px-4 sm:px-10 md:px-14 lg:px-20 py-10 sm:py-16 lg:py-20">
        <!-- Membrete de la Carta -->
        <div class="text-center pb-8 sm:pb-12 mb-10 sm:mb-12 border-b border-white/10">
          <span class="font-serif text-xs sm:text-sm tracking-[0.22em] sm:tracking-[0.3em] uppercase text-[#d4af37] block">
            RESTAURANTE LA MONTAÑA · CASA FUNDADA EN 1943
          </span>
          <p class="font-serif italic text-neutral-400 text-sm sm:text-base mt-1">
            Calle del Rey Francisco, 28 · Moncloa - Aravaca · 28008 Madrid
          </p>
        </div>

        <!-- Secciones de la Carta: Primeros, Segundos y Postres -->
        <div class="space-y-14 sm:space-y-16" id="formal-menu-container">
          <% categories.forEach(function(cat) { %>
            <div class="menu-category-section" data-section-category="<%= cat.id %>">
              <div class="mb-6 sm:mb-8 text-center sm:text-left border-b border-[#d4af37]/25 pb-4 flex flex-col sm:flex-row sm:items-baseline justify-between gap-1.5 sm:gap-2">
                <h3 class="font-serif text-2xl sm:text-3xl lg:text-4xl font-normal text-[#f4f1ea] tracking-wide">
                  <%= cat.title %>
                </h3>
                <p class="font-serif italic text-xs sm:text-base text-[#d4af37]/85">
                  <%= cat.subtitle %>
                </p>
              </div>

              <!-- Grid fluido: 1 columna en móvil/tablet vertical, 2 columnas en md/lg+ -->
              <div class="grid grid-cols-1 md:grid-cols-2 gap-x-10 lg:gap-x-12 gap-y-2">
                <% menuItems.filter(function(i) { return i.category === cat.id; }).forEach(function(dish) { %>
                  <div class="lm-menu-row group">
                    <!-- Línea Principal: Nombre del Plato + Línea Punteada + Precio Oficial Exacto -->
                    <div class="flex items-baseline justify-between gap-2">
                      <div class="flex flex-wrap items-baseline gap-2 min-w-0">
                        <h4 class="font-serif text-lg sm:text-xl lg:text-[22px] font-normal text-[#f4f1ea] group-hover:text-[#d4af37] transition-colors leading-snug">
                          <%= dish.name %>
                        </h4>
                        <% if (dish.highlight) { %>
                          <span class="text-[8px] tracking-[0.18em] uppercase px-2 py-0.5 border border-[#d4af37]/35 text-[#d4af37] shrink-0">
                            <%= dish.highlight %>
                          </span>
                        <% } %>
                      </div>

                      <span class="lm-menu-leaderLine" aria-hidden="true"></span>

                      <span class="font-serif text-lg sm:text-xl lg:text-[22px] font-medium text-[#d4af37] whitespace-nowrap shrink-0">
                        <%= dish.priceText || (dish.price !== null ? dish.price.toFixed(2).replace('.', ',') + ' €' : 'Consultar') %>
                      </span>
                    </div>

                    <!-- Segunda Línea: Descripción Corta y Botón Táctil de Preselección -->
                    <div class="mt-2 flex items-center justify-between gap-3">
                      <p class="text-xs text-neutral-300/90 font-light leading-relaxed">
                        <%= dish.description %>
                      </p>
                      <button
                        type="button"
                        data-dish="<%= dish.name %>"
                        class="toggle-dish-btn shrink-0 min-h-[34px] px-2.5 py-1 border border-white/10 hover:border-[#d4af37]/50 text-[9px] tracking-[0.18em] uppercase text-neutral-400 hover:text-[#d4af37] transition-colors"
                      >
                        + Anotar
                      </button>
                    </div>
                  </div>
                <% }); %>
              </div>
            </div>
          <% }); %>
        </div>

        <!-- Pie de la Carta Física -->
        <div class="mt-12 sm:mt-16 pt-6 sm:pt-8 border-t border-white/10 text-center text-[10px] sm:text-[11px] tracking-[0.14em] text-neutral-400 uppercase leading-relaxed">
          Precios oficiales expresados en Euros (IVA incluido) · Consulte a nuestro personal de sala por alérgenos y sugerencias fuera de carta
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       4. SECCIÓN DE HISTORIA, SALONES DE AZULEJOS Y CUEVA DE LADRILLO VISTO
  ========================================================================= -->
  <section id="historia" class="py-20 sm:py-28 lg:py-36 bg-[#0d0d10] border-t border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center mb-16 sm:mb-24">
        <div class="lg:col-span-6 space-y-5 sm:space-y-6">
          <span class="text-[10px] tracking-[0.3em] sm:tracking-[0.36em] uppercase text-[#d4af37] block">
            PATRIMONIO CASTIZO EN MONCLOA - ARAVACA · DESDE 1943
          </span>
          <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-normal text-[#f4f1ea] leading-tight">
            <%= restaurant.heritage.title %>
          </h2>
          <p class="font-serif italic text-lg sm:text-xl text-[#d4af37]/90 leading-relaxed">
            <%= restaurant.heritage.lead %>
          </p>
          <% restaurant.heritage.paragraphs.forEach(function(p) { %>
            <p class="text-xs sm:text-sm text-neutral-300 font-light leading-relaxed">
              <%= p %>
            </p>
          <% }); %>
        </div>

        <div class="lg:col-span-6 grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div class="border border-white/10 bg-[#09090b] p-3">
            <img
              src="https://images.unsplash.com/photo-1559339352-11d035aa65de?auto=format&fit=crop&w=900&q=85"
              alt="Salón Señorial con Azulejería Clásica de Restaurante La Montaña"
              class="w-full h-64 sm:h-80 object-cover opacity-85"
              loading="lazy"
            />
            <p class="font-serif italic text-xs text-neutral-400 text-center pt-3 pb-1">
              Salón Señorial de Planta Calle y Azulejería Clásica
            </p>
          </div>
          <div class="border border-white/10 bg-[#09090b] p-3 sm:mt-10">
            <img
              src="https://images.unsplash.com/photo-1510812431401-41d2bd2722f3?auto=format&fit=crop&w=900&q=85"
              alt="Bóveda Histórica de Ladrillo Visto en Restaurante La Montaña"
              class="w-full h-64 sm:h-80 object-cover opacity-85"
              loading="lazy"
            />
            <p class="font-serif italic text-xs text-neutral-400 text-center pt-3 pb-1">
              Cueva Histórica Abovedada de Ladrillo Visto (1943)
            </p>
          </div>
        </div>
      </div>

      <!-- Los Tres Espacios del Local (Adaptable: 1 col móvil, 2 col tablet, 3 col escritorio) -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8 pt-12 border-t border-white/10">
        <% restaurant.diningAreas.forEach(function(area, idx) { %>
          <div class="bg-[#09090b] border border-white/10 hover:border-[#d4af37]/40 p-6 sm:p-8 lg:p-10 transition-colors flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between text-[10px] tracking-[0.24em] uppercase text-[#d4af37] mb-4">
                <span>AMBIENTE 0<%= idx + 1 %></span>
                <span><%= area.capacity %></span>
              </div>
              <h3 class="font-serif text-2xl sm:text-3xl font-normal text-[#f4f1ea] mb-3">
                <%= area.name %>
              </h3>
              <p class="text-xs sm:text-sm text-neutral-300 font-light leading-relaxed">
                <%= area.description %>
              </p>
            </div>
            <div class="mt-8 pt-5 border-t border-white/5">
              <a
                href="#reservas"
                data-select-area="<%= area.id %>"
                class="select-area-link inline-flex items-center gap-2 py-2 text-[10px] tracking-[0.24em] uppercase text-[#e5e5e5] hover:text-[#d4af37] transition-colors"
              >
                <span>RESERVAR EN ESTE SALÓN</span>
                <span>→</span>
              </a>
            </div>
          </div>
        <% }); %>
      </div>

      <!-- Reseñas y Críticas Destacadas -->
      <div class="mt-16 sm:mt-20 grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-10 pt-12 sm:pt-14 border-t border-white/10">
        <% restaurant.ratings.quotes.forEach(function(q) { %>
          <blockquote class="bg-[#09090b] border border-white/10 p-6 sm:p-8 lg:p-10">
            <p class="font-serif italic text-lg sm:text-xl lg:text-2xl text-[#f4f1ea] leading-relaxed mb-5 sm:mb-6">
              “<%= q.quote %>”
            </p>
            <footer class="text-[11px] tracking-[0.2em] uppercase text-[#d4af37]">
              — <%= q.author %> <span class="text-neutral-500">· <%= q.publication %></span>
            </footer>
          </blockquote>
        <% }); %>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       5. SISTEMA DE RESERVAS DE MESA FORMAL Y CONECTADO AL BACKEND (TÁCTIL)
  ========================================================================= -->
  <section id="reservas" class="py-20 sm:py-28 lg:py-36 bg-[#09090b] border-t border-white/10">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-10">
      <div class="text-center max-w-2xl mx-auto mb-12 sm:mb-16">
        <span class="text-[10px] tracking-[0.3em] sm:tracking-[0.36em] uppercase text-[#d4af37] block mb-3">
          RESERVA DE MESA ONLINE E INMEDIATA
        </span>
        <h2 class="font-serif text-3xl sm:text-5xl lg:text-6xl font-normal text-[#f4f1ea]">
          Reservar Mesa
        </h2>
        <div class="lm-divider-ornament">
          <span class="lm-diamond"></span>
        </div>
        <p class="text-xs sm:text-sm text-neutral-300 font-light mt-4">
          Reserve su mesa en nuestro Salón Señorial de Azulejería o en la Cueva Abovedada de Ladrillo.
          Para grupos o consultas directas, llámenos al
          <a href="tel:<%= restaurant.contact.phoneClean %>" class="text-[#d4af37] hover:underline"><%= restaurant.contact.phone %></a>.
        </p>
      </div>

      <div class="bg-[#111115] border border-white/10 p-5 sm:p-10 lg:p-14 shadow-2xl">
        <!-- Vista de Confirmación de Reserva -->
        <div id="reservation-success-box" class="hidden py-8 sm:py-10 text-center space-y-6">
          <div class="w-14 h-14 border border-[#d4af37] text-[#d4af37] flex items-center justify-center mx-auto font-serif text-2xl">
            L.M
          </div>
          <div>
            <span class="text-[10px] tracking-[0.3em] uppercase text-[#d4af37] block">
              CONFIRMACIÓN OFICIAL DE SALA
            </span>
            <h3 class="font-serif text-2xl sm:text-4xl font-normal text-[#f4f1ea] mt-2">
              Su mesa ha quedado registrada
            </h3>
          </div>

          <div class="inline-block bg-[#09090b] border border-[#d4af37]/50 px-6 sm:px-10 py-5 max-w-full">
            <span class="text-[9px] tracking-[0.3em] uppercase text-neutral-400 block mb-1">
              CÓDIGO DE RESERVA
            </span>
            <span id="res-confirm-code" class="font-serif text-2xl sm:text-3xl text-[#d4af37] tracking-[0.15em]">
              LM-2026-0000
            </span>
          </div>

          <div id="res-confirm-details" class="max-w-lg mx-auto bg-[#09090b] border border-white/10 p-4 sm:p-6 text-left text-xs space-y-2.5 text-neutral-300"></div>

          <div class="pt-4">
            <button id="new-reservation-btn" type="button" class="lm-btn-outline w-full sm:w-auto">
              REALIZAR UNA NUEVA RESERVA
            </button>
          </div>
        </div>

        <!-- Formulario de Reserva (Optimizado para iOS y Android sin zoom involuntario) -->
        <form id="reservation-form" class="space-y-6 sm:space-y-8" novalidate>
          <div id="reservation-error-alert" class="hidden p-4 bg-red-950/50 border border-red-500/40 text-red-200 text-xs tracking-wide"></div>

          <!-- Fila 1: Fecha, Hora y Comensales -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-5 sm:gap-6">
            <div>
              <label for="res-date" class="lm-label">Fecha *</label>
              <input id="res-date" name="date" type="date" required class="lm-input" />
            </div>

            <div>
              <label for="res-time" class="lm-label">Hora *</label>
              <select id="res-time" name="time" required class="lm-input">
                <optgroup label="Turno de Comidas">
                  <% timeSlots.lunch.forEach(function(t) { %>
                    <option value="<%= t %>" <%= t === '14:00' ? 'selected' : '' %>><%= t %> h</option>
                  <% }); %>
                </optgroup>
                <optgroup label="Turno de Cenas">
                  <% timeSlots.dinner.forEach(function(t) { %>
                    <option value="<%= t %>"><%= t %> h</option>
                  <% }); %>
                </optgroup>
              </select>
            </div>

            <div>
              <label for="res-guests" class="lm-label">Comensales *</label>
              <select id="res-guests" name="guests" required class="lm-input">
                <% [1, 2, 3, 4, 5, 6, 7, 8, 10, 12].forEach(function(n) { %>
                  <option value="<%= n %>" <%= n === 2 ? 'selected' : '' %>>
                    <%= n %> <%= n === 1 ? 'Comensal' : 'Comensales' %>
                  </option>
                <% }); %>
              </select>
            </div>
          </div>

          <!-- Estado de Disponibilidad en Tiempo Real -->
          <div class="px-4 sm:px-5 py-3.5 bg-[#09090b] border border-white/10 flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-xs text-neutral-300">
            <span id="availability-text">Consultando disponibilidad de sala...</span>
            <span class="text-[10px] tracking-[0.2em] uppercase text-[#d4af37]">CONFIRMACIÓN INMEDIATA</span>
          </div>

          <!-- Fila 2: Salón Preferido, Nombre, Teléfono y Correo -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 sm:gap-6">
            <div>
              <label for="res-area" class="lm-label">Salón Preferido *</label>
              <select id="res-area" name="diningArea" class="lm-input">
                <% restaurant.diningAreas.forEach(function(a) { %>
                  <option value="<%= a.id %>"><%= a.name %></option>
                <% }); %>
              </select>
            </div>

            <div>
              <label for="res-name" class="lm-label">Nombre y Apellidos *</label>
              <input
                id="res-name"
                name="name"
                type="text"
                required
                autocomplete="name"
                placeholder="Nombre completo"
                class="lm-input"
              />
            </div>

            <div>
              <label for="res-phone" class="lm-label">Teléfono de Contacto *</label>
              <input
                id="res-phone"
                name="phone"
                type="tel"
                inputmode="tel"
                required
                autocomplete="tel"
                placeholder="+34 600 000 000"
                class="lm-input"
              />
            </div>

            <div>
              <label for="res-email" class="lm-label">Correo Electrónico *</label>
              <input
                id="res-email"
                name="email"
                type="email"
                inputmode="email"
                required
                autocomplete="email"
                placeholder="correo@ejemplo.es"
                class="lm-input"
              />
            </div>
          </div>

          <!-- Observaciones / Alergias -->
          <div>
            <label for="res-notes" class="lm-label">Alergias, Intolerancias o Peticiones de Sala</label>
            <textarea
              id="res-notes"
              name="notes"
              rows="3"
              placeholder="Indíquenos si algún comensal presenta alergias alimentarias o si desea reservar algún plato de cuchara (Verdinas con Carabineros, Fabada...)."
              class="lm-input"
            ></textarea>
          </div>

          <!-- Aceptación RGPD con Checkbox Táctil Cómodo -->
          <div class="flex items-start gap-3.5 text-xs text-neutral-300">
            <input
              id="res-privacy"
              type="checkbox"
              checked
              required
              class="mt-0.5 w-5 h-5 shrink-0 accent-[#d4af37] cursor-pointer"
            />
            <label for="res-privacy" class="leading-relaxed cursor-pointer">
              He leído y acepto la <button type="button" data-open-legal="privacidad" class="text-[#d4af37] underline hover:text-[#f4f1ea]">Política de Privacidad</button> y las condiciones de reserva de <%= restaurant.legalName %>.
            </label>
          </div>

          <button id="res-submit-btn" type="submit" class="lm-btn-gold w-full py-4">
            <span id="res-submit-spinner" class="hidden lm-spinner"></span>
            <span id="res-submit-text">CONFIRMAR RESERVA DE MESA</span>
          </button>
        </form>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       6. HORARIOS, UBICACIÓN Y CONTACTO
  ========================================================================= -->
  <section id="contacto" class="py-20 sm:py-28 lg:py-36 bg-[#0d0d10] border-t border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-10">
      <div class="text-center max-w-2xl mx-auto mb-12 sm:mb-16">
        <span class="text-[10px] tracking-[0.3em] sm:tracking-[0.36em] uppercase text-[#d4af37] block mb-3">
          ENCUÉNTRENOS EN MONCLOA - ARAVACA
        </span>
        <h2 class="font-serif text-3xl sm:text-5xl lg:text-6xl font-normal text-[#f4f1ea]">
          Horarios & Ubicación
        </h2>
        <div class="lm-divider-ornament">
          <span class="lm-diamond"></span>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-stretch">
        <!-- Panel Informativo -->
        <div class="lg:col-span-5 bg-[#09090b] border border-white/10 p-6 sm:p-10 lg:p-12 flex flex-col justify-between space-y-8 sm:space-y-10">
          <div class="space-y-8">
            <div>
              <span class="text-[10px] tracking-[0.28em] uppercase text-[#d4af37] block mb-2">
                DIRECCIÓN OFICIAL
              </span>
              <h3 class="font-serif text-2xl sm:text-3xl font-normal text-[#f4f1ea]">
                <%= restaurant.address.street %>
              </h3>
              <p class="text-xs sm:text-sm text-neutral-400 mt-1">
                <%= restaurant.address.postalCode %> <%= restaurant.address.city %> · <%= restaurant.address.district %> (<%= restaurant.address.neighborhood %>)
              </p>
            </div>

            <div>
              <span class="text-[10px] tracking-[0.28em] uppercase text-[#d4af37] block mb-4">
                HORARIO DE SALA Y COCINA
              </span>
              <div class="divide-y divide-white/10 border-y border-white/10 text-xs">
                <% restaurant.hours.forEach(function(h) { %>
                  <div class="py-3 flex items-center justify-between gap-4">
                    <span class="text-[#e5e5e5] font-normal"><%= h.day %></span>
                    <span class="<%= h.status === 'open' ? 'text-[#d4af37]' : 'text-neutral-500 italic' %>">
                      <%= h.schedule %>
                    </span>
                  </div>
                <% }); %>
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div>
                <span class="text-[10px] tracking-[0.26em] uppercase text-neutral-500 block mb-1">
                  TELÉFONO DE RESERVAS
                </span>
                <a href="tel:<%= restaurant.contact.phoneClean %>" class="font-serif text-2xl text-[#d4af37] hover:text-[#f4f1ea] transition-colors">
                  <%= restaurant.contact.phone %>
                </a>
              </div>
              <div>
                <span class="text-[10px] tracking-[0.26em] uppercase text-neutral-500 block mb-1">
                  CORREO ELECTRÓNICO
                </span>
                <a href="mailto:<%= restaurant.contact.email %>" class="text-xs text-[#e5e5e5] hover:text-[#d4af37] transition-colors break-all">
                  <%= restaurant.contact.email %>
                </a>
              </div>
            </div>

            <div class="space-y-2.5 pt-2">
              <% restaurant.address.accessDetails.forEach(function(acc) { %>
                <div class="text-xs text-neutral-400">
                  <strong class="text-[#e5e5e5] font-normal"><%= acc.label %>:</strong> <%= acc.detail %>
                </div>
              <% }); %>
            </div>
          </div>

          <a
            href="<%= restaurant.address.googleMapsUrl %>"
            target="_blank"
            rel="noopener noreferrer"
            class="lm-btn-outline w-full text-center"
          >
            CÓMO LLEGAR EN GOOGLE MAPS ↗
          </a>
        </div>

        <!-- Mapa Integrado -->
        <div class="lg:col-span-7 border border-white/10 bg-[#09090b] min-h-[480px] overflow-hidden">
          <iframe
            title="Ubicación exacta del Restaurante La Montaña en C. del Rey Francisco, 28, Moncloa - Aravaca, 28008 Madrid"
            src="<%= restaurant.address.googleMapsEmbedUrl %>"
            class="w-full h-full min-h-[480px] border-0 lm-map-frame"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       7. PIE DE PÁGINA CORPORATIVO Y CUMPLIMIENTO LEGAL ESPAÑOL
  ========================================================================= -->
  <footer class="bg-[#070709] border-t border-white/10 pt-16 pb-12 text-xs text-neutral-500">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-10 pb-12 border-b border-white/10">
        <!-- Columna Marca -->
        <div class="md:col-span-5 space-y-4">
          <div class="flex items-center gap-3.5">
            <span class="lm-monogram-seal"><%= restaurant.monogram %></span>
            <div>
              <span class="font-serif text-xl uppercase tracking-[0.16em] text-[#f4f1ea] block">
                <%= restaurant.name %>
              </span>
              <span class="text-[9px] tracking-[0.28em] uppercase text-[#d4af37]">
                CASA FUNDADA EN <%= restaurant.foundedYear %>
              </span>
            </div>
          </div>
          <p class="text-xs text-neutral-400 max-w-sm leading-relaxed font-light">
            <%= restaurant.legalName %> · CIF <%= restaurant.cif %><br />
            <%= restaurant.address.fullAddress %><br />
            Teléfono de reservas: <%= restaurant.contact.phone %>
          </p>
        </div>

        <!-- Columna Secciones -->
        <div class="md:col-span-3 space-y-2.5">
          <span class="text-[10px] tracking-[0.26em] uppercase text-[#d4af37] block mb-3">
            NAVEGACIÓN
          </span>
          <ul class="space-y-2 text-[11px] tracking-[0.16em] uppercase">
            <li><a href="#inicio" class="hover:text-[#f4f1ea] transition-colors">Inicio</a></li>
            <li><a href="#carta" class="hover:text-[#f4f1ea] transition-colors">La Carta</a></li>
            <li><a href="#historia" class="hover:text-[#f4f1ea] transition-colors">Historia (1943)</a></li>
            <li><a href="#reservas" class="hover:text-[#f4f1ea] transition-colors">Reservas</a></li>
            <li><a href="#contacto" class="hover:text-[#f4f1ea] transition-colors">Contacto</a></li>
            <li><a href="/admin" class="hover:text-[#d4af37] transition-colors">Panel Administración (/admin)</a></li>
          </ul>
        </div>

        <!-- Columna Marco Normativo Español -->
        <div class="md:col-span-4 space-y-2.5">
          <span class="text-[10px] tracking-[0.26em] uppercase text-[#d4af37] block mb-3">
            CUMPLIMIENTO LEGAL
          </span>
          <ul class="space-y-2 text-xs">
            <li>
              <button type="button" data-open-legal="aviso-legal" class="hover:text-[#f4f1ea] transition-colors text-left">
                Aviso Legal (LSSI-CE)
              </button>
            </li>
            <li>
              <button type="button" data-open-legal="privacidad" class="hover:text-[#f4f1ea] transition-colors text-left">
                Política de Privacidad (RGPD / LOPDGDD)
              </button>
            </li>
            <li>
              <button type="button" data-open-legal="cookies" class="hover:text-[#f4f1ea] transition-colors text-left">
                Política de Cookies (Guía AEPD)
              </button>
            </li>
            <li>
              <button type="button" id="reopen-cookie-banner-btn" class="text-[#d4af37] hover:underline text-left">
                Configurar Preferencias de Cookies
              </button>
            </li>
          </ul>
        </div>
      </div>

      <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-[11px] text-neutral-500">
        <p>© <%= new Date().getFullYear() %> <%= restaurant.legalName %> Todos los derechos reservados.</p>
        <p class="tracking-[0.14em] uppercase">C. del Rey Francisco, 28 · Moncloa - Aravaca · 28008 Madrid</p>
      </div>
    </div>
  </footer>

  <!-- =========================================================================
       BANNER INTERACTIVO DE POLÍTICA DE COOKIES (LEGISLACIÓN ESPAÑOLA)
  ========================================================================= -->
  <div
    id="cookie-consent-banner"
    class="hidden fixed bottom-0 left-0 right-0 z-50 bg-[#0e0e12]/95 backdrop-blur-xl border-t border-[#d4af37]/35 px-6 py-5 shadow-2xl"
    role="dialog"
    aria-label="Aviso de privacidad y cookies"
  >
    <div class="max-w-7xl mx-auto flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6">
      <div class="space-y-1 max-w-3xl">
        <span class="text-[10px] tracking-[0.28em] uppercase text-[#d4af37] block">
          POLÍTICA DE COOKIES Y PRIVACIDAD
        </span>
        <p class="text-xs text-neutral-300 font-light leading-relaxed">
          En <strong><%= restaurant.name %></strong> utilizamos cookies propias técnicas necesarias para el sistema de reservas y, con su consentimiento, cookies analíticas de terceros. Puede aceptar todas las cookies, rechazar las opcionales o consultar nuestra
          <button type="button" data-open-legal="cookies" class="text-[#d4af37] underline">Política de Cookies</button> y
          <button type="button" data-open-legal="privacidad" class="text-[#d4af37] underline">Política de Privacidad</button>.
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-3 shrink-0">
        <button id="cookie-reject-btn" type="button" class="lm-btn-outline py-2.5 px-5 text-[10px]">
          SOLO NECESARIAS
        </button>
        <button id="cookie-accept-btn" type="button" class="lm-btn-gold py-2.5 px-6 text-[10px]">
          ACEPTAR COOKIES
        </button>
      </div>
    </div>
  </div>

  <!-- =========================================================================
       MODAL JURÍDICO (AVISO LEGAL, PRIVACIDAD Y COOKIES)
  ========================================================================= -->
  <div
    id="legal-modal-backdrop"
    class="hidden fixed inset-0 z-50 bg-black/85 backdrop-blur-sm flex items-center justify-center p-4 sm:p-6"
    role="dialog"
    aria-modal="true"
  >
    <div class="bg-[#111115] border border-white/15 max-w-3xl w-full max-h-[85vh] flex flex-col shadow-2xl">
      <div class="px-8 py-6 border-b border-white/10 flex items-center justify-between">
        <div>
          <span class="text-[9px] tracking-[0.3em] uppercase text-[#d4af37] block">
            CUMPLIMIENTO NORMATIVO · <%= restaurant.legalName %>
          </span>
          <h3 id="legal-modal-title" class="font-serif text-2xl sm:text-3xl text-[#f4f1ea] mt-1">
            Aviso Legal
          </h3>
        </div>
        <button id="close-legal-modal-btn" type="button" class="text-neutral-400 hover:text-[#f4f1ea] text-sm tracking-widest uppercase">
          CERRAR ✕
        </button>
      </div>
      <div id="legal-modal-body" class="p-8 overflow-y-auto text-xs sm:text-sm text-neutral-300 space-y-4 leading-relaxed font-light"></div>
    </div>
  </div>

  <!-- Controlador Frontend -->
  <script src="/js/main.js"></script>
</body>
</html>
