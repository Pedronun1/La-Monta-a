<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <%
    const rest = (typeof restaurant !== 'undefined' && restaurant) ? restaurant : {
      name: 'La Montaña',
      address: 'C. del Rey Francisco, 28, Moncloa - Aravaca, 28008 Madrid',
      phone: '915 47 10 53',
      phoneClean: '+34915471053',
      Schedule: 'Martes a Sábado: 13:30 – 16:30 y 20:30 – 23:30 · Domingo: 13:30 – 16:30 · Lunes cerrado'
    };

    const fmtPrice = (typeof formatPrice === 'function')
      ? formatPrice
      : (p) => Number(p).toFixed(2).replace('.', ',') + ' €';

    const fallbackCarta = {
      primeros: [
        { id: 1, name: 'Sopa Castellana de la Casa con Huevo Escalfado', description: 'Caldo tradicional de jamón ibérico, pan candeal tostado, ajo morado de Las Pedroñeras y pimentón de la Vera.', price: 14.50 },
        { id: 2, name: 'Jamón Ibérico de Bellota 100% Cortado a Cuchillo', description: 'Selección de dehesa extremeña con curación mínima de 36 meses, acompañado de picos artesanos.', price: 28.00 },
        { id: 3, name: 'Croquetas Cremosas de Jamón Ibérico (8 uds.)', description: 'Bechamel reposada de leche fresca de caserío con virutas de jamón de bellota y rebozado crujiente.', price: 15.00 },
        { id: 4, name: 'Alcachofas de Tudela Confitadas con Velouté y Crujiente de Jamón', description: 'Corazones tiernos confitados a baja temperatura en aceite de oliva virgen extra.', price: 18.50 },
        { id: 5, name: 'Pulpo a la Brasa sobre Parmentier Trufado', description: 'Pata de pulpo del Cantábrico marcada al carbón de encina con crema fina de patata y pimentón.', price: 24.50 },
        { id: 6, name: 'Puerros Asados al Carbón con Vinagreta de Avellanas y Trufa', description: 'Puerros tiernos de huerta asados lentamente a la brasa con emulsión templada de frutos secos.', price: 17.00 },
        { id: 7, name: 'Gambas Blancas de Huelva al Ajillo en Cazuela de Barro', description: 'Gamba blanca fresca salteada al momento en aceite de oliva virgen extra con láminas de ajo y guindilla.', price: 23.00 },
        { id: 8, name: 'Zamburiñas Gallegas Gratinadas al Horno (6 uds.)', description: 'Asadas en su propia concha con majado suave de ajo, perejil fresco y vino albariño.', price: 21.00 },
        { id: 9, name: 'Judiones de La Granja Estofados con Almejas de Carril', description: 'Guiso reposado a fuego lento con almeja fina gallega y sofrito tradicional.', price: 19.50 },
        { id: 10, name: 'Huevos Rotos de Corral con Foie Fresco a la Plancha', description: 'Patata agria confitada, huevos camperos y escalope de foie micuit caramelizado.', price: 22.00 }
      ],
      segundos: [
        { id: 11, name: 'Cocido Madrileño Completo en Tres Vuelcos', description: 'Sopa de fideos finos, garbanzos de Fuentesaúco con verdura de temporada y bandeja de carnes selectas.', price: 29.50 },
        { id: 12, name: 'Rabo de Toro Estofado al Vino Tinto Reserva', description: 'Guiso tradicional cordobés deshuesado y glaseado en su propio jugo durante seis horas.', price: 26.50 },
        { id: 13, name: 'Callos a la Madrileña con Pata, Morro y Chorizo Asturiano', description: 'Receta histórica de la casa de 1943 con gelatina natural y un toque sutilmente picante.', price: 22.50 },
        { id: 14, name: 'Solomillo de Vaca Vieja a la Brasa con Foie y Reducción de Oporto', description: 'Centro de solomillo madurado a la parrilla de carbón, coronado con foie fresco.', price: 31.00 },
        { id: 15, name: 'Chuletón de Vaca Rubia Gallega Madurado 45 Días (por kg)', description: 'Trinchado en mesa sobre plato refractario con pimientos de Padrón y patatas panadera.', price: 68.00 },
        { id: 16, name: 'Cochinillo Asado al Estilo Segoviano en Horno de Leña', description: 'Cuarto de cochinillo de piel crujiente y carne melosa asado lentamente.', price: 29.00 },
        { id: 17, name: 'Paletilla de Cordero Lechal Asada a Baja Temperatura', description: 'Cordero lechal de Castilla asado en su jugo con patatas panadera y ensalada verde.', price: 32.00 },
        { id: 18, name: 'Merluza de Pincho del Cantábrico a la Romana o en Salsa Verde', description: 'Lomo central de merluza de anzuelo con almejas finas, espárragos blancos y huevo duro.', price: 27.50 },
        { id: 19, name: 'Bacalao Confitado al Pil-Pil Tradicional', description: 'Lomo de bacalao Gadus Morhua ligado a mano en emulsión sedosa de aceite y ajos.', price: 26.50 },
        { id: 20, name: 'Pixín (Rape Negro) Asado al Horno con Refrito de Ajos y Guindilla', description: 'Medallones de rape del Cantábrico asados con bilbaína tradicional de vinagre de Jerez.', price: 29.50 }
      ],
      postres: [
        { id: 21, name: 'Torrija Caramelizada de Brioche en Leche Infusionada', description: 'Pan brioche artesano empapado en crema inglesa de canela y cítricos, acompañado de helado de vainilla Bourbon.', price: 9.50 },
        { id: 22, name: 'Tarta Cremosa de Queso Idiazábal al Horno', description: 'Elaborada a diario con corazón fundente de quesos artesanos y coulis de frutos rojos.', price: 9.50 },
        { id: 23, name: 'Milhojas Crujiente de Crema Pastelera y Nata Montada', description: 'Hojaldre inverso caramelizado al momento con crema de vainilla de Madagascar.', price: 9.00 },
        { id: 24, name: 'Arroz con Leche Cremosísimo Requemaíllo al Estilo Asturiano', description: 'Cocinado lentamente durante tres horas con corteza de limón y azúcar quemado al hierro.', price: 8.50 },
        { id: 25, name: 'Filloas Rellenas de Crema Templada de Manzana Reineta', description: 'Finas crepes tradicionales flambeadas al orujo gallego.', price: 9.00 },
        { id: 26, name: 'Tabla de Quesos Artesanos Españoles con Membrillo Casero', description: 'Selección afinada de Manchego curado, Cabrales de cueva, Torta del Casar e Idiazábal.', price: 16.50 }
      ]
    };

    const primerosList = (typeof carta !== 'undefined' && carta && Array.isArray(carta.primeros) && carta.primeros.length)
      ? carta.primeros
      : fallbackCarta.primeros;

    const segundosList = (typeof carta !== 'undefined' && carta && Array.isArray(carta.segundos) && carta.segundos.length)
      ? carta.segundos
      : fallbackCarta.segundos;

    const postresList = (typeof carta !== 'undefined' && carta && Array.isArray(carta.postres) && carta.postres.length)
      ? carta.postres
      : fallbackCarta.postres;

    const slots = (typeof timeSlots !== 'undefined' && Array.isArray(timeSlots) && timeSlots.length)
      ? timeSlots
      : ['13:30', '14:00', '14:30', '15:00', '15:30', '20:30', '21:00', '21:30', '22:00', '22:30'];
  %>

  <title>La Montaña | Alta Cocina Tradicional Castiza en Madrid desde 1943</title>
  <meta name="description" content="Restaurante La Montaña en C. del Rey Francisco, 28, Moncloa - Aravaca, Madrid. Alta cocina tradicional castiza desde 1943 en salones históricos de azulejos y bóveda de ladrillo visto." />

  <!-- Google Fonts: Cormorant Garamond (Serif) & Plus Jakarta Sans (Sans-Serif) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400&family=Plus+Jakarta+Sans:wght@200;300;400;500&display=swap" rel="stylesheet" />

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            obsidian: '#050506',
            ivory: '#f4f4f5',
            champagne: '#d4af37'
          },
          fontFamily: {
            serif: ['"Cormorant Garamond"', 'Georgia', 'serif'],
            sans: ['"Plus Jakarta Sans"', 'system-ui', 'sans-serif']
          }
        }
      }
    };
  </script>

  <style>
    body {
      background-color: #050506;
      color: #f4f4f5;
      font-family: 'Plus Jakarta Sans', sans-serif;
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
    }

    ::selection {
      background: rgba(212, 175, 55, 0.2);
      color: #f4f4f5;
    }

    /* Custom subtle scrollbar */
    ::-webkit-scrollbar {
      width: 5px;
    }
    ::-webkit-scrollbar-track {
      background: #050506;
    }
    ::-webkit-scrollbar-thumb {
      background: rgba(212, 175, 55, 0.25);
    }

    /* Progressive scroll reveal containers */
    .scroll-reveal {
      opacity: 0;
      transform: translateY(2.25rem);
    }
    .scroll-reveal.is-visible {
      opacity: 1;
      transform: translateY(0);
    }

    /* Dark native date & select controls */
    input[type="date"]::-webkit-calendar-picker-indicator {
      filter: invert(0.85) sepia(0.3) saturate(1.5) hue-rotate(10deg);
      cursor: pointer;
    }
  </style>
</head>

<body class="bg-[#050506] text-[#f4f4f5] selection:bg-[#d4af37]/20 selection:text-[#f4f4f5]">

  <!-- ===================================================================== -->
  <!-- 1. CABECERA (NAVBAR) FLOTANTE E IMPECABLE                             -->
  <!-- ===================================================================== -->
  <header class="fixed top-0 left-0 right-0 z-50 backdrop-blur-xl bg-[#050506]/90 border-b border-white/10 transition-all duration-500">
    <nav class="max-w-7xl mx-auto px-6 sm:px-10 lg:px-16 h-24 flex items-center justify-between" aria-label="Navegación principal">
      
      <!-- Izquierda: Monograma tipográfico muy fino "L.M" y "LA MONTAÑA" -->
      <a href="#" class="flex items-center gap-4 group focus:outline-none">
        <span class="font-serif text-xs sm:text-sm font-light tracking-[0.35em] text-[#d4af37] border border-white/10 px-2.5 py-1.5 transition-colors duration-500 group-hover:border-[#d4af37]/50">
          L.M
        </span>
        <span class="font-serif text-lg sm:text-xl font-light tracking-[0.32em] text-[#f4f4f5] uppercase">
          LA MONTAÑA
        </span>
      </a>

      <!-- Centro: Únicamente tres enlaces esenciales en mayúsculas y tipografía ligera -->
      <div class="hidden md:flex items-center gap-12 lg:gap-16">
        <a href="#carta" class="text-[11px] font-light uppercase tracking-[0.3em] text-[#f4f4f5]/75 hover:text-[#d4af37] transition-colors duration-300">
          CARTA
        </a>
        <a href="#la-casa" class="text-[11px] font-light uppercase tracking-[0.3em] text-[#f4f4f5]/75 hover:text-[#d4af37] transition-colors duration-300">
          LA CASA
        </a>
        <a href="#reservas" class="text-[11px] font-light uppercase tracking-[0.3em] text-[#f4f4f5]/75 hover:text-[#d4af37] transition-colors duration-300">
          RESERVAS
        </a>
      </div>

      <!-- Derecha: Un único botón de reserva minimalista (borde fino #d4af37, fondo transparente) -->
      <div class="flex items-center gap-4">
        <a href="#reservas" class="inline-flex items-center justify-center px-6 py-2.5 bg-transparent border border-[#d4af37] text-[#f4f4f5] hover:text-[#d4af37] hover:border-[#d4af37]/80 text-[10px] sm:text-[11px] font-light uppercase tracking-[0.28em] transition-all duration-500">
          Reservar Mesa
        </a>

        <!-- Botón Menú Móvil Minimalista (Solo visible en móvil) -->
        <button id="mobile-menu-btn" type="button" aria-label="Abrir menú" aria-expanded="false" class="md:hidden p-2 text-[#f4f4f5]/80 hover:text-[#d4af37] transition-colors focus:outline-none">
          <svg id="menu-icon-open" class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 8h16M4 16h16" />
          </svg>
          <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" stroke-width="1.2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </nav>

    <!-- Desplegable Móvil Ultra Minimalista (Únicamente los 3 enlaces) -->
    <div id="mobile-menu" class="hidden md:hidden bg-[#050506]/95 backdrop-blur-xl border-b border-white/10 px-6 py-10">
      <div class="flex flex-col items-center gap-8">
        <a href="#carta" class="mobile-nav-link text-xs font-light uppercase tracking-[0.35em] text-[#f4f4f5]/80 hover:text-[#d4af37] transition-colors">
          CARTA
        </a>
        <a href="#la-casa" class="mobile-nav-link text-xs font-light uppercase tracking-[0.35em] text-[#f4f4f5]/80 hover:text-[#d4af37] transition-colors">
          LA CASA
        </a>
        <a href="#reservas" class="mobile-nav-link text-xs font-light uppercase tracking-[0.35em] text-[#f4f4f5]/80 hover:text-[#d4af37] transition-colors">
          RESERVAS
        </a>
      </div>
    </div>
  </header>

  <main>
    <!-- =================================================================== -->
    <!-- 2. HERO SECTION CINEMÁTICA E INMERSIVA                              -->
    <!-- =================================================================== -->
    <section class="relative min-h-screen flex items-center justify-center overflow-hidden pt-24">
      <!-- Imagen de fondo oscura con degradado sutil -->
      <div class="absolute inset-0 z-0">
        <img
          src="https://images.unsplash.com/photo-1544025162-d76694265947?auto=format&fit=crop&w=2000&q=85"
          alt="Salón histórico de alta gastronomía en La Montaña Madrid"
          class="w-full h-full object-cover object-center opacity-35 scale-105 transition-transform duration-1000 ease-out"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-[#050506] via-[#050506]/80 to-transparent"></div>
        <div class="absolute inset-0 bg-[#050506]/45"></div>
      </div>

      <!-- Contenido Central Hero -->
      <div class="relative z-10 max-w-5xl mx-auto px-6 sm:px-10 text-center py-24 md:py-32 scroll-reveal transition-all duration-1000 ease-out">
        <p class="text-[10px] sm:text-xs font-light uppercase tracking-[0.45em] text-[#d4af37] mb-8">
          Madrid · Fundado en 1943 · Moncloa - Aravaca
        </p>

        <h1 class="font-serif text-5xl sm:text-7xl md:text-8xl lg:text-[6.25rem] font-light tracking-[0.04em] text-[#f4f4f5] leading-[1.06] mb-8">
          El Arte de la Mesa<br />
          <span class="italic font-normal text-[#d4af37]/90">Castiza y Señorial</span>
        </h1>

        <p class="max-w-2xl mx-auto text-sm sm:text-base font-light text-[#f4f4f5]/70 tracking-[0.08em] leading-relaxed mb-14">
          Ochenta años custodiando el recetario clásico madrileño y cántabro entre salones de azulejería histórica y bóvedas subterráneas de ladrillo visto.
        </p>

        <!-- Dos botones de llamada a la acción sobrios y sofisticados -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-5 sm:gap-8">
          <a href="#reservas" class="w-full sm:w-auto px-10 py-4 border border-[#d4af37] bg-transparent text-[#f4f4f5] hover:bg-[#d4af37]/10 text-[11px] font-light uppercase tracking-[0.32em] transition-all duration-500">
            Reservar Mesa
          </a>
          <a href="#carta" class="w-full sm:w-auto px-10 py-4 border border-white/10 bg-transparent text-[#f4f4f5]/80 hover:border-white/30 hover:text-[#f4f4f5] text-[11px] font-light uppercase tracking-[0.32em] transition-all duration-500">
            Explorar la Carta
          </a>
        </div>
      </div>
    </section>

    <!-- =================================================================== -->
    <!-- 3. CARTA DE ALTA COCINA Y PRECIOS                                   -->
    <!-- =================================================================== -->
    <section id="carta" class="py-32 md:py-44 px-6 sm:px-10 lg:px-16 max-w-6xl mx-auto border-t border-white/10">
      
      <!-- Encabezado de Carta -->
      <div class="text-center max-w-3xl mx-auto mb-20 md:mb-28 scroll-reveal transition-all duration-1000 ease-out">
        <span class="block text-[10px] sm:text-xs font-light uppercase tracking-[0.42em] text-[#d4af37] mb-5">
          Propuesta Gastronómica
        </span>
        <h2 class="font-serif text-4xl sm:text-6xl font-light tracking-[0.05em] text-[#f4f4f5] mb-6">
          Carta de Temporada
        </h2>
        <div class="w-16 h-px bg-[#d4af37]/40 mx-auto mb-6"></div>
        <p class="text-xs sm:text-sm font-light text-[#f4f4f5]/60 tracking-[0.08em] leading-relaxed">
          Producto de lonja, dehesa y huerta seleccionado a diario. Cocciones lentas y respeto absoluto por el sabor original.
        </p>
      </div>

      <!-- Selector Minimalista de Pases (Primeros, Segundos, Postres) -->
      <div class="flex items-center justify-center gap-8 sm:gap-16 border-b border-white/10 pb-6 mb-20 scroll-reveal transition-all duration-1000 ease-out" role="tablist" aria-label="Secciones de la carta">
        <button type="button" data-tab-target="primeros" class="menu-tab-btn text-xs sm:text-sm font-light uppercase tracking-[0.35em] pb-6 -mb-[25px] border-b border-[#d4af37] text-[#d4af37] transition-all duration-300">
          Primeros Platos
        </button>
        <button type="button" data-tab-target="segundos" class="menu-tab-btn text-xs sm:text-sm font-light uppercase tracking-[0.35em] pb-6 -mb-[25px] border-b border-transparent text-[#f4f4f5]/50 hover:text-[#f4f4f5] transition-all duration-300">
          Segundos Platos
        </button>
        <button type="button" data-tab-target="postres" class="menu-tab-btn text-xs sm:text-sm font-light uppercase tracking-[0.35em] pb-6 -mb-[25px] border-b border-transparent text-[#f4f4f5]/50 hover:text-[#f4f4f5] transition-all duration-300">
          Postres de la Casa
        </button>
      </div>

      <!-- Contenedor de Primeros Platos -->
      <div id="tab-primeros" class="menu-tab-panel grid grid-cols-1 md:grid-cols-2 gap-x-16 lg:gap-x-24 gap-y-14 scroll-reveal transition-all duration-1000 ease-out">
        <% primerosList.forEach(function(item) { %>
          <article class="group border-b border-white/10 pb-8 flex flex-col justify-between">
            <div class="flex items-baseline justify-between gap-6 mb-3">
              <h3 class="font-serif text-xl sm:text-2xl font-normal text-[#f4f4f5] group-hover:text-[#d4af37] transition-colors duration-300 leading-snug">
                <%= item.name %>
              </h3>
              <span class="font-serif text-lg sm:text-xl font-normal text-[#d4af37] whitespace-nowrap shrink-0">
                <%= fmtPrice(item.price) %>
              </span>
            </div>
            <p class="text-xs sm:text-sm font-light text-[#f4f4f5]/55 leading-relaxed pr-6">
              <%= item.description %>
            </p>
          </article>
        <% }); %>
      </div>

      <!-- Contenedor de Segundos Platos -->
      <div id="tab-segundos" class="menu-tab-panel hidden grid-cols-1 md:grid-cols-2 gap-x-16 lg:gap-x-24 gap-y-14">
        <% segundosList.forEach(function(item) { %>
          <article class="group border-b border-white/10 pb-8 flex flex-col justify-between">
            <div class="flex items-baseline justify-between gap-6 mb-3">
              <h3 class="font-serif text-xl sm:text-2xl font-normal text-[#f4f4f5] group-hover:text-[#d4af37] transition-colors duration-300 leading-snug">
                <%= item.name %>
              </h3>
              <span class="font-serif text-lg sm:text-xl font-normal text-[#d4af37] whitespace-nowrap shrink-0">
                <%= fmtPrice(item.price) %>
              </span>
            </div>
            <p class="text-xs sm:text-sm font-light text-[#f4f4f5]/55 leading-relaxed pr-6">
              <%= item.description %>
            </p>
          </article>
        <% }); %>
      </div>

      <!-- Contenedor de Postres -->
      <div id="tab-postres" class="menu-tab-panel hidden grid-cols-1 md:grid-cols-2 gap-x-16 lg:gap-x-24 gap-y-14">
        <% postresList.forEach(function(item) { %>
          <article class="group border-b border-white/10 pb-8 flex flex-col justify-between">
            <div class="flex items-baseline justify-between gap-6 mb-3">
              <h3 class="font-serif text-xl sm:text-2xl font-normal text-[#f4f4f5] group-hover:text-[#d4af37] transition-colors duration-300 leading-snug">
                <%= item.name %>
              </h3>
              <span class="font-serif text-lg sm:text-xl font-normal text-[#d4af37] whitespace-nowrap shrink-0">
                <%= fmtPrice(item.price) %>
              </span>
            </div>
            <p class="text-xs sm:text-sm font-light text-[#f4f4f5]/55 leading-relaxed pr-6">
              <%= item.description %>
            </p>
          </article>
        <% }); %>
      </div>

      <p class="text-center text-[11px] font-light tracking-[0.22em] uppercase text-[#f4f4f5]/40 mt-20">
        Todos los precios están expresados en euros e incluyen el IVA vigente · Servicio de pan artesano y aperitivo de bienvenida
      </p>
    </section>

    <!-- =================================================================== -->
    <!-- 4. LA CASA (HISTORIA DE 1943 Y SALONES SEÑORIALES)                  -->
    <!-- =================================================================== -->
    <section id="la-casa" class="py-32 md:py-44 px-6 sm:px-10 lg:px-16 max-w-7xl mx-auto border-t border-white/10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 lg:gap-20 items-center mb-32 scroll-reveal transition-all duration-1000 ease-out">
        
        <div class="lg:col-span-5 space-y-8">
          <span class="block text-[10px] sm:text-xs font-light uppercase tracking-[0.42em] text-[#d4af37]">
            Patrimonio Gastronómico · 1943
          </span>
          <h2 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-light text-[#f4f4f5] leading-[1.12]">
            Arquitectura Castiza y Silencio Señorial
          </h2>
          <div class="w-14 h-px bg-[#d4af37]/50"></div>
          <p class="text-sm sm:text-base font-light text-[#f4f4f5]/70 leading-relaxed">
            Ubicado en el número 28 de la calle del Rey Francisco, en pleno corazón de Argüelles y Moncloa, <strong class="font-normal text-[#f4f4f5]">La Montaña</strong> conserva intacta la atmósfera de las grandes casas de comidas madrileñas de mediados del siglo XX.
          </p>
          <p class="text-sm sm:text-base font-light text-[#f4f4f5]/60 leading-relaxed">
            Cada espacio ha sido concebido para ofrecer intimidad acústica, mantelería de hilo blanco y un servicio de sala clásico donde el tiempo se detiene alrededor del guiso, el asado y la bodega.
          </p>
        </div>

        <!-- Dos tarjetas arquitectónicas con bordes ultrafinos border-white/10 -->
        <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-8">
          <div class="border border-white/10 bg-[#050506] p-8 sm:p-10 flex flex-col justify-between min-h-[360px] hover:border-[#d4af37]/40 transition-colors duration-500">
            <div>
              <span class="text-[10px] font-light uppercase tracking-[0.35em] text-[#d4af37] block mb-4">
                Planta Calle
              </span>
              <h3 class="font-serif text-2xl sm:text-3xl font-light text-[#f4f4f5] mb-4">
                Salón Principal de Azulejos
              </h3>
              <p class="text-xs sm:text-sm font-light text-[#f4f4f5]/60 leading-relaxed">
                Comedor señorial revestido con zócalos de cerámica talaverana pintada a mano, luz cálida tamizada y mesas vestidas con amplitud para almuerzos de negocios o celebraciones familiares.
              </p>
            </div>
            <div class="pt-8 mt-8 border-t border-white/10 flex items-center justify-between text-[11px] font-light tracking-[0.2em] uppercase text-[#f4f4f5]/50">
              <span>Capacidad</span>
              <span class="text-[#d4af37]">Mesas de 2 a 6 comensales</span>
            </div>
          </div>

          <div class="border border-white/10 bg-[#050506] p-8 sm:p-10 flex flex-col justify-between min-h-[360px] hover:border-[#d4af37]/40 transition-colors duration-500">
            <div>
              <span class="text-[10px] font-light uppercase tracking-[0.35em] text-[#d4af37] block mb-4">
                Planta Histórica Subterránea
              </span>
              <h3 class="font-serif text-2xl sm:text-3xl font-light text-[#f4f4f5] mb-4">
                La Cueva de Ladrillo Visto
              </h3>
              <p class="text-xs sm:text-sm font-light text-[#f4f4f5]/60 leading-relaxed">
                Antigua bóveda subterránea de ladrillo macizo original del Madrid clásico. Un refugio íntimo, silencioso y climatizado de forma natural, idóneo para veladas privadas y grandes vinos.
              </p>
            </div>
            <div class="pt-8 mt-8 border-t border-white/10 flex items-center justify-between text-[11px] font-light tracking-[0.2em] uppercase text-[#f4f4f5]/50">
              <span>Privacidad</span>
              <span class="text-[#d4af37]">Mesas de 2 a 8 comensales</span>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- =================================================================== -->
    <!-- 5. RESERVAS (SISTEMA INTELIGENTE CON ASIGNACIÓN DE MESA)            -->
    <!-- =================================================================== -->
    <section id="reservas" class="py-32 md:py-44 px-6 sm:px-10 lg:px-16 max-w-5xl mx-auto border-t border-white/10">
      <div class="scroll-reveal transition-all duration-1000 ease-out">
        
        <div class="text-center max-w-2xl mx-auto mb-16 md:mb-20">
          <span class="block text-[10px] sm:text-xs font-light uppercase tracking-[0.42em] text-[#d4af37] mb-5">
            Libro de Sala Digital
          </span>
          <h2 class="font-serif text-4xl sm:text-6xl font-light tracking-[0.05em] text-[#f4f4f5] mb-6">
            Reservar Mesa
          </h2>
          <div class="w-16 h-px bg-[#d4af37]/40 mx-auto mb-6"></div>
          <p class="text-xs sm:text-sm font-light text-[#f4f4f5]/60 tracking-[0.06em] leading-relaxed">
            Confirmación inmediata con asignación automática de salón y mesa según disponibilidad real de aforo.
          </p>
        </div>

        <!-- Contenedor del Formulario Minimalista -->
        <div class="border border-white/10 bg-[#050506] p-8 sm:p-12 md:p-16">
          <form id="reservation-form" class="space-y-10" novalidate>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 sm:gap-10">
              
              <!-- Nombre Completo -->
              <div>
                <label for="res-nombre" class="block text-[10px] font-light uppercase tracking-[0.3em] text-[#d4af37] mb-3">
                  Nombre y Apellidos *
                </label>
                <input
                  type="text"
                  id="res-nombre"
                  name="nombre"
                  required
                  placeholder="Ej. Carlos Mendoza"
                  class="w-full bg-transparent border-b border-white/10 focus:border-[#d4af37] py-3.5 text-sm font-light text-[#f4f4f5] placeholder-[#f4f4f5]/25 focus:outline-none transition-colors"
                />
              </div>

              <!-- Teléfono -->
              <div>
                <label for="res-telefono" class="block text-[10px] font-light uppercase tracking-[0.3em] text-[#d4af37] mb-3">
                  Teléfono de Contacto *
                </label>
                <input
                  type="tel"
                  id="res-telefono"
                  name="telefono"
                  required
                  placeholder="Ej. 600 000 000"
                  class="w-full bg-transparent border-b border-white/10 focus:border-[#d4af37] py-3.5 text-sm font-light text-[#f4f4f5] placeholder-[#f4f4f5]/25 focus:outline-none transition-colors"
                />
              </div>

              <!-- Correo Electrónico -->
              <div>
                <label for="res-email" class="block text-[10px] font-light uppercase tracking-[0.3em] text-[#d4af37] mb-3">
                  Correo Electrónico
                </label>
                <input
                  type="email"
                  id="res-email"
                  name="email"
                  placeholder="cliente@dominio.es"
                  class="w-full bg-transparent border-b border-white/10 focus:border-[#d4af37] py-3.5 text-sm font-light text-[#f4f4f5] placeholder-[#f4f4f5]/25 focus:outline-none transition-colors"
                />
              </div>

              <!-- Preferencia de Salón -->
              <div>
                <label for="res-zona" class="block text-[10px] font-light uppercase tracking-[0.3em] text-[#d4af37] mb-3">
                  Salón de Preferencia
                </label>
                <select
                  id="res-zona"
                  name="zonaPreferida"
                  class="w-full bg-[#050506] border-b border-white/10 focus:border-[#d4af37] py-3.5 text-sm font-light text-[#f4f4f5] focus:outline-none transition-colors"
                >
                  <option value="Cualquiera">Sin preferencia (Mejor mesa disponible)</option>
                  <option value="Salón Principal">Salón Principal (Azulejos Clásicos)</option>
                  <option value="La Cueva / Bóveda">La Cueva / Bóveda (Ladrillo Visto)</option>
                </select>
              </div>

              <!-- Fecha -->
              <div>
                <label for="res-fecha" class="block text-[10px] font-light uppercase tracking-[0.3em] text-[#d4af37] mb-3">
                  Fecha de Reserva *
                </label>
                <input
                  type="date"
                  id="res-fecha"
                  name="fecha"
                  required
                  class="w-full bg-transparent border-b border-white/10 focus:border-[#d4af37] py-3.5 text-sm font-light text-[#f4f4f5] focus:outline-none transition-colors"
                />
              </div>

              <!-- Hora y Comensales en sub-grid -->
              <div class="grid grid-cols-2 gap-6">
                <div>
                  <label for="res-hora" class="block text-[10px] font-light uppercase tracking-[0.3em] text-[#d4af37] mb-3">
                    Turno / Hora *
                  </label>
                  <select
                    id="res-hora"
                    name="hora"
                    required
                    class="w-full bg-[#050506] border-b border-white/10 focus:border-[#d4af37] py-3.5 text-sm font-light text-[#f4f4f5] focus:outline-none transition-colors"
                  >
                    <% slots.forEach(function(slot) { %>
                      <option value="<%= slot %>"><%= slot %> h</option>
                    <% }); %>
                  </select>
                </div>

                <div>
                  <label for="res-personas" class="block text-[10px] font-light uppercase tracking-[0.3em] text-[#d4af37] mb-3">
                    Comensales *
                  </label>
                  <select
                    id="res-personas"
                    name="personas"
                    required
                    class="w-full bg-[#050506] border-b border-white/10 focus:border-[#d4af37] py-3.5 text-sm font-light text-[#f4f4f5] focus:outline-none transition-colors"
                  >
                    <% for (let i = 1; i <= 8; i++) { %>
                      <option value="<%= i %>" <%= i === 2 ? 'selected' : '' %>><%= i %> <%= i === 1 ? 'Persona' : 'Personas' %></option>
                    <% } %>
                  </select>
                </div>
              </div>

            </div>

            <!-- Notas o Alergias -->
            <div>
              <label for="res-notas" class="block text-[10px] font-light uppercase tracking-[0.3em] text-[#d4af37] mb-3">
                Peticiones Especiales o Alergias Alimentarias
              </label>
              <input
                type="text"
                id="res-notas"
                name="notas"
                placeholder="Indique intolerancias, celebración especial o preferencia de ubicación..."
                class="w-full bg-transparent border-b border-white/10 focus:border-[#d4af37] py-3.5 text-sm font-light text-[#f4f4f5] placeholder-[#f4f4f5]/25 focus:outline-none transition-colors"
              />
            </div>

            <!-- Estado / Respuesta del Servidor -->
            <div id="reservation-feedback" class="hidden border border-white/10 p-6 text-xs sm:text-sm font-light leading-relaxed"></div>

            <!-- Botón de Envío Sobrio -->
            <div class="pt-4 flex flex-col sm:flex-row items-center justify-between gap-6">
              <p class="text-[11px] font-light text-[#f4f4f5]/45 tracking-[0.06em]">
                Para grupos superiores a 8 comensales, rogamos contacten directamente con dirección de sala.
              </p>
              <button
                type="submit"
                id="res-submit-btn"
                class="w-full sm:w-auto px-12 py-4 border border-[#d4af37] bg-transparent text-[#f4f4f5] hover:bg-[#d4af37]/10 text-[11px] font-light uppercase tracking-[0.32em] transition-all duration-500 shrink-0"
              >
                Confirmar Reserva
              </button>
            </div>
          </form>
        </div>

      </div>
    </section>
  </main>

  <!-- ===================================================================== -->
  <!-- FOOTER MINIMALISTA Y CUMPLIMIENTO LEGAL (RGPD / LSSI-CE)              -->
  <!-- ===================================================================== -->
  <footer class="border-t border-white/10 bg-[#050506] py-20 px-6 sm:px-10 lg:px-16">
    <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-start md:items-center justify-between gap-12 pb-16 border-b border-white/10">
      <div>
        <div class="flex items-center gap-4 mb-4">
          <span class="font-serif text-xs font-light tracking-[0.35em] text-[#d4af37] border border-white/10 px-2.5 py-1">
            L.M
          </span>
          <span class="font-serif text-lg font-light tracking-[0.32em] text-[#f4f4f5] uppercase">
            LA MONTAÑA
          </span>
        </div>
        <p class="text-xs font-light text-[#f4f4f5]/50 tracking-[0.08em]">
          <%= rest.address %> · Tel. <%= rest.phone %>
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-8 text-[11px] font-light uppercase tracking-[0.25em] text-[#f4f4f5]/50">
        <button type="button" data-legal-modal="aviso" class="hover:text-[#d4af37] transition-colors">Aviso Legal</button>
        <button type="button" data-legal-modal="privacidad" class="hover:text-[#d4af37] transition-colors">Privacidad</button>
        <button type="button" data-legal-modal="cookies" class="hover:text-[#d4af37] transition-colors">Cookies</button>
        <a href="/admin" class="hover:text-[#d4af37] transition-colors">Acceso Dirección</a>
      </div>
    </div>

    <div class="max-w-7xl mx-auto pt-10 flex flex-col sm:flex-row items-center justify-between gap-4 text-[11px] font-light text-[#f4f4f5]/35 tracking-[0.12em]">
      <p>© <%= new Date().getFullYear() %> Restaurante La Montaña · Madrid. Todos los derechos reservados.</p>
      <p><%= rest.Schedule %></p>
    </div>
  </footer>

  <!-- ===================================================================== -->
  <!-- MODAL LEGAL UNIFICADO (AVISO LEGAL, PRIVACIDAD, COOKIES)              -->
  <!-- ===================================================================== -->
  <div id="legal-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-[#050506]/90 backdrop-blur-md p-6" role="dialog" aria-modal="true">
    <div class="max-w-2xl w-full border border-white/10 bg-[#050506] p-8 sm:p-12 relative max-h-[85vh] overflow-y-auto">
      <button type="button" id="close-legal-modal" class="absolute top-6 right-6 text-[#f4f4f5]/50 hover:text-[#d4af37] text-xs uppercase tracking-[0.25em]">
        Cerrar [×]
      </button>
      <h3 id="legal-modal-title" class="font-serif text-3xl font-light text-[#d4af37] mb-6"></h3>
      <div id="legal-modal-body" class="text-xs sm:text-sm font-light text-[#f4f4f5]/70 space-y-4 leading-relaxed"></div>
    </div>
  </div>

  <!-- ===================================================================== -->
  <!-- SCRIPTS: SCROLL REVEAL, TABS DE CARTA Y RESERVAS                      -->
  <!-- ===================================================================== -->
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      // 1. Inicializar fecha mínima de reserva a hoy
      const dateInput = document.getElementById('res-fecha');
      if (dateInput) {
        const today = new Date().toISOString().split('T')[0];
        dateInput.min = today;
        if (!dateInput.value) dateInput.value = today;
      }

      // 2. Transiciones de Scroll Fluidas (IntersectionObserver)
      const revealElements = document.querySelectorAll('.scroll-reveal');
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });

        revealElements.forEach(function (el) {
          observer.observe(el);
        });
      } else {
        revealElements.forEach(function (el) {
          el.classList.add('is-visible');
        });
      }

      // 3. Menú Móvil Minimalista
      const mobileBtn = document.getElementById('mobile-menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');
      const iconOpen = document.getElementById('menu-icon-open');
      const iconClose = document.getElementById('menu-icon-close');

      if (mobileBtn && mobileMenu) {
        mobileBtn.addEventListener('click', function () {
          const isHidden = mobileMenu.classList.contains('hidden');
          mobileMenu.classList.toggle('hidden', !isHidden);
          iconOpen.classList.toggle('hidden', isHidden);
          iconClose.classList.toggle('hidden', !isHidden);
          mobileBtn.setAttribute('aria-expanded', String(isHidden));
        });

        document.querySelectorAll('.mobile-nav-link').forEach(function (link) {
          link.addEventListener('click', function () {
            mobileMenu.classList.add('hidden');
            iconOpen.classList.remove('hidden');
            iconClose.classList.add('hidden');
            mobileBtn.setAttribute('aria-expanded', 'false');
          });
        });
      }

      // 4. Pestañas de la Carta (Primeros, Segundos, Postres)
      const tabButtons = document.querySelectorAll('.menu-tab-btn');
      const tabPanels = {
        primeros: document.getElementById('tab-primeros'),
        segundos: document.getElementById('tab-segundos'),
        postres: document.getElementById('tab-postres')
      };

      tabButtons.forEach(function (btn) {
        btn.addEventListener('click', function () {
          const target = btn.getAttribute('data-tab-target');

          tabButtons.forEach(function (b) {
            const active = b.getAttribute('data-tab-target') === target;
            b.classList.toggle('border-[#d4af37]', active);
            b.classList.toggle('text-[#d4af37]', active);
            b.classList.toggle('border-transparent', !active);
            b.classList.toggle('text-[#f4f4f5]/50', !active);
          });

          Object.keys(tabPanels).forEach(function (key) {
            const panel = tabPanels[key];
            if (!panel) return;
            if (key === target) {
              panel.classList.remove('hidden');
              panel.classList.add('grid');
            } else {
              panel.classList.add('hidden');
              panel.classList.remove('grid');
            }
          });
        });
      });

      // 5. Envío del Formulario de Reserva
      const form = document.getElementById('reservation-form');
      const feedback = document.getElementById('reservation-feedback');
      const submitBtn = document.getElementById('res-submit-btn');

      if (form) {
        form.addEventListener('submit', async function (e) {
          e.preventDefault();
          feedback.classList.add('hidden');

          const payload = {
            nombre: document.getElementById('res-nombre').value.trim(),
            telefono: document.getElementById('res-telefono').value.trim(),
            email: document.getElementById('res-email').value.trim(),
            zonaPreferida: document.getElementById('res-zona').value,
            fecha: document.getElementById('res-fecha').value,
            hora: document.getElementById('res-hora').value,
            personas: parseInt(document.getElementById('res-personas').value, 10),
            notas: document.getElementById('res-notas').value.trim()
          };

          if (!payload.nombre || !payload.telefono || !payload.fecha || !payload.hora) {
            feedback.className = 'border border-[#d4af37]/50 bg-[#050506] p-6 text-xs sm:text-sm font-light text-[#d4af37]';
            feedback.textContent = 'Por favor, complete su nombre, teléfono, fecha y turno de reserva.';
            feedback.classList.remove('hidden');
            return;
          }

          submitBtn.disabled = true;
          submitBtn.textContent = 'Procesando...';

          try {
            const response = await fetch('/api/reservar', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload)
            });
            const data = await response.json();

            if (response.ok && data.success) {
              const resInfo = data.reserva || {};
              feedback.className = 'border border-[#d4af37] bg-[#050506] p-6 text-xs sm:text-sm font-light text-[#f4f4f5]';
              feedback.innerHTML =
                '<p class="font-serif text-xl text-[#d4af37] mb-2">Reserva Confirmada</p>' +
                '<p>' + (data.message || 'Su mesa ha sido reservada correctamente.') + '</p>' +
                (resInfo.mesaNumero
                  ? '<p class="mt-2 text-[#f4f4f5]/70">Asignación: <strong>Mesa ' + resInfo.mesaNumero + '</strong> · ' + (resInfo.zona || '') + ' · Código: ' + (resInfo.codigo || '') + '</p>'
                  : '');
              form.reset();
              if (dateInput) dateInput.value = payload.fecha;
            } else {
              feedback.className = 'border border-white/20 bg-[#050506] p-6 text-xs sm:text-sm font-light text-[#d4af37]';
              feedback.textContent = data.message || 'No ha sido posible completar la reserva en este horario.';
            }
          } catch (err) {
            feedback.className = 'border border-white/20 bg-[#050506] p-6 text-xs sm:text-sm font-light text-[#d4af37]';
            feedback.textContent = 'Error de conexión con el servidor. Puede reservar directamente en el 915 47 10 53.';
          } finally {
            feedback.classList.remove('hidden');
            submitBtn.disabled = false;
            submitBtn.textContent = 'Confirmar Reserva';
          }
        });
      }

      // 6. Modales Legales (LSSI-CE / RGPD)
      const legalModal = document.getElementById('legal-modal');
      const legalTitle = document.getElementById('legal-modal-title');
      const legalBody = document.getElementById('legal-modal-body');
      const closeLegal = document.getElementById('close-legal-modal');

      const legalTexts = {
        aviso: {
          title: 'Aviso Legal (LSSI-CE)',
          body: '<p>En cumplimiento de la Ley 34/2002 de Servicios de la Sociedad de la Información y de Comercio Electrónico (LSSI-CE), se informa que el presente sitio web es titularidad de <strong>Restaurante La Montaña</strong>, con domicilio social en C. del Rey Francisco, 28, Moncloa - Aravaca, 28008 Madrid.</p><p>Teléfono de contacto: 915 47 10 53. Correo electrónico: reservas@resturantelamontana.es.</p>'
        },
        privacidad: {
          title: 'Política de Privacidad (RGPD)',
          body: '<p>De conformidad con el Reglamento (UE) 2016/679 (RGPD) y la LOPDGDD 3/2018, los datos personales facilitados en el formulario de reservas serán tratados exclusivamente con la finalidad de gestionar su mesa y garantizar la calidad del servicio en sala.</p><p>No se cederán datos a terceros salvo obligación legal. Puede ejercer sus derechos de acceso, rectificación, supresión y oposición escribiendo a nuestra dirección postal en C. del Rey Francisco, 28, 28008 Madrid.</p>'
        },
        cookies: {
          title: 'Política de Cookies',
          body: '<p>Este sitio web utiliza únicamente cookies técnicas estrictamente necesarias para el funcionamiento de la sesión y la gestión de reservas, sin emplear cookies publicitarias ni de rastreo de terceros.</p>'
        }
      };

      document.querySelectorAll('[data-legal-modal]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          const key = btn.getAttribute('data-legal-modal');
          const content = legalTexts[key];
          if (content && legalModal) {
            legalTitle.textContent = content.title;
            legalBody.innerHTML = content.body;
            legalModal.classList.remove('hidden');
            legalModal.classList.add('flex');
          }
        });
      });

      if (closeLegal && legalModal) {
        closeLegal.addEventListener('click', function () {
          legalModal.classList.add('hidden');
          legalModal.classList.remove('flex');
        });
        legalModal.addEventListener('click', function (e) {
          if (e.target === legalModal) {
            legalModal.classList.add('hidden');
            legalModal.classList.remove('flex');
          }
        });
      }
    });
  </script>
</body>
</html>
