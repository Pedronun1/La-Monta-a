<!DOCTYPE html>
<html lang="es" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Libro de Sala & Reservas — <%= restaurant.name %></title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Montserrat:wght@300;400;500;600&family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/luxury.css" />
</head>
<body class="bg-[#09090b] text-[#f4f4f5] font-sans font-light min-h-screen flex flex-col">

  <!-- Cabecera del Panel Privado con Navegación de Módulos y Cierre de Sesión (100% Responsiva) -->
  <header class="lm-navbar backdrop-blur-md bg-stone-950/80 sticky top-0 z-50 border-b border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-10 h-20 sm:h-24 flex items-center justify-between gap-3">
      <div class="flex items-center gap-3 sm:gap-4 min-w-0">
        <span class="lm-monogram-seal"><%= restaurant.monogram %></span>
        <div class="min-w-0">
          <div class="flex items-center gap-2.5">
            <h1 class="font-serif text-xl sm:text-2xl lg:text-3xl font-normal text-[#f4f1ea] leading-none truncate">
              Dirección de Sala & Maître
            </h1>
            <span class="hidden sm:inline-block px-2.5 py-0.5 text-[9px] tracking-[0.22em] uppercase border border-[#d4af37]/40 text-[#d4af37] shrink-0">
              SESIÓN ACTIVA
            </span>
          </div>
          <p class="text-[10px] sm:text-[11px] text-neutral-400 mt-1 truncate">
            <%= restaurant.name %> · <%= restaurant.address.street %> (<%= adminUser %>)
          </p>
        </div>
      </div>

      <!-- Pestañas de Módulos de Administración (Tablet/Escritorio md+) -->
      <nav class="hidden md:flex items-center gap-2 bg-[#111115] border border-white/10 p-1">
        <a
          href="/admin"
          class="px-4 py-2 text-[10px] tracking-[0.2em] uppercase font-medium bg-[#d4af37] text-[#09090b] transition"
        >
          LIBRO DE RESERVAS
        </a>
        <a
          href="/admin/mesas"
          class="px-4 py-2 text-[10px] tracking-[0.2em] uppercase font-medium text-neutral-300 hover:text-[#d4af37] transition"
        >
          MAPA DE MESAS & SALONES
        </a>
      </nav>

      <div class="flex items-center gap-2 sm:gap-3 shrink-0">
        <a href="/" class="hidden sm:inline-flex lm-btn-outline py-2 px-4 text-[10px] min-h-[40px]">
          WEB PÚBLICA
        </a>

        <form action="/admin/logout" method="POST" class="inline">
          <button
            type="submit"
            class="min-h-[40px] px-3.5 sm:px-5 py-2 text-[10px] tracking-[0.2em] uppercase font-medium bg-red-950/60 hover:bg-red-900 text-red-200 border border-red-500/40 transition-colors cursor-pointer"
          >
            SALIR
          </button>
        </form>
      </div>
    </div>

    <!-- Barra Táctil Inferior de Módulos para Smartphones (< md) -->
    <div class="md:hidden grid grid-cols-3 border-t border-white/10 bg-[#0d0d10] text-center">
      <a
        href="/admin"
        class="py-3 text-[10px] tracking-[0.18em] uppercase font-medium bg-[#d4af37] text-[#09090b]"
      >
        RESERVAS
      </a>
      <a
        href="/admin/mesas"
        class="py-3 text-[10px] tracking-[0.18em] uppercase font-medium text-neutral-300 border-x border-white/10 hover:text-[#d4af37]"
      >
        MAPA MESAS
      </a>
      <a
        href="/"
        class="py-3 text-[10px] tracking-[0.18em] uppercase font-medium text-neutral-400 hover:text-[#f4f1ea]"
      >
        WEB PÚBLICA
      </a>
    </div>
  </header>

  <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-10 py-8 sm:py-12 space-y-8 sm:space-y-10">

    <!-- 1. Indicadores KPI de Sala y Ocupación de Mesas -->
    <div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-5 gap-3.5 sm:gap-5">
      <div class="bg-[#111115] border border-white/10 p-4 sm:p-6">
        <span class="text-[9px] sm:text-[10px] tracking-[0.2em] uppercase text-neutral-400 block">RESERVAS ACTIVAS</span>
        <span id="kpi-total" class="font-serif text-3xl sm:text-4xl text-[#f4f1ea] mt-1.5 sm:mt-2 block"><%= stats.totalReservations %></span>
      </div>

      <div class="bg-[#111115] border border-white/10 p-4 sm:p-6">
        <span class="text-[9px] sm:text-[10px] tracking-[0.2em] uppercase text-neutral-400 block">SERVICIO DE HOY</span>
        <span id="kpi-today" class="font-serif text-3xl sm:text-4xl text-[#d4af37] mt-1.5 sm:mt-2 block"><%= stats.todayReservations %></span>
      </div>

      <div class="bg-[#111115] border border-white/10 p-4 sm:p-6">
        <span class="text-[9px] sm:text-[10px] tracking-[0.2em] uppercase text-neutral-400 block">COMENSALES</span>
        <span id="kpi-guests" class="font-serif text-3xl sm:text-4xl text-[#f4f1ea] mt-1.5 sm:mt-2 block"><%= stats.totalGuests %></span>
      </div>

      <div class="bg-[#111115] border border-white/10 p-4 sm:p-6">
        <span class="text-[9px] sm:text-[10px] tracking-[0.2em] uppercase text-neutral-400 block">MESAS LIBRES</span>
        <div class="flex items-baseline gap-1.5 mt-1.5 sm:mt-2">
          <span id="kpi-tables-free" class="font-serif text-3xl sm:text-4xl text-emerald-400"><%= stats.tables ? stats.tables.freeTables : 0 %></span>
          <span class="text-[11px] text-neutral-500">/ <%= stats.tables ? stats.tables.totalTables : 14 %></span>
        </div>
      </div>

      <div class="col-span-2 lg:col-span-1 bg-[#111115] border border-white/10 p-4 sm:p-6 flex flex-row lg:flex-col items-center lg:items-start justify-between">
        <span class="text-[9px] sm:text-[10px] tracking-[0.2em] uppercase text-neutral-400 block">PLANO DE SALONES</span>
        <a href="/admin/mesas" class="lg:mt-3 inline-flex items-center gap-2 text-xs text-[#d4af37] hover:underline tracking-wider uppercase">
          <span>GESTIONAR MESAS</span>
          <span>→</span>
        </a>
      </div>
    </div>

    <!-- 2. Filtros y Alta Telefónica -->
    <div class="bg-[#111115] border border-white/10 p-4 sm:p-6 flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-4">
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 sm:gap-4 flex-1">
        <input
          id="admin-search-input"
          type="text"
          placeholder="Buscar titular, teléfono, mesa (M-01) o código LM-2026..."
          class="lm-input flex-1 py-2.5"
        />

        <div class="grid grid-cols-2 sm:flex gap-3">
          <input id="admin-date-filter" type="date" class="lm-input sm:w-44 py-2.5" />

          <select id="admin-status-filter" class="lm-input sm:w-44 py-2.5">
            <option value="all">Todos los estados</option>
            <option value="confirmed">Confirmadas</option>
            <option value="completed">Completadas</option>
            <option value="cancelled">Canceladas</option>
          </select>
        </div>
      </div>

      <div class="grid grid-cols-2 sm:flex items-center gap-3">
        <button id="admin-refresh-btn" type="button" class="lm-btn-outline py-2.5 px-4 text-[10px] w-full sm:w-auto">
          SINCRONIZAR
        </button>
        <button id="open-manual-modal-btn" type="button" class="lm-btn-gold py-2.5 px-4 text-[10px] w-full sm:w-auto">
          + RESERVA TELEFÓNICA
        </button>
      </div>
    </div>

    <!-- 3. Tabla de Reservas con Desplazamiento Táctil Horizontal Fluido -->
    <div class="bg-[#111115] border border-white/10 overflow-hidden shadow-2xl">
      <div class="px-4 sm:px-6 py-5 border-b border-white/10 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div>
          <h2 class="font-serif text-xl sm:text-2xl font-normal text-[#f4f1ea]">
            Registro Oficial de Reservas & Asignación de Mesas
          </h2>
          <p class="text-[11px] text-neutral-400 mt-0.5">
            Asigne o modifique la mesa física de cada reserva directamente desde el selector de sala (<code class="text-[#d4af37]">lamontana.db</code>)
          </p>
        </div>
        <span id="table-count-badge" class="text-[10px] tracking-[0.22em] uppercase px-3 py-1 border border-[#d4af37]/40 text-[#d4af37] self-start sm:self-auto">
          <%= reservations.length %> REGISTROS
        </span>
      </div>

      <!-- Indicador Táctil de Desplazamiento Horizontal en Smartphones y Tablets -->
      <div class="lg:hidden px-4 py-2 bg-[#0d0d10] border-b border-white/5 text-[10px] tracking-[0.18em] uppercase text-[#d4af37]/80 flex items-center justify-between">
        <span>← DESLICE LA TABLA HORIZONTALMENTE</span>
        <span>GESTIÓN TÁCTIL →</span>
      </div>

      <div class="lm-touch-scroll overflow-x-auto">
        <table class="w-full min-w-[920px] text-left border-collapse">
          <thead>
            <tr class="border-b border-white/10 bg-[#0a0a0c] text-[10px] tracking-[0.2em] uppercase text-neutral-400">
              <th class="py-4 px-5 font-medium">Localizador</th>
              <th class="py-4 px-5 font-medium">Fecha y Hora</th>
              <th class="py-4 px-5 font-medium">Titular y Contacto</th>
              <th class="py-4 px-5 font-medium">Comensales / Salón</th>
              <th class="py-4 px-5 font-medium">Asignación de Mesa</th>
              <th class="py-4 px-5 font-medium">Indicaciones de Sala</th>
              <th class="py-4 px-5 font-medium">Estado</th>
              <th class="py-4 px-5 font-medium text-right">Gestión</th>
            </tr>
          </thead>
          <tbody id="admin-reservations-tbody" class="divide-y divide-white/5 text-xs">
            <% if (reservations.length === 0) { %>
              <tr>
                <td colspan="8" class="py-12 text-center text-neutral-500">
                  No existen reservas registradas con los criterios actuales.
                </td>
              </tr>
            <% } else { %>
              <% reservations.forEach(function(r) { %>
                <tr class="hover:bg-white/[0.02] transition-colors <%= r.status === 'cancelled' ? 'opacity-45' : '' %>">
                  <td class="py-4 px-5 whitespace-nowrap">
                    <span class="font-mono text-xs text-[#d4af37] border border-[#d4af37]/30 px-2.5 py-1">
                      <%= r.reservation_code %>
                    </span>
                  </td>
                  <td class="py-4 px-5 whitespace-nowrap">
                    <span class="block text-[#f4f1ea] font-normal"><%= r.reservation_date %></span>
                    <span class="block text-[#d4af37] mt-0.5"><%= r.reservation_time %> h</span>
                  </td>
                  <td class="py-4 px-5">
                    <span class="block text-sm text-[#f4f1ea] font-normal <%= r.status === 'completed' ? 'line-through text-neutral-500' : '' %>">
                      <%= r.customer_name %>
                    </span>
                    <a href="tel:<%= r.customer_phone %>" class="block text-neutral-400 hover:text-[#d4af37] mt-0.5">
                      <%= r.customer_phone %>
                    </a>
                    <span class="block text-[11px] text-neutral-500"><%= r.customer_email %></span>
                  </td>
                  <td class="py-4 px-5 whitespace-nowrap">
                    <span class="text-[#f4f1ea] font-normal"><%= r.guests %> comensales</span>
                    <span class="block text-neutral-400 mt-0.5"><%= r.dining_area_name %></span>
                  </td>
                  <td class="py-4 px-5 whitespace-nowrap">
                    <div class="flex flex-col gap-1.5 min-w-[185px]">
                      <% if (r.table_number) { %>
                        <span class="inline-flex items-center gap-1.5 text-[10px] tracking-[0.16em] uppercase text-[#d4af37]">
                          <span class="w-1.5 h-1.5 rounded-full bg-[#d4af37]"></span>
                          Mesa <%= r.table_number %>
                        </span>
                      <% } else { %>
                        <span class="text-[10px] tracking-[0.14em] uppercase text-neutral-500">
                          Pendiente de asignar
                        </span>
                      <% } %>
                      <select
                        data-action="assign-table"
                        data-reservation-id="<%= r.id %>"
                        class="assign-table-select bg-[#09090b] border border-white/15 focus:border-[#d4af37] text-[11px] text-[#f4f1ea] px-2.5 py-1.5 outline-none transition"
                      >
                        <option value="">— Sin mesa asignada —</option>
                        <% (tables || []).forEach(function(t) { %>
                          <option
                            value="<%= t.id %>"
                            <%= Number(r.table_id) === Number(t.id) ? 'selected' : '' %>
                          >
                            <%= t.table_number %> (<%= t.capacity %> pax · <%= t.status %>)
                          </option>
                        <% }); %>
                      </select>
                    </div>
                  </td>
                  <td class="py-4 px-5 max-w-xs">
                    <% if (r.notes) { %>
                      <p class="text-neutral-300 italic">“<%= r.notes %>”</p>
                    <% } else { %>
                      <span class="text-neutral-600">Sin observaciones</span>
                    <% } %>
                    <% if (r.preselected_dishes && r.preselected_dishes.length > 0) { %>
                      <div class="mt-1.5 flex flex-wrap gap-1">
                        <% r.preselected_dishes.forEach(function(d) { %>
                          <span class="px-2 py-0.5 text-[10px] border border-[#d4af37]/30 text-[#d4af37]">
                            <%= d %>
                          </span>
                        <% }); %>
                      </div>
                    <% } %>
                  </td>
                  <td class="py-4 px-5 whitespace-nowrap">
                    <% if (r.status === 'confirmed') { %>
                      <span class="px-2.5 py-1 text-[10px] tracking-[0.16em] uppercase border border-emerald-500/40 text-emerald-300">
                        Confirmada
                      </span>
                    <% } else if (r.status === 'completed') { %>
                      <span class="px-2.5 py-1 text-[10px] tracking-[0.16em] uppercase border border-[#d4af37]/40 text-[#d4af37]">
                        Completada
                      </span>
                    <% } else { %>
                      <span class="px-2.5 py-1 text-[10px] tracking-[0.16em] uppercase border border-red-500/40 text-red-300">
                        Cancelada
                      </span>
                    <% } %>
                  </td>
                  <td class="py-4 px-5 whitespace-nowrap text-right">
                    <div class="inline-flex items-center gap-1.5">
                      <% if (r.status !== 'completed') { %>
                        <button
                          type="button"
                          data-action="status"
                          data-id="<%= r.id %>"
                          data-status="completed"
                          class="admin-action-btn px-2.5 py-1 text-[10px] tracking-wider uppercase border border-emerald-500/40 text-emerald-300 hover:bg-emerald-950/50 transition"
                        >
                          Completar
                        </button>
                      <% } %>
                      <% if (r.status !== 'confirmed') { %>
                        <button
                          type="button"
                          data-action="status"
                          data-id="<%= r.id %>"
                          data-status="confirmed"
                          class="admin-action-btn px-2.5 py-1 text-[10px] tracking-wider uppercase border border-white/20 text-[#e5e5e5] hover:border-[#d4af37] transition"
                        >
                          Confirmar
                        </button>
                      <% } %>
                      <% if (r.status !== 'cancelled') { %>
                        <button
                          type="button"
                          data-action="status"
                          data-id="<%= r.id %>"
                          data-status="cancelled"
                          class="admin-action-btn px-2.5 py-1 text-[10px] tracking-wider uppercase border border-amber-500/40 text-amber-300 hover:bg-amber-950/40 transition"
                        >
                          Cancelar
                        </button>
                      <% } %>
                      <button
                        type="button"
                        data-action="delete"
                        data-id="<%= r.id %>"
                        class="admin-action-btn px-2.5 py-1 text-[10px] tracking-wider uppercase border border-red-500/40 text-red-300 hover:bg-red-950/50 transition"
                      >
                        Eliminar
                      </button>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- 4. Vista Integrada de Salones y Mesas Físicas (Salón Principal & La Cueva) -->
    <section class="bg-[#111115] border border-white/10 p-4 sm:p-6 lg:p-8 shadow-2xl space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-white/10 pb-5">
        <div>
          <span class="text-[10px] tracking-[0.26em] uppercase text-[#d4af37] block">
            ESTADO DE ESPACIOS EN TIEMPO REAL
          </span>
          <h2 class="font-serif text-xl sm:text-2xl font-normal text-[#f4f4f5] mt-1">
            Distribución de Mesas por Salón (Salón Principal & La Cueva)
          </h2>
        </div>
        <a href="/admin/mesas" class="lm-btn-outline py-2.5 px-5 text-[10px] self-start sm:self-auto">
          ABRIR GESTOR COMPLETO DE MESAS →
        </a>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <% (zones || []).forEach(function(zone) { %>
          <% const zTables = (tables || []).filter(function(t) { return t.zone_id === zone.id; }); %>
          <div class="bg-[#09090b] border border-white/10 p-5 space-y-4">
            <div class="flex items-center justify-between border-b border-white/10 pb-3">
              <div>
                <h3 class="font-serif text-lg text-[#f4f4f5]"><%= zone.name %></h3>
                <span class="text-[10px] text-neutral-400"><%= zone.architectural_style %></span>
              </div>
              <span class="px-2.5 py-0.5 text-[10px] border border-[#d4af37]/40 text-[#d4af37]">
                <%= zTables.length %> mesas
              </span>
            </div>

            <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5">
              <% zTables.forEach(function(t) { %>
                <a
                  href="/admin/mesas"
                  class="p-2.5 border transition hover:border-[#d4af37] <%= t.status === 'Libre' ? 'border-emerald-500/35 bg-emerald-950/15' : t.status === 'Reservada' ? 'border-[#d4af37]/45 bg-[#d4af37]/10' : t.status === 'Ocupada' ? 'border-red-500/40 bg-red-950/20' : 'border-neutral-600/40 opacity-60' %>"
                >
                  <div class="flex items-center justify-between text-xs font-mono text-[#f4f4f5]">
                    <span><%= t.table_number %></span>
                    <span class="text-[10px] text-[#d4af37]"><%= t.capacity %>p</span>
                  </div>
                  <span class="block text-[9px] uppercase tracking-wider mt-1 text-neutral-300 truncate">
                    <%= t.status %>
                  </span>
                </a>
              <% }); %>
            </div>
          </div>
        <% }); %>
      </div>
    </section>
  </main>

  <!-- Modal para Reserva Telefónica Directa con Asignación de Mesa (100% Responsivo) -->
  <div id="manual-reservation-modal" class="hidden fixed inset-0 z-50 bg-black/85 backdrop-blur-sm flex items-center justify-center p-3 sm:p-4">
    <div class="bg-[#111115] border border-white/15 max-w-lg w-full max-h-[92dvh] overflow-y-auto p-5 sm:p-8 shadow-2xl space-y-6">
      <div class="flex items-center justify-between border-b border-white/10 pb-4">
        <div>
          <span class="text-[9px] tracking-[0.28em] uppercase text-[#d4af37] block">REGISTRO DE MAÎTRE</span>
          <h3 class="font-serif text-xl sm:text-2xl text-[#f4f1ea]">Nueva Reserva Telefónica</h3>
        </div>
        <button id="close-manual-modal-btn" type="button" class="min-h-[40px] px-2 text-neutral-400 hover:text-white text-xs tracking-widest">CERRAR ✕</button>
      </div>

      <form id="manual-reservation-form" class="space-y-4">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="lm-label">Fecha *</label>
            <input id="manual-date" type="date" required class="lm-input py-2.5" />
          </div>
          <div>
            <label class="lm-label">Hora *</label>
            <select id="manual-time" class="lm-input py-2.5">
              <% timeSlots.forEach(function(slot) { %>
                <option value="<%= slot %>"><%= slot %> h</option>
              <% }); %>
            </select>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="lm-label">Comensales *</label>
            <input id="manual-guests" type="number" min="1" max="25" value="2" required class="lm-input py-2.5" />
          </div>
          <div>
            <label class="lm-label">Salón *</label>
            <select id="manual-area" class="lm-input py-2.5">
              <% restaurant.diningAreas.forEach(function(a) { %>
                <option value="<%= a.id %>"><%= a.name %></option>
              <% }); %>
            </select>
          </div>
        </div>

        <div>
          <label class="lm-label">Asignar Mesa Específica (Opcional — Autoasignación si vacío)</label>
          <select id="manual-table-id" class="lm-input py-2.5">
            <option value="">Asignación automática según aforo y zona</option>
            <% (tables || []).forEach(function(t) { %>
              <option value="<%= t.id %>">
                Mesa <%= t.table_number %> — <%= t.zone_name %> (Máx. <%= t.capacity %> pax · <%= t.status %>)
              </option>
            <% }); %>
          </select>
        </div>

        <div>
          <label class="lm-label">Titular *</label>
          <input id="manual-name" type="text" required placeholder="Nombre y apellidos" class="lm-input py-2.5" />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="lm-label">Teléfono *</label>
            <input id="manual-phone" type="tel" inputmode="tel" required placeholder="+34 600 000 000" class="lm-input py-2.5" />
          </div>
          <div>
            <label class="lm-label">Correo</label>
            <input id="manual-email" type="email" inputmode="email" placeholder="cliente@correo.es" class="lm-input py-2.5" />
          </div>
        </div>

        <div>
          <label class="lm-label">Observaciones de Sala</label>
          <input id="manual-notes" type="text" placeholder="Alergias, mesa preferida..." class="lm-input py-2.5" />
        </div>

        <div class="pt-4 flex flex-col-reverse sm:flex-row justify-end gap-3">
          <button id="cancel-manual-modal-btn" type="button" class="lm-btn-outline py-2.5 px-5 text-[10px] w-full sm:w-auto">
            CANCELAR
          </button>
