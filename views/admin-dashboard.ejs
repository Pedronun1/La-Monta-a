<!DOCTYPE html>
<html lang="es" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Libro de Sala & Reservas — <%= restaurant.name %></title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Montserrat:wght@300;400;500;600&display=swap" rel="stylesheet" />

  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/luxury.css" />
</head>
<body class="bg-[#0a0a0c] text-[#e5e5e5] font-sans font-light min-h-screen flex flex-col">

  <!-- Cabecera del Panel Privado con Botón de Cerrar Sesión -->
  <header class="lm-navbar">
    <div class="max-w-7xl mx-auto px-6 lg:px-10 h-24 flex items-center justify-between gap-4">
      <div class="flex items-center gap-4">
        <span class="lm-monogram-seal"><%= restaurant.monogram %></span>
        <div>
          <div class="flex items-center gap-3">
            <h1 class="font-serif text-2xl sm:text-3xl font-normal text-[#f4f1ea] leading-none">
              Libro de Sala & Reservas
            </h1>
            <span class="hidden sm:inline-block px-2.5 py-0.5 text-[9px] tracking-[0.22em] uppercase border border-[#d4af37]/40 text-[#d4af37]">
              SESIÓN ACTIVA
            </span>
          </div>
          <p class="text-[11px] text-neutral-400 mt-1">
            <%= restaurant.name %> · <%= restaurant.address.street %> (<%= adminUser %>)
          </p>
        </div>
      </div>

      <div class="flex items-center gap-4">
        <a href="/" class="hidden sm:inline-flex lm-btn-outline py-2.5 px-5 text-[10px]">
          WEB PÚBLICA
        </a>

        <form action="/admin/logout" method="POST" class="inline">
          <button
            type="submit"
            class="px-5 py-2.5 text-[10px] tracking-[0.22em] uppercase font-medium bg-red-950/60 hover:bg-red-900 text-red-200 border border-red-500/40 transition-colors cursor-pointer"
          >
            CERRAR SESIÓN
          </button>
        </form>
      </div>
    </div>
  </header>

  <main class="flex-1 max-w-7xl w-full mx-auto px-6 lg:px-10 py-12 space-y-10">

    <!-- 1. Indicadores KPI de Sala -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      <div class="bg-[#111115] border border-white/10 p-6">
        <span class="text-[10px] tracking-[0.24em] uppercase text-neutral-400 block">RESERVAS ACTIVAS</span>
        <span id="kpi-total" class="font-serif text-4xl text-[#f4f1ea] mt-2 block"><%= stats.totalReservations %></span>
      </div>

      <div class="bg-[#111115] border border-white/10 p-6">
        <span class="text-[10px] tracking-[0.24em] uppercase text-neutral-400 block">SERVICIO DE HOY</span>
        <span id="kpi-today" class="font-serif text-4xl text-[#d4af37] mt-2 block"><%= stats.todayReservations %></span>
      </div>

      <div class="bg-[#111115] border border-white/10 p-6">
        <span class="text-[10px] tracking-[0.24em] uppercase text-neutral-400 block">COMENSALES PREVISTOS</span>
        <span id="kpi-guests" class="font-serif text-4xl text-[#f4f1ea] mt-2 block"><%= stats.totalGuests %></span>
      </div>

      <div class="bg-[#111115] border border-white/10 p-6">
        <span class="text-[10px] tracking-[0.24em] uppercase text-neutral-400 block">SERVICIOS COMPLETADOS</span>
        <span id="kpi-completed" class="font-serif text-4xl text-neutral-300 mt-2 block"><%= stats.completedReservations %></span>
      </div>
    </div>

    <!-- 2. Filtros y Alta Telefónica -->
    <div class="bg-[#111115] border border-white/10 p-6 flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-4">
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 flex-1">
        <input
          id="admin-search-input"
          type="text"
          placeholder="Buscar por titular, teléfono, correo o código LM-2026..."
          class="lm-input flex-1 py-2.5"
        />

        <input id="admin-date-filter" type="date" class="lm-input sm:w-48 py-2.5" />

        <select id="admin-status-filter" class="lm-input sm:w-48 py-2.5">
          <option value="all">Todos los estados</option>
          <option value="confirmed">Confirmadas</option>
          <option value="completed">Completadas</option>
          <option value="cancelled">Canceladas</option>
        </select>
      </div>

      <div class="flex items-center gap-3">
        <button id="admin-refresh-btn" type="button" class="lm-btn-outline py-2.5 px-5 text-[10px]">
          SINCRONIZAR
        </button>
        <button id="open-manual-modal-btn" type="button" class="lm-btn-gold py-2.5 px-5 text-[10px]">
          + RESERVA TELEFÓNICA
        </button>
      </div>
    </div>

    <!-- 3. Tabla de Reservas en Tiempo Real -->
    <div class="bg-[#111115] border border-white/10 overflow-hidden shadow-2xl">
      <div class="px-6 py-5 border-b border-white/10 flex items-center justify-between">
        <div>
          <h2 class="font-serif text-2xl font-normal text-[#f4f1ea]">
            Registro Oficial de Reservas
          </h2>
          <p class="text-[11px] text-neutral-500 mt-0.5">
            Persistencia en tiempo real (<code class="text-[#d4af37]">lamontana.db</code>)
          </p>
        </div>
        <span id="table-count-badge" class="text-[10px] tracking-[0.22em] uppercase px-3 py-1 border border-[#d4af37]/40 text-[#d4af37]">
          <%= reservations.length %> REGISTROS
        </span>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="border-b border-white/10 bg-[#0a0a0c] text-[10px] tracking-[0.2em] uppercase text-neutral-400">
              <th class="py-4 px-5 font-medium">Localizador</th>
              <th class="py-4 px-5 font-medium">Fecha y Hora</th>
              <th class="py-4 px-5 font-medium">Titular y Contacto</th>
              <th class="py-4 px-5 font-medium">Mesa / Salón</th>
              <th class="py-4 px-5 font-medium">Indicaciones de Sala</th>
              <th class="py-4 px-5 font-medium">Estado</th>
              <th class="py-4 px-5 font-medium text-right">Gestión</th>
            </tr>
          </thead>
          <tbody id="admin-reservations-tbody" class="divide-y divide-white/5 text-xs">
            <% if (reservations.length === 0) { %>
              <tr>
                <td colspan="7" class="py-12 text-center text-neutral-500">
                  No existen reservas registradas con los criterios actuales.
                </td>
              </tr>
            <% } else { %>
              <% reservations.forEach(function(r) { %>
                <tr class="hover:bg-white/[0.02] transition-colors <%= r.status === 'cancelled' ? 'opacity-45' : '' %>">
                  <td class="py-4 px-5 whitespace-nowrap">
                    <span class="font-mono text-xs text-[#d4af37] border border-[#d4af37]/30 px-2.5 py-1">
                      <%= r.reservation_code %>
                    </span>
                  </td>
                  <td class="py-4 px-5 whitespace-nowrap">
                    <span class="block text-[#f4f1ea] font-normal"><%= r.reservation_date %></span>
                    <span class="block text-[#d4af37] mt-0.5"><%= r.reservation_time %> h</span>
                  </td>
                  <td class="py-4 px-5">
                    <span class="block text-sm text-[#f4f1ea] font-normal <%= r.status === 'completed' ? 'line-through text-neutral-500' : '' %>">
                      <%= r.customer_name %>
                    </span>
                    <a href="tel:<%= r.customer_phone %>" class="block text-neutral-400 hover:text-[#d4af37] mt-0.5">
                      <%= r.customer_phone %>
                    </a>
                    <span class="block text-[11px] text-neutral-500"><%= r.customer_email %></span>
                  </td>
                  <td class="py-4 px-5 whitespace-nowrap">
                    <span class="text-[#f4f1ea] font-normal"><%= r.guests %> comensales</span>
                    <span class="block text-neutral-400 mt-0.5"><%= r.dining_area_name %></span>
                  </td>
                  <td class="py-4 px-5 max-w-xs">
                    <% if (r.notes) { %>
                      <p class="text-neutral-300 italic">“<%= r.notes %>”</p>
                    <% } else { %>
                      <span class="text-neutral-600">Sin observaciones</span>
                    <% } %>
                    <% if (r.preselected_dishes && r.preselected_dishes.length > 0) { %>
                      <div class="mt-1.5 flex flex-wrap gap-1">
                        <% r.preselected_dishes.forEach(function(d) { %>
                          <span class="px-2 py-0.5 text-[10px] border border-[#d4af37]/30 text-[#d4af37]">
                            <%= d %>
                          </span>
                        <% }); %>
                      </div>
                    <% } %>
                  </td>
                  <td class="py-4 px-5 whitespace-nowrap">
                    <% if (r.status === 'confirmed') { %>
                      <span class="px-2.5 py-1 text-[10px] tracking-[0.16em] uppercase border border-emerald-500/40 text-emerald-300">
                        Confirmada
                      </span>
                    <% } else if (r.status === 'completed') { %>
                      <span class="px-2.5 py-1 text-[10px] tracking-[0.16em] uppercase border border-[#d4af37]/40 text-[#d4af37]">
                        Completada
                      </span>
                    <% } else { %>
                      <span class="px-2.5 py-1 text-[10px] tracking-[0.16em] uppercase border border-red-500/40 text-red-300">
                        Cancelada
                      </span>
                    <% } %>
                  </td>
                  <td class="py-4 px-5 whitespace-nowrap text-right">
                    <div class="inline-flex items-center gap-1.5">
                      <% if (r.status !== 'completed') { %>
                        <button
                          type="button"
                          data-action="status"
                          data-id="<%= r.id %>"
                          data-status="completed"
                          class="admin-action-btn px-2.5 py-1 text-[10px] tracking-wider uppercase border border-emerald-500/40 text-emerald-300 hover:bg-emerald-950/50 transition"
                        >
                          Completar
                        </button>
                      <% } %>
                      <% if (r.status !== 'confirmed') { %>
                        <button
                          type="button"
                          data-action="status"
                          data-id="<%= r.id %>"
                          data-status="confirmed"
                          class="admin-action-btn px-2.5 py-1 text-[10px] tracking-wider uppercase border border-white/20 text-[#e5e5e5] hover:border-[#d4af37] transition"
                        >
                          Confirmar
                        </button>
                      <% } %>
                      <% if (r.status !== 'cancelled') { %>
                        <button
                          type="button"
                          data-action="status"
                          data-id="<%= r.id %>"
                          data-status="cancelled"
                          class="admin-action-btn px-2.5 py-1 text-[10px] tracking-wider uppercase border border-amber-500/40 text-amber-300 hover:bg-amber-950/40 transition"
                        >
                          Cancelar
                        </button>
                      <% } %>
                      <button
                        type="button"
                        data-action="delete"
                        data-id="<%= r.id %>"
                        class="admin-action-btn px-2.5 py-1 text-[10px] tracking-wider uppercase border border-red-500/40 text-red-300 hover:bg-red-950/50 transition"
                      >
                        Eliminar
                      </button>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </main>

  <!-- Modal para Reserva Telefónica Directa -->
  <div id="manual-reservation-modal" class="hidden fixed inset-0 z-50 bg-black/85 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-[#111115] border border-white/15 max-w-lg w-full p-8 shadow-2xl space-y-6">
      <div class="flex items-center justify-between border-b border-white/10 pb-4">
        <div>
          <span class="text-[9px] tracking-[0.28em] uppercase text-[#d4af37] block">REGISTRO DE MAÎTRE</span>
          <h3 class="font-serif text-2xl text-[#f4f1ea]">Nueva Reserva Telefónica</h3>
        </div>
        <button id="close-manual-modal-btn" type="button" class="text-neutral-400 hover:text-white text-xs tracking-widest">CERRAR ✕</button>
      </div>

      <form id="manual-reservation-form" class="space-y-4">
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="lm-label">Fecha *</label>
            <input id="manual-date" type="date" required class="lm-input py-2.5" />
          </div>
          <div>
            <label class="lm-label">Hora *</label>
            <select id="manual-time" class="lm-input py-2.5">
              <% timeSlots.forEach(function(slot) { %>
                <option value="<%= slot %>"><%= slot %> h</option>
              <% }); %>
            </select>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="lm-label">Comensales *</label>
            <input id="manual-guests" type="number" min="1" max="25" value="2" required class="lm-input py-2.5" />
          </div>
          <div>
            <label class="lm-label">Salón *</label>
            <select id="manual-area" class="lm-input py-2.5">
              <% restaurant.diningAreas.forEach(function(a) { %>
                <option value="<%= a.id %>"><%= a.name %></option>
              <% }); %>
            </select>
          </div>
        </div>

        <div>
          <label class="lm-label">Titular *</label>
          <input id="manual-name" type="text" required placeholder="Nombre y apellidos" class="lm-input py-2.5" />
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="lm-label">Teléfono *</label>
            <input id="manual-phone" type="tel" required placeholder="+34 600 000 000" class="lm-input py-2.5" />
          </div>
          <div>
            <label class="lm-label">Correo</label>
            <input id="manual-email" type="email" placeholder="cliente@correo.es" class="lm-input py-2.5" />
          </div>
        </div>

        <div>
          <label class="lm-label">Observaciones de Sala</label>
          <input id="manual-notes" type="text" placeholder="Alergias, mesa preferida..." class="lm-input py-2.5" />
        </div>

        <div class="pt-4 flex justify-end gap-3">
          <button id="cancel-manual-modal-btn" type="button" class="lm-btn-outline py-2.5 px-5 text-[10px]">
            CANCELAR
          </button>
          <button type="submit" class="lm-btn-gold py-2.5 px-6 text-[10px]">
            REGISTRAR RESERVA
          </button>
        </div>
      </form>
    </div>
  </div>

  <script src="/js/admin.js"></script>
</body>
</html>
