<!DOCTYPE html>
<html lang="es" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Panel de Gestión de Reservas — <%= restaurant.name %> (/admin)</title>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            obsidian: '#09090b'
          },
          fontFamily: {
            serif: ["'Cormorant Garamond'", 'Georgia', 'serif'],
            sans: ["'Plus Jakarta Sans'", 'system-ui', 'sans-serif']
          }
        }
      }
    };
  </script>
  <link rel="stylesheet" href="/css/luxury.css" />
</head>
<body class="bg-[#09090b] text-stone-100 font-sans min-h-screen flex flex-col">

  <!-- =========================================================================
       BARRA SUPERIOR DEL PANEL PRIVADO (CON BOTÓN CERRAR SESIÓN)
  ========================================================================= -->
  <header class="backdrop-blur-md bg-stone-950/85 sticky top-0 z-50 border-b border-stone-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between gap-4">
      <div class="flex items-center gap-3.5">
        <div class="w-10 h-10 rounded-full bg-stone-900 border border-amber-500/40 flex items-center justify-center">
          <span class="font-serif text-lg font-bold text-amber-500">LM</span>
        </div>
        <div>
          <div class="flex items-center gap-2.5">
            <h1 class="font-serif text-2xl sm:text-3xl font-semibold text-stone-50 leading-none">
              Control de Sala & Reservas
            </h1>
            <span class="hidden sm:inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] uppercase tracking-widest font-semibold bg-emerald-500/15 text-emerald-400 border border-emerald-500/30">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
              Sesión Protegida
            </span>
          </div>
          <p class="text-[11px] text-stone-400 mt-1">
            <%= restaurant.name %> · <%= restaurant.address.street %> (<%= adminUser %>)
          </p>
        </div>
      </div>

      <!-- Acciones de Cabecera y Botón Claro de Cerrar Sesión -->
      <div class="flex items-center gap-3">
        <a
          href="/"
          class="hidden sm:inline-flex items-center gap-2 px-4 py-2.5 rounded-xl text-xs font-medium text-stone-300 hover:text-amber-400 bg-stone-900 border border-stone-800 hover:border-amber-500/40 transition-all duration-300"
        >
          <span>🌐 Ver Web Pública</span>
        </a>

        <form action="/admin/logout" method="POST" class="inline">
          <button
            type="submit"
            class="px-5 py-2.5 rounded-xl text-xs uppercase tracking-[0.14em] font-bold bg-red-950/80 hover:bg-red-900 text-red-200 border border-red-500/40 transition-all duration-300 ease-in-out flex items-center gap-2"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
            </svg>
            <span>Cerrar Sesión</span>
          </button>
        </form>
      </div>
    </div>
  </header>

  <!-- =========================================================================
       CONTENIDO PRINCIPAL DEL DASHBOARD
  ========================================================================= -->
  <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-8">

    <!-- 1. TARJETAS KPI EN TIEMPO REAL -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      <div class="bg-stone-950 border border-stone-800 rounded-2xl p-6 flex items-center justify-between">
        <div>
          <span class="text-[11px] uppercase tracking-[0.18em] text-stone-400 font-semibold block">Reservas Activas</span>
          <span id="kpi-total" class="font-serif text-4xl font-bold text-stone-50 mt-1 block"><%= stats.totalReservations %></span>
        </div>
        <div class="w-12 h-12 rounded-2xl bg-amber-500/10 border border-amber-500/30 text-amber-400 flex items-center justify-center text-xl">
          📋
        </div>
      </div>

      <div class="bg-stone-950 border border-stone-800 rounded-2xl p-6 flex items-center justify-between">
        <div>
          <span class="text-[11px] uppercase tracking-[0.18em] text-stone-400 font-semibold block">Mesas para Hoy</span>
          <span id="kpi-today" class="font-serif text-4xl font-bold text-amber-500 mt-1 block"><%= stats.todayReservations %></span>
        </div>
        <div class="w-12 h-12 rounded-2xl bg-amber-500/10 border border-amber-500/30 text-amber-400 flex items-center justify-center text-xl">
          📅
        </div>
      </div>

      <div class="bg-stone-950 border border-stone-800 rounded-2xl p-6 flex items-center justify-between">
        <div>
          <span class="text-[11px] uppercase tracking-[0.18em] text-stone-400 font-semibold block">Comensales Previstos</span>
          <span id="kpi-guests" class="font-serif text-4xl font-bold text-emerald-400 mt-1 block"><%= stats.totalGuests %></span>
        </div>
        <div class="w-12 h-12 rounded-2xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 flex items-center justify-center text-xl">
          👥
        </div>
      </div>

      <div class="bg-stone-950 border border-stone-800 rounded-2xl p-6 flex items-center justify-between">
        <div>
          <span class="text-[11px] uppercase tracking-[0.18em] text-stone-400 font-semibold block">Servicios Completados</span>
          <span id="kpi-completed" class="font-serif text-4xl font-bold text-stone-200 mt-1 block"><%= stats.completedReservations %></span>
        </div>
        <div class="w-12 h-12 rounded-2xl bg-stone-900 border border-stone-700 text-stone-300 flex items-center justify-center text-xl">
          ✓
        </div>
      </div>
    </div>

    <!-- 2. BARRA DE FILTROS, BÚSQUEDA Y CREACIÓN MANUAL -->
    <div class="bg-stone-950 border border-stone-800 rounded-2xl p-5 flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-4">
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 flex-1">
        <!-- Buscador -->
        <div class="relative flex-1">
          <input
            id="admin-search-input"
            type="text"
            placeholder="Buscar por cliente, teléfono, email o código LM-2026..."
            class="w-full pl-10 pr-4 py-2.5 rounded-xl bg-[#09090b] border border-stone-800 text-sm text-stone-100 placeholder-stone-500 focus:outline-none focus:border-amber-500 transition-all duration-300"
          />
          <span class="absolute left-3.5 top-2.5 text-stone-500">🔍</span>
        </div>

        <!-- Filtro de Fecha -->
        <input
          id="admin-date-filter"
          type="date"
          class="px-4 py-2.5 rounded-xl bg-[#09090b] border border-stone-800 text-sm text-stone-200 focus:outline-none focus:border-amber-500 transition-all duration-300"
        />

        <!-- Filtro de Estado -->
        <select
          id="admin-status-filter"
          class="px-4 py-2.5 rounded-xl bg-[#09090b] border border-stone-800 text-sm text-stone-200 focus:outline-none focus:border-amber-500 transition-all duration-300"
        >
          <option value="all">Todos los estados</option>
          <option value="confirmed">Confirmadas</option>
          <option value="completed">Completadas</option>
          <option value="cancelled">Canceladas</option>
        </select>
      </div>

      <div class="flex items-center gap-3">
        <button
          id="admin-refresh-btn"
          type="button"
          class="px-4 py-2.5 rounded-xl bg-stone-900 hover:bg-stone-800 text-stone-200 border border-stone-700 text-xs uppercase tracking-wider font-semibold transition-all duration-300 flex items-center gap-2"
        >
          <span id="refresh-icon">↻</span>
          <span>Sincronizar</span>
        </button>

        <button
          id="open-manual-modal-btn"
          type="button"
          class="btn-shine px-5 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-stone-950 text-xs uppercase tracking-wider font-bold transition-all duration-300"
        >
          + Nueva Reserva Telefónica
        </button>
      </div>
    </div>

    <!-- 3. TABLA MODERNA Y LIMPIA CON TODAS LAS RESERVAS EN TIEMPO REAL -->
    <div class="bg-stone-950 border border-stone-800 rounded-3xl overflow-hidden shadow-2xl">
      <div class="px-6 py-5 border-b border-stone-800 flex items-center justify-between">
        <div>
          <h2 class="font-serif text-2xl font-semibold text-stone-50">
            Libro de Reservas en Tiempo Real
          </h2>
          <p class="text-xs text-stone-400 mt-0.5">
            Base de datos SQLite persistente (<code class="text-amber-500">lamontana.db</code>)
          </p>
        </div>
        <span id="table-count-badge" class="px-3.5 py-1 rounded-full text-xs font-semibold bg-stone-900 text-amber-400 border border-stone-800">
          <%= reservations.length %> registros
        </span>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="border-b border-stone-800/90 bg-[#09090b]/60 text-[11px] uppercase tracking-[0.16em] text-stone-400">
              <th class="py-4 px-5 font-semibold">Código</th>
              <th class="py-4 px-5 font-semibold">Fecha y Turno</th>
              <th class="py-4 px-5 font-semibold">Cliente & Contacto</th>
              <th class="py-4 px-5 font-semibold">Mesa / Salón</th>
              <th class="py-4 px-5 font-semibold">Notas & Preselección</th>
              <th class="py-4 px-5 font-semibold">Estado</th>
              <th class="py-4 px-5 font-semibold text-right">Acciones</th>
            </tr>
          </thead>
          <tbody id="admin-reservations-tbody" class="divide-y divide-stone-800/70 text-sm">
            <% if (reservations.length === 0) { %>
              <tr>
                <td colspan="7" class="py-12 text-center text-stone-500">
                  No hay reservas registradas con los filtros actuales.
                </td>
              </tr>
            <% } else { %>
              <% reservations.forEach(function(r) { %>
                <tr class="hover:bg-stone-900/50 transition-colors duration-200 <%= r.status === 'cancelled' ? 'opacity-50' : '' %>">
                  <td class="py-4 px-5 whitespace-nowrap">
                    <span class="font-mono text-xs font-bold text-amber-400 bg-amber-500/10 border border-amber-500/30 px-2.5 py-1 rounded-lg">
                      <%= r.reservation_code %>
                    </span>
                  </td>
                  <td class="py-4 px-5 whitespace-nowrap">
                    <span class="block font-semibold text-stone-100"><%= r.reservation_date %></span>
                    <span class="block text-xs text-amber-400 font-medium"><%= r.reservation_time %> h</span>
                  </td>
                  <td class="py-4 px-5">
                    <span class="block font-semibold text-stone-100 <%= r.status === 'completed' ? 'line-through text-stone-400' : '' %>">
                      <%= r.customer_name %>
                    </span>
                    <a href="tel:<%= r.customer_phone %>" class="block text-xs text-stone-400 hover:text-amber-400">
                      <%= r.customer_phone %>
                    </a>
                    <span class="block text-[11px] text-stone-500"><%= r.customer_email %></span>
                  </td>
                  <td class="py-4 px-5 whitespace-nowrap">
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-stone-900 border border-stone-800 text-xs font-semibold text-stone-200">
                      👥 <%= r.guests %> pax
                    </span>
                    <span class="block text-xs text-stone-400 mt-1"><%= r.dining_area_name %></span>
                  </td>
                  <td class="py-4 px-5 max-w-xs">
                    <% if (r.notes) { %>
                      <p class="text-xs text-stone-300 italic">“<%= r.notes %>”</p>
                    <% } else { %>
                      <span class="text-xs text-stone-600">Sin observaciones</span>
                    <% } %>
                    <% if (r.preselected_dishes && r.preselected_dishes.length > 0) { %>
                      <div class="mt-1.5 flex flex-wrap gap-1">
                        <% r.preselected_dishes.forEach(function(d) { %>
                          <span class="px-2 py-0.5 rounded text-[10px] bg-amber-500/10 text-amber-300 border border-amber-500/20">
                            <%= d %>
                          </span>
                        <% }); %>
                      </div>
                    <% } %>
                  </td>
                  <td class="py-4 px-5 whitespace-nowrap">
                    <% if (r.status === 'confirmed') { %>
                      <span class="px-3 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider bg-emerald-500/15 text-emerald-400 border border-emerald-500/30">
                        Confirmada
                      </span>
                    <% } else if (r.status === 'completed') { %>
                      <span class="px-3 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider bg-amber-500/15 text-amber-300 border border-amber-500/30">
                        Completada
                      </span>
                    <% } else { %>
                      <span class="px-3 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider bg-red-500/15 text-red-300 border border-red-500/30">
                        Cancelada
                      </span>
                    <% } %>
                  </td>
                  <td class="py-4 px-5 whitespace-nowrap text-right">
                    <div class="inline-flex items-center gap-1.5">
                      <% if (r.status !== 'completed') { %>
                        <button
                          type="button"
                          data-action="status"
                          data-id="<%= r.id %>"
                          data-status="completed"
                          class="admin-action-btn px-2.5 py-1.5 rounded-lg bg-emerald-950/80 hover:bg-emerald-800 text-emerald-300 border border-emerald-500/30 text-xs font-semibold transition"
                          title="Marcar mesa como atendida/completada"
                        >
                          ✓ Completar
                        </button>
                      <% } %>
                      <% if (r.status !== 'confirmed') { %>
                        <button
                          type="button"
                          data-action="status"
                          data-id="<%= r.id %>"
                          data-status="confirmed"
                          class="admin-action-btn px-2.5 py-1.5 rounded-lg bg-stone-900 hover:bg-stone-800 text-amber-400 border border-stone-700 text-xs font-semibold transition"
                          title="Reactivar como confirmada"
                        >
                          ↺ Confirmar
                        </button>
                      <% } %>
                      <% if (r.status !== 'cancelled') { %>
                        <button
                          type="button"
                          data-action="status"
                          data-id="<%= r.id %>"
                          data-status="cancelled"
                          class="admin-action-btn px-2.5 py-1.5 rounded-lg bg-amber-950/60 hover:bg-amber-900 text-amber-300 border border-amber-500/30 text-xs font-semibold transition"
                          title="Cancelar reserva y liberar plazas"
                        >
                          ✕ Cancelar
                        </button>
                      <% } %>
                      <button
                        type="button"
                        data-action="delete"
                        data-id="<%= r.id %>"
                        class="admin-action-btn px-2.5 py-1.5 rounded-lg bg-red-950/60 hover:bg-red-900 text-red-300 border border-red-500/30 text-xs font-semibold transition"
                        title="Eliminar registro permanentemente"
                      >
                        🗑️
                      </button>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </main>

  <!-- =========================================================================
       MODAL PARA CREAR RESERVA TELEFÓNICA / PRESENCIAL MANUALMENTE
  ========================================================================= -->
  <div id="manual-reservation-modal" class="hidden fixed inset-0 z-50 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-stone-950 border border-stone-800 rounded-3xl max-w-lg w-full p-7 sm:p-8 shadow-2xl space-y-6 animate-fade-up">
      <div class="flex items-center justify-between border-b border-stone-800 pb-4">
        <div>
          <span class="text-[10px] uppercase tracking-[0.22em] text-amber-500 font-semibold block">Registro Directo de Sala</span>
          <h3 class="font-serif text-2xl font-semibold text-stone-50">Nueva Reserva Telefónica</h3>
        </div>
        <button id="close-manual-modal-btn" type="button" class="text-stone-400 hover:text-stone-100 text-lg font-bold">✕</button>
      </div>

      <form id="manual-reservation-form" class="space-y-4">
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-[11px] uppercase tracking-wider text-stone-400 font-semibold mb-1.5">Fecha *</label>
            <input id="manual-date" type="date" required class="w-full px-3.5 py-2.5 rounded-xl bg-[#09090b] border border-stone-800 text-sm text-stone-100 focus:outline-none focus:border-amber-500" />
          </div>
          <div>
            <label class="block text-[11px] uppercase tracking-wider text-stone-400 font-semibold mb-1.5">Hora *</label>
            <select id="manual-time" class="w-full px-3.5 py-2.5 rounded-xl bg-[#09090b] border border-stone-800 text-sm text-stone-100 focus:outline-none focus:border-amber-500">
              <% timeSlots.forEach(function(slot) { %>
                <option value="<%= slot %>"><%= slot %> h</option>
              <% }); %>
            </select>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-[11px] uppercase tracking-wider text-stone-400 font-semibold mb-1.5">Comensales *</label>
            <input id="manual-guests" type="number" min="1" max="25" value="2" required class="w-full px-3.5 py-2.5 rounded-xl bg-[#09090b] border border-stone-800 text-sm text-stone-100 focus:outline-none focus:border-amber-500" />
          </div>
          <div>
            <label class="block text-[11px] uppercase tracking-wider text-stone-400 font-semibold mb-1.5">Salón *</label>
            <select id="manual-area" class="w-full px-3.5 py-2.5 rounded-xl bg-[#09090b] border border-stone-800 text-sm text-stone-100 focus:outline-none focus:border-amber-500">
              <% restaurant.diningAreas.forEach(function(a) { %>
                <option value="<%= a.id %>"><%= a.name %></option>
              <% }); %>
            </select>
          </div>
        </div>

        <div>
          <label class="block text-[11px] uppercase tracking-wider text-stone-400 font-semibold mb-1.5">Nombre del Cliente *</label>
          <input id="manual-name" type="text" required placeholder="Nombre y apellidos" class="w-full px-3.5 py-2.5 rounded-xl bg-[#09090b] border border-stone-800 text-sm text-stone-100 focus:outline-none focus:border-amber-500" />
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-[11px] uppercase tracking-wider text-stone-400 font-semibold mb-1.5">Teléfono *</label>
            <input id="manual-phone" type="tel" required placeholder="+34 600 000 000" class="w-full px-3.5 py-2.5 rounded-xl bg-[#09090b] border border-stone-800 text-sm text-stone-100 focus:outline-none focus:border-amber-500" />
          </div>
          <div>
            <label class="block text-[11px] uppercase tracking-wider text-stone-400 font-semibold mb-1.5">Email (Opcional)</label>
            <input id="manual-email" type="email" placeholder="cliente@correo.es" class="w-full px-3.5 py-2.5 rounded-xl bg-[#09090b] border border-stone-800 text-sm text-stone-100 focus:outline-none focus:border-amber-500" />
          </div>
        </div>

        <div>
          <label class="block text-[11px] uppercase tracking-wider text-stone-400 font-semibold mb-1.5">Notas / Alergias</label>
          <input id="manual-notes" type="text" placeholder="Preferencia de mesa, alergias..." class="w-full px-3.5 py-2.5 rounded-xl bg-[#09090b] border border-stone-800 text-sm text-stone-100 focus:outline-none focus:border-amber-500" />
        </div>

        <div class="pt-3 flex justify-end gap-3">
          <button id="cancel-manual-modal-btn" type="button" class="px-5 py-2.5 rounded-xl bg-stone-900 text-stone-300 text-xs font-semibold">
            Cancelar
          </button>
          <button type="submit" class="btn-shine px-6 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-stone-950 text-xs uppercase tracking-wider font-bold">
            Guardar Reserva
          </button>
        </div>
      </form>
    </div>
  </div>

  <script src="/js/admin.js"></script>
</body>
</html>
