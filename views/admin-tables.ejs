<!DOCTYPE html>
<html lang="es" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Gestión de Mesas y Espacios — <%= restaurant.name %></title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Montserrat:wght@300;400;500;600&family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/luxury.css" />
</head>
<body class="bg-[#050506] text-[#f4f4f5] font-sans font-light min-h-screen flex flex-col">

  <!-- Cabecera del Panel Privado con Navegación de Módulos (100% Responsiva) -->
  <header class="lm-navbar backdrop-blur-md bg-stone-950/80 sticky top-0 z-50 border-b border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-10 h-20 sm:h-24 flex items-center justify-between gap-3">
      <div class="flex items-center gap-3 sm:gap-4 min-w-0">
        <span class="lm-monogram-seal"><%= restaurant.monogram %></span>
        <div class="min-w-0">
          <div class="flex items-center gap-2.5">
            <h1 class="font-serif text-xl sm:text-2xl lg:text-3xl font-normal text-[#f4f1ea] leading-none truncate">
              Gestión de Espacios y Mesas
            </h1>
            <span class="hidden sm:inline-block px-2.5 py-0.5 text-[9px] tracking-[0.22em] uppercase border border-[#d4af37]/40 text-[#d4af37] shrink-0">
              PLANO DE SALA
            </span>
          </div>
          <p class="text-[10px] sm:text-[11px] text-neutral-400 mt-1 truncate">
            <%= restaurant.name %> · <%= restaurant.address.street %> (<%= adminUser %>)
          </p>
        </div>
      </div>

      <!-- Pestañas de Módulos de Administración (Tablet/Escritorio md+) -->
      <nav class="hidden md:flex items-center gap-2 bg-[#111115] border border-white/10 p-1">
        <a
          href="/admin"
          class="px-4 py-2 text-[10px] tracking-[0.2em] uppercase font-medium text-neutral-300 hover:text-[#d4af37] transition"
        >
          LIBRO DE RESERVAS
        </a>
        <a
          href="/admin/mesas"
          class="px-4 py-2 text-[10px] tracking-[0.2em] uppercase font-medium bg-[#d4af37] text-[#050506] transition"
        >
          MAPA DE MESAS & SALONES
        </a>
      </nav>

      <div class="flex items-center gap-2 sm:gap-3 shrink-0">
        <a href="/" class="hidden sm:inline-flex lm-btn-outline py-2 px-4 text-[10px] min-h-[40px]">
          WEB PÚBLICA
        </a>

        <form action="/admin/logout" method="POST" class="inline">
          <button
            type="submit"
            class="min-h-[40px] px-3.5 sm:px-5 py-2 text-[10px] tracking-[0.2em] uppercase font-medium bg-red-950/60 hover:bg-red-900 text-red-200 border border-red-500/40 transition-colors cursor-pointer"
          >
            SALIR
          </button>
        </form>
      </div>
    </div>

    <!-- Barra Táctil Inferior de Módulos para Smartphones (< md) -->
    <div class="md:hidden grid grid-cols-3 border-t border-white/10 bg-[#0d0d10] text-center">
      <a
        href="/admin"
        class="py-3 text-[10px] tracking-[0.18em] uppercase font-medium text-neutral-300 hover:text-[#d4af37]"
      >
        RESERVAS
      </a>
      <a
        href="/admin/mesas"
        class="py-3 text-[10px] tracking-[0.18em] uppercase font-medium bg-[#d4af37] text-[#050506] border-x border-white/10"
      >
        MAPA MESAS
      </a>
      <a
        href="/"
        class="py-3 text-[10px] tracking-[0.18em] uppercase font-medium text-neutral-400 hover:text-[#f4f1ea]"
      >
        WEB PÚBLICA
      </a>
    </div>
  </header>

  <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-10 py-8 sm:py-12 space-y-8 sm:space-y-10">

    <!-- 1. KPIs de Capacidad y Estado de Mesas en Tiempo Real -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3.5 sm:gap-4">
      <div class="bg-[#111115] border border-white/10 p-4 sm:p-5">
        <span class="text-[9px] tracking-[0.2em] uppercase text-neutral-400 block">TOTAL MESAS</span>
        <span id="stat-total-tables" class="font-serif text-3xl text-[#f4f1ea] mt-1.5 block"><%= tableStats.totalTables %></span>
      </div>

      <div class="bg-[#111115] border border-emerald-500/25 p-4 sm:p-5">
        <span class="text-[9px] tracking-[0.2em] uppercase text-emerald-400 block">MESAS LIBRES</span>
        <span id="stat-free-tables" class="font-serif text-3xl text-emerald-300 mt-1.5 block"><%= tableStats.freeTables %></span>
      </div>

      <div class="bg-[#111115] border border-[#d4af37]/30 p-4 sm:p-5">
        <span class="text-[9px] tracking-[0.2em] uppercase text-[#d4af37] block">RESERVADAS</span>
        <span id="stat-reserved-tables" class="font-serif text-3xl text-[#d4af37] mt-1.5 block"><%= tableStats.reservedTables %></span>
      </div>

      <div class="bg-[#111115] border border-red-500/30 p-4 sm:p-5">
        <span class="text-[9px] tracking-[0.2em] uppercase text-red-300 block">OCUPADAS EN SALA</span>
        <span id="stat-occupied-tables" class="font-serif text-3xl text-red-300 mt-1.5 block"><%= tableStats.occupiedTables %></span>
      </div>

      <div class="bg-[#111115] border border-neutral-500/30 p-4 sm:p-5">
        <span class="text-[9px] tracking-[0.2em] uppercase text-neutral-400 block">MANTENIMIENTO</span>
        <span id="stat-maintenance-tables" class="font-serif text-3xl text-neutral-400 mt-1.5 block"><%= tableStats.maintenanceTables %></span>
      </div>

      <div class="bg-[#111115] border border-white/10 p-4 sm:p-5">
        <span class="text-[9px] tracking-[0.2em] uppercase text-neutral-400 block">AFORO TOTAL SALA</span>
        <div class="flex items-baseline gap-1.5 mt-1.5">
          <span id="stat-total-capacity" class="font-serif text-3xl text-[#f4f1ea]"><%= tableStats.totalCapacity %></span>
          <span class="text-[10px] text-neutral-500">plazas</span>
        </div>
      </div>
    </div>

    <!-- 2. Barra de Controles Táctiles: Filtro por Salón, Estado y Alta de Nueva Mesa -->
    <div class="bg-[#111115] border border-white/10 p-4 sm:p-6 flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-4">
      <div class="lm-touch-scroll no-scrollbar flex items-center gap-2 pb-1 lg:pb-0">
        <button
          type="button"
          data-zone-filter="all"
          class="zone-filter-btn shrink-0 min-h-[40px] px-4 py-2 text-[10px] tracking-[0.18em] uppercase font-medium bg-[#d4af37] text-[#050506] transition"
        >
          TODOS LOS ESPACIOS
        </button>
        <% zones.forEach(function(z) { %>
          <button
            type="button"
            data-zone-filter="<%= z.id %>"
            class="zone-filter-btn shrink-0 min-h-[40px] px-4 py-2 text-[10px] tracking-[0.18em] uppercase font-medium border border-white/10 text-neutral-300 hover:border-[#d4af37] transition"
          >
            <%= z.name %>
          </button>
        <% }); %>
      </div>

      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
        <select id="table-status-filter" class="lm-input sm:w-48 py-2 text-xs">
          <option value="all">Todos los estados</option>
          <option value="Libre">Estado: Libre</option>
          <option value="Reservada">Estado: Reservada</option>
          <option value="Ocupada">Estado: Ocupada</option>
          <option value="Mantenimiento">Estado: Mantenimiento</option>
        </select>

        <div class="grid grid-cols-2 sm:flex items-center gap-3">
          <button id="refresh-tables-btn" type="button" class="lm-btn-outline py-2.5 px-4 text-[10px] w-full sm:w-auto">
            ACTUALIZAR MAPA
          </button>

          <button id="open-new-table-modal-btn" type="button" class="lm-btn-gold py-2.5 px-5 text-[10px] w-full sm:w-auto">
            + AÑADIR NUEVA MESA
          </button>
        </div>
      </div>
    </div>

    <!-- Leyenda Visual de Estados -->
    <div class="flex flex-wrap items-center justify-between gap-4 px-2 text-[11px] text-neutral-400">
      <div class="flex flex-wrap items-center gap-6">
        <span class="inline-flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-400"></span>
          <span><strong class="text-[#f4f1ea] font-normal">Libre:</strong> Disponible para asignación inmediata</span>
        </span>
        <span class="inline-flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-[#d4af37]"></span>
          <span><strong class="text-[#f4f1ea] font-normal">Reservada:</strong> Vinculada a reserva confirmada</span>
        </span>
        <span class="inline-flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-red-400"></span>
          <span><strong class="text-[#f4f1ea] font-normal">Ocupada:</strong> Comensales actualmente en mesa</span>
        </span>
        <span class="inline-flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-neutral-500"></span>
          <span><strong class="text-[#f4f1ea] font-normal">Mantenimiento:</strong> Bloqueada temporalmente</span>
        </span>
      </div>
      <a href="/admin" class="text-[#d4af37] hover:underline tracking-wider uppercase text-[10px]">
        Ir a Asignación de Reservas →
      </a>
    </div>

    <!-- 3. Mapa Visual de Distribución de Mesas por Salón / Zona -->
    <div id="zones-map-container" class="space-y-12">
      <% zones.forEach(function(zone) { %>
        <% const zoneTables = tables.filter(function(t) { return t.zone_id === zone.id; }); %>
        <section
          class="zone-section bg-[#111115] border border-white/10 p-6 sm:p-8 shadow-2xl"
          data-zone-section="<%= zone.id %>"
        >
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-6 border-b border-white/10">
            <div>
              <div class="flex items-center gap-3">
                <span class="text-[10px] tracking-[0.26em] uppercase text-[#d4af37]">
                  <%= zone.architectural_style %>
                </span>
                <span class="px-2.5 py-0.5 text-[10px] border border-white/15 text-neutral-300">
                  <%= zoneTables.length %> mesas
                </span>
              </div>
              <h2 class="font-serif text-2xl sm:text-3xl text-[#f4f1ea] mt-1">
                <%= zone.name %>
              </h2>
              <p class="text-xs text-neutral-400 mt-1">
                <%= zone.description %>
              </p>
            </div>

            <div class="flex items-center gap-3 self-start md:self-center">
              <button
                type="button"
                data-QuickAddZone="<%= zone.id %>"
                class="quick-add-zone-btn lm-btn-outline py-2 px-4 text-[10px]"
              >
                + MESA EN ESTE SALÓN
              </button>
            </div>
          </div>

          <!-- Rejilla Arquitectónica de Mesas del Salón -->
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mt-8">
            <% zoneTables.forEach(function(table) { %>
              <%
                let borderClass = 'border-emerald-500/35';
                let badgeClass = 'border-emerald-500/40 text-emerald-300 bg-emerald-950/30';
                let dotClass = 'bg-emerald-400';
                if (table.status === 'Reservada') {
                  borderClass = 'border-[#d4af37]/50';
                  badgeClass = 'border-[#d4af37]/50 text-[#d4af37] bg-[#d4af37]/10';
                  dotClass = 'bg-[#d4af37]';
                } else if (table.status === 'Ocupada') {
                  borderClass = 'border-red-500/45';
                  badgeClass = 'border-red-500/45 text-red-300 bg-red-950/30';
                  dotClass = 'bg-red-400';
                } else if (table.status === 'Mantenimiento') {
                  borderClass = 'border-neutral-600/50 opacity-75';
                  badgeClass = 'border-neutral-500/40 text-neutral-400 bg-neutral-900';
                  dotClass = 'bg-neutral-500';
                }
              %>
              <article
                class="table-card bg-[#050506] border <%= borderClass %> p-6 flex flex-col justify-between transition-all hover:border-[#d4af37]"
                data-table-id="<%= table.id %>"
                data-zone-id="<%= table.zone_id %>"
                data-status="<%= table.status %>"
              >
                <div>
                  <!-- Cabecera de la Mesa: Número, Capacidad y Estado -->
                  <div class="flex items-start justify-between gap-3">
                    <div class="flex items-center gap-3">
                      <div class="w-12 h-12 rounded-sm border border-[#d4af37]/40 bg-[#111115] flex flex-col items-center justify-center">
                        <span class="font-mono text-sm font-medium text-[#f4f1ea]"><%= table.table_number %></span>
                        <span class="text-[9px] text-[#d4af37]"><%= table.capacity %> PAX</span>
                      </div>
                      <div>
                        <h3 class="font-serif text-xl text-[#f4f1ea]">Mesa <%= table.table_number %></h3>
                        <span class="text-[11px] text-neutral-400 block">
                          Capacidad máx.: <strong class="text-[#e5e5e5] font-normal"><%= table.capacity %> comensales</strong>
                        </span>
                      </div>
                    </div>

                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 text-[9px] tracking-[0.18em] uppercase border <%= badgeClass %>">
                      <span class="w-1.5 h-1.5 rounded-full <%= dotClass %>"></span>
                      <%= table.status %>
                    </span>
                  </div>

                  <!-- Notas de ubicación física -->
                  <p class="text-xs text-neutral-400 mt-4 pb-4 border-b border-white/5">
                    <%= table.notes || 'Ubicación estándar en sala' %>
                  </p>

                  <!-- Reserva Vinculada a esta Mesa (si existe) -->
                  <div class="mt-4 min-h-[64px] flex flex-col justify-center">
                    <% if (table.activeReservation) { %>
                      <div class="bg-[#111115] border border-[#d4af37]/30 p-3">
                        <div class="flex items-center justify-between text-[10px] text-[#d4af37] uppercase tracking-wider">
                          <span>RESERVA ASIGNADA</span>
                          <span class="font-mono"><%= table.activeReservation.reservation_code %></span>
                        </div>
                        <p class="text-xs text-[#f4f1ea] font-normal mt-1">
                          <%= table.activeReservation.customer_name %> (<%= table.activeReservation.guests %> pax)
                        </p>
                        <p class="text-[11px] text-neutral-400 mt-0.5">
                          <%= table.activeReservation.reservation_date %> · <%= table.activeReservation.reservation_time %> h
                        </p>
                      </div>
                    <% } else { %>
                      <div class="border border-dashed border-white/10 p-3 text-center">
                        <span class="text-[11px] text-neutral-500">Sin reserva asignada actualmente</span>
                      </div>
                    <% } %>
                  </div>
                </div>

                <!-- Controles Rápidos de Estado en Tiempo Real + Edición/Borrado -->
                <div class="mt-5 pt-4 border-t border-white/10 space-y-3">
                  <span class="text-[9px] tracking-[0.22em] uppercase text-neutral-500 block">
                    CAMBIAR ESTADO EN TIEMPO REAL
                  </span>
                  <div class="grid grid-cols-4 gap-1.5">
                    <button
                      type="button"
                      data-action="quick-status"
                      data-id="<%= table.id %>"
                      data-status="Libre"
                      class="px-2 py-1.5 text-[9px] tracking-wider uppercase border transition <%= table.status === 'Libre' ? 'border-emerald-400 bg-emerald-950/60 text-emerald-200' : 'border-white/10 text-neutral-400 hover:border-emerald-500/40 hover:text-emerald-300' %>"
                    >
                      Libre
                    </button>
                    <button
                      type="button"
                      data-action="quick-status"
                      data-id="<%= table.id %>"
                      data-status="Reservada"
                      class="px-2 py-1.5 text-[9px] tracking-wider uppercase border transition <%= table.status === 'Reservada' ? 'border-[#d4af37] bg-[#d4af37]/20 text-[#d4af37]' : 'border-white/10 text-neutral-400 hover:border-[#d4af37]/40 hover:text-[#d4af37]' %>"
                    >
                      Reserv.
                    </button>
                    <button
                      type="button"
                      data-action="quick-status"
                      data-id="<%= table.id %>"
                      data-status="Ocupada"
                      class="px-2 py-1.5 text-[9px] tracking-wider uppercase border transition <%= table.status === 'Ocupada' ? 'border-red-400 bg-red-950/60 text-red-200' : 'border-white/10 text-neutral-400 hover:border-red-500/40 hover:text-red-300' %>"
                    >
                      Ocupada
                    </button>
                    <button
                      type="button"
                      data-action="quick-status"
                      data-id="<%= table.id %>"
                      data-status="Mantenimiento"
                      class="px-2 py-1.5 text-[9px] tracking-wider uppercase border transition <%= table.status === 'Mantenimiento' ? 'border-neutral-400 bg-neutral-800 text-neutral-200' : 'border-white/10 text-neutral-400 hover:border-neutral-400' %>"
                    >
                      Mant.
                    </button>
                  </div>

                  <div class="flex items-center justify-between pt-2">
                    <button
                      type="button"
                      data-action="edit-table"
                      data-id="<%= table.id %>"
                      class="text-[10px] tracking-[0.18em] uppercase text-neutral-400 hover:text-[#d4af37] transition"
                    >
                      EDITAR MESA
                    </button>
                    <button
                      type="button"
                      data-action="delete-table"
                      data-id="<%= table.id %>"
                      data-number="<%= table.table_number %>"
                      class="text-[10px] tracking-[0.18em] uppercase text-red-400/80 hover:text-red-300 transition"
                    >
                      ELIMINAR
                    </button>
                  </div>
                </div>
              </article>
            <% }); %>
          </div>
        </section>
      <% }); %>
    </div>

  </main>

  <!-- Modal CRUD para Crear o Editar Mesa (100% Responsivo) -->
  <div id="table-crud-modal" class="hidden fixed inset-0 z-50 bg-black/85 backdrop-blur-sm flex items-center justify-center p-3 sm:p-4">
    <div class="bg-[#111115] border border-white/15 max-w-lg w-full max-h-[92dvh] overflow-y-auto p-5 sm:p-8 shadow-2xl space-y-6">
      <div class="flex items-center justify-between border-b border-white/10 pb-4">
        <div>
          <span class="text-[9px] tracking-[0.28em] uppercase text-[#d4af37] block">CONFIGURACIÓN DE SALA</span>
          <h3 id="table-modal-title" class="font-serif text-xl sm:text-2xl text-[#f4f1ea]">Añadir Nueva Mesa</h3>
        </div>
        <button id="close-table-modal-btn" type="button" class="min-h-[40px] px-2 text-neutral-400 hover:text-white text-xs tracking-widest">CERRAR ✕</button>
      </div>

      <div id="table-modal-error" class="hidden p-3 border border-red-500/40 bg-red-950/30 text-xs text-red-200"></div>

      <form id="table-crud-form" class="space-y-4">
        <input id="form-table-id" type="hidden" value="" />

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="lm-label" for="form-table-number">Número / Código de Mesa *</label>
            <input
              id="form-table-number"
              type="text"
              required
              placeholder="Ej. M-07, C-06, B-04"
              class="lm-input py-2.5 uppercase"
            />
          </div>
          <div>
            <label class="lm-label" for="form-table-capacity">Capacidad Máxima (Comensales) *</label>
            <select id="form-table-capacity" class="lm-input py-2.5">
              <option value="2">2 Comensales</option>
              <option value="4" selected>4 Comensales</option>
              <option value="6">6 Comensales</option>
              <option value="8">8 Comensales</option>
              <option value="10">10 Comensales (Mesa Imperial)</option>
              <option value="12">12 Comensales (Gran Gala)</option>
            </select>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="lm-label" for="form-table-zone">Zona / Salón *</label>
            <select id="form-table-zone" class="lm-input py-2.5">
              <% zones.forEach(function(z) { %>
                <option value="<%= z.id %>"><%= z.name %></option>
              <% }); %>
            </select>
          </div>
          <div>
            <label class="lm-label" for="form-table-status">Estado Inicial *</label>
            <select id="form-table-status" class="lm-input py-2.5">
              <option value="Libre">Libre</option>
              <option value="Reservada">Reservada</option>
              <option value="Ocupada">Ocupada</option>
              <option value="Mantenimiento">Mantenimiento</option>
            </select>
          </div>
        </div>

        <div>
          <label class="lm-label" for="form-table-notes">Ubicación y Características en el Salón</label>
          <input
            id="form-table-notes"
            type="text"
            placeholder="Ej. Junto al zócalo de azulejos talaveranos / Arco central de ladrillo"
            class="lm-input py-2.5"
          />
        </div>

        <div class="pt-4 flex flex-col-reverse sm:flex-row justify-end gap-3">
          <button id="cancel-table-modal-btn" type="button" class="lm-btn-outline py-2.5 px-5 text-[10px] w-full sm:w-auto">
            CANCELAR
          </button>
          <button type="submit" class="lm-btn-gold py-2.5 px-6 text-[10px] w-full sm:w-auto">
            GUARDAR MESA
          </button>
        </div>
      </form>
    </div>
  </div>

  <script>
    window.__INITIAL_ZONES__ = <%- JSON.stringify(zones || []) %>;
    window.__INITIAL_TABLES__ = <%- JSON.stringify(tables || []) %>;
  </script>
  <script src="/js/tables.js"></script>
</body>
</html>
